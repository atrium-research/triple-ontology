    {
      "@id": "dcat:Dataset",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A collection of data, published or curated by a single agent, and available for access or download in one or more representations (DCAT). Superclass of triple:Dataset."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcat:Dataset"
      }
    },
    {
      "@id": "triple:AccessCondition",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Access Condition"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dcterms:RightsStatement"
        },
        {
          "@id": "skos:Concept"
        }
      ]
    },
    {
      "@id": "schema:sameAs",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:sameAs"
      }
    },
    {
      "@id": "triple:isDuplicateOf",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a record to the representative record of the same scholarly work, elected by the GoTriple deduplication pipeline (API field cluster_id carries the representative's identifier; is_duplicate and is_cluster derive from this link). The representative is the target and asserts nothing; subject and object are records of the same content entity. A representative is never itself a duplicate and a record never points at itself: both rules are checked in shapes/."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "is duplicate of"
      },
      "rdfs:subPropertyOf": {
        "@id": "prov:alternateOf"
      }
    },
    {
      "@id": "schema:funder",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A person or organization that supports something through some kind of financial contribution"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:funder"
      }
    },
    {
      "@id": "sioc:topic",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "sioc:topic"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcterms:subject"
      }
    },
    {
      "@id": "dc:date",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A point or period of time associated with an event in the lifecycle of the resource (Dublin Core Elements 1.1)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dc:date"
      }
    },
    {
      "@id": "foaf:topic_interest",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "foaf:topic_interest"
      }
    },
    {
      "@id": "dcat:theme",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A main category of the dataset, as originally assigned by the source provider (e.g. a concept from the provider's thematic vocabulary). Distinct from sioc:topic, which carries the automatically assigned TRIPLE disciplines."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcat:theme"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcterms:subject"
      }
    },
    {
      "@id": "triple:Document",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "Document"
        },
        {
          "@language": "en",
          "@value": "Document (Triple)"

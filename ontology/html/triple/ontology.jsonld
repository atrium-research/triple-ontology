      "rdfs:comment": {
        "@language": "en",
        "@value": "An abstract is a short description that summarizes a CreativeWork."
      },
      "rdfs:label": [
        "schema:abstract",
        {
          "@language": "en",
          "@value": "schema:abstract"
        }
      ]
    },
    {
      "@id": "datacite:IdentifierScheme",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A scheme that uniquely identifies entities of a particular type."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:IdentifierScheme"
      }
    },
    {
      "@id": "dcat:theme",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A main category of the dataset, as originally assigned by the source provider (e.g. a concept from the provider's thematic vocabulary). Distinct from sioc:topic, which carries the automatically assigned TRIPLE disciplines."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcat:theme"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcterms:subject"
      }
    },
    {
      "@id": "triple:originalLanguage",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The language value exactly as received from the source provider, before normalization to a schema:Language entity (e.g. 'eng', 'English', 'fr-FR'). The normalized value is expressed via schema:inLanguage."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "original language"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:subPropertyOf": {
        "@id": "dc:language"
      }
    },
    {
      "@id": "schema:knowsAbout",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A topic the agent knows about. Schema.org declares it for Person and Organization, so it is in domain here: every triple:Profile is a person or an organization. It carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) the user declares to know about. The data model revision leaves this field unmapped: the choice of this property is the ontology own."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:knowsAbout"
      }
    },
    {
      "@id": "triple:openToCollaboration",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether the registered user declared to be open to collaboration with other GoTriple users."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "open to collaboration"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "datacite:doi",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:doi"
      }
    },
    {
      "@id": "triple:AccessCondition",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights."

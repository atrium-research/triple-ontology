        "@value": "URL of the landing page containing metadata and descriptive information about the document."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Landing Page URL"
      }
    },
    {
      "@id": "datacite:issn",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {

      "@id": "dcterms:accessRights",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Information about who access the resource or an indication of its security status (DCMI Metadata Terms). Super-property of triple:hasAccessCondition."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcterms:accessRights"

    {
      "@id": "schema:jobTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The job title of the person, as the plain string the provider supplies. Chosen over schema:hasOccupation, whose range demands a structured schema:Occupation node: when an Occupation vocabulary exists, hasOccupation will be added beside jobTitle without changing it."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:jobTitle"
      }
    },

        "@value": "The nature or genre of the resource (DCMI Metadata Terms). Super-property of triple:hasContentType and triple:hasProjectType."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcterms:type"
      }
    },
    {
      "@id": "crm:E90_Symbolic_Object",

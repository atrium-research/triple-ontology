      {
        "@language": "en",
        "@value": "The nature or genre of the resource (Dublin Core Elements 1.1)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "dc:type"
      }
    ]
  },

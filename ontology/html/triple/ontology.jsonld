    {
      "@id": "triple:original_id_schema",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Original Identifier"
      }
    },
    {
      "@id": "adms:representationTechnique",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "More information about the format in which the semantic artefact is released. This is different from the file format: for example, a ZIP file (file format) could contain an XML schema (representation technique)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "adms:representationTechnique"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "triple:originalType",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The resource type exactly as received from the source provider, before normalization to the Content Type controlled vocabulary (e.g. 'journalArticle'). The normalized value is expressed via triple:hasContentType."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "original type"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:subPropertyOf": {
        "@id": "dc:type"
      }
    },

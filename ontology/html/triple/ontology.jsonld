      "@id": "triple:ContentType",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Content Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"

      "@id": "schema:startDate",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The start date and time of the item"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:startDate"
      }
    },
    {
      "@id": "schema:mentions",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {

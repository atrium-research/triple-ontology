  {
    "@id": "http://xmlns.com/foaf/0.1/name",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The full name of the agent, as a plain string. Chosen over schema:name for FOAF-typed agents (profiles, persons, organizations): it completes the FOAF naming triad with foaf:givenName and foaf:familyName, and is declared rdfs:subPropertyOf rdfs:label by FOAF itself, so generic consumers see it as a label by inference. schema:name remains on schema-typed things (projects, languages, keywords, places)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "foaf:name"
      }

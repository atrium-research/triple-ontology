        "@language": "en",
        "@value": "E90 Symbolic Object"
      }
    },
    {
      "@id": "schema:knowsLanguage",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A language the agent knows."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:knowsLanguage"
      }
    },
    {
      "@id": "schema:funding",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Grant that directly or indirectly provide funding or sponsorship for this item."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:funding"
      }
    },
    {
      "@id": "schema:mentions",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "mentions"
        },
        {
          "@language": "en",
          "@value": "schema:mentions"
        }
      ]
    },
    {
      "@id": "triple:hasAccessCondition",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a resource to its access condition."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has access condition"
      },
      "rdfs:range": {
        "@id": "triple:AccessCondition"
      },
      "rdfs:subPropertyOf": {
        "@id": "dcterms:accessRights"
      }
    },
    {
      "@id": "datacite:IdentifierScheme",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A scheme that uniquely identifies entities of a particular type."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:IdentifierScheme"
      }
    },
    {
      "@id": "fabio:Dataset",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A dataset."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "fabio:Dataset"
      }
    },
    {
      "@id": "fabio:ScholarlyWork",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A scholarly work."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "fabio:ScholarlyWork"
      }
    },
    {
      "@id": "crm:E7_Activity",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "E7 Activity"
      }
    },
    {
      "@id": "triple:License",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "License"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dcterms:LicenseDocument"
        },
        {
          "@id": "skos:Concept"
        }
      ]
    },
    {
      "@id": "schema:temporalCoverage",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The temporalCoverage of a CreativeWork indicates the period that the content applies to."
      },
      "rdfs:label": [
        "schema:temporalCoverage",
        {
          "@language": "en",
          "@value": "schema:temporalCoverage"
        }
      ]
    },
    {
      "@id": "schema:affiliation",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An organization the agent is affiliated with. Used in GoTriple for the current organization specified by the user in the Experience tab."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:affiliation"
      }
    },
    {
      "@id": "schema:jobTitle",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The job title of the person, as the plain string the provider supplies. Chosen over schema:hasOccupation, whose range demands a structured schema:Occupation node: when an Occupation vocabulary exists, hasOccupation will be added beside jobTitle without changing it."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:jobTitle"
      }
    },
    {
      "@id": "skos:prefLabel",
      "@type": "owl:AnnotationProperty"
    },
    {
      "@id": "schema:sponsor",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A person or organization that supports a thing through a pledge, promise, or financial contribution"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:sponsor"
      }
    },
    {
      "@id": "datacite:ark",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:ark"
      }
    }
  ]
}
    {
      "@id": "https://gotriple.eu/ontology/triple",
      "@type": "owl:Ontology",
      "dcterms:abstract": {
        "@language": "en",
        "@value": "The TRIPLE Ontology defines a comprehensive model for representing Social Sciences and Humanities (SSH) resources in the GoTriple discovery platform, extending Schema.org and FOAF."
      },
      "dcterms:contributor": [
        "Luca De Santis",
        "Silvio Peroni"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2021-12-01"
      },
      "dcterms:creator": "Alessandro Bertozzi",
      "dcterms:description": {
        "@language": "en",
        "@value": "GoTriple is an advanced multilingual discovery platform specifically designed for the Social Sciences and Humanities (SSH) sector. The platform aggregates, processes, and semantically enriches diverse SSH resources including scholarly publications, research datasets, project descriptions, and researcher profiles from various European language repositories. The TRIPLE ontology serves as the data model for this platform, facilitating cross-disciplinary and cross-linguistic discovery and reuse of resources."
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-10"
      },

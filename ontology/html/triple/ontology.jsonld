  "@graph": [
    {
      "@id": "schema:keywords",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Keywords or tags used to describe this content. In GoTriple these are the producer's own keywords, free text with no URI; the concepts detected by the enrichment pipeline are carried by schema:about instead."
      },
      "rdfs:label": [
        "schema:keywords",
        {
          "@language": "en",
          "@value": "schema:keywords"
        }
      ]
    },
    {
      "@id": "datacite:ark",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:ark"
      }
    },
    {
      "@id": "oa:hasBody",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The object of the Annotation: for enrichment annotations, the concept or term assigned to the target."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "hasBody"
        },
        {
          "@language": "en",
          "@value": "oa:hasBody"
        }
      ]
    },
    {
      "@id": "schema:spatialCoverage",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content."
      },
      "rdfs:label": [
        "schema:spatialCoverage",
        {
          "@language": "en",
          "@value": "schema:spatialCoverage"
        }
      ],
      "rdfs:range": {
        "@id": "schema:Place"
      }
    },
    {
      "@id": "schema:comment",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Comments, typically from users."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:comment"
      }
    },
    {
      "@id": "prov:alternateOf",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "PROV-O property relating two entities that present aspects of the same thing. Reflexive, symmetric and transitive by specification: the direction that tells the representative apart is added by its specialisation triple:isDuplicateOf."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "prov:alternateOf"
      }
    },
    {
      "@id": "triple:SemanticArtefact",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A semantic artefact in the context of GoTriple platform, representing formal knowledge representations such as ontologies, controlled vocabularies, and other semantic resources used in SSH research. Original provider values are preserved before normalization."
      },

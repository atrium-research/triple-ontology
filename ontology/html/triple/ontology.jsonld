      "rdfs:comment": {
        "@language": "en",
        "@value": "The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:about"
      }
    },
    {
      "@id": "datacite:hasIdentifier",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity."
      },
      "rdfs:label": [
        "datacite:hasIdentifier",
        {
          "@language": "en",
          "@value": "datacite:hasIdentifier"

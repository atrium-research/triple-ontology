  {
    "@id": "https://schema.org/FundingScheme",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A FundingScheme combines organizational, project and policy aspects of grant-based funding, e.g. Framework Programme 7 or Horizon 2020. In GoTriple it types the funding programme a grant is awarded under - the funding_scheme field of production (H2020, FP7, Horizon Europe) - attached to the Grant via schema:funder, which is admissible because a funding scheme is a kind of schema:Organization. The term is part of pending.schema.org; the subclass axiom restates the one asserted by the source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "schema:FundingScheme"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://schema.org/Organization"
      }
    ]
  },
  {
    "@id": "https://schema.org/description",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A description of the item. Used in GoTriple for the self-description of a profile."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "schema:description"
      }
    ]
  },
  {

    {
      "@id": "schema:isBasedOn",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A resource from which this work is derived or from which it is a modification or adaptation. Supersedes the deprecated schema:isBasedOnUrl, which the data model revision still names. The value is an IRI (role-B link): an external resource today, possibly a platform resource tomorrow, with the same triple shape."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:isBasedOn"
      }
    },
    {
      "@id": "litre:hasLiteralValue",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Associates an entity with a literal value representing its textual content."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "litre:hasLiteralValue"
      }
    },
    {
      "@id": "oa:tagging",
      "@type": [
        "owl:NamedIndividual",
        "oa:Motivation"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "The motivation for when the user intends to associate a tag with the Target; used for GoTriple keyword assignments."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "oa:tagging"
      }
    },
    {
      "@id": "schema:publisher",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The publisher of the creative work."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:publisher"
      }
    },
    {
      "@id": "schema:dateModified",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update."
      },
      "rdfs:label": [
        "schema:dateModified",
        {
          "@language": "en",
          "@value": "schema:dateModified"
        }
      ]
    },
    {
      "@id": "foaf:OnlineAccount",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "An online account held by a GoTriple user. Created inside the platform, so it carries only its internal identifier."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "foaf:OnlineAccount"
      }
    },
    {
      "@id": "dcat:Distribution",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A specific representation of a dataset: a downloadable file, an API or a feed (DCAT)."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcat:Distribution"
      }
    },
    {
      "@id": "triple:full_text_url_schema",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "URL providing direct access to the full content of the document."

      "rdfs:comment": {
        "@language": "en",
        "@value": "A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset. Note that a creative work may have many media objects associated with it on the same web page."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:MediaObject"
      }
    },
    {
      "@id": "triple:hasAccessCondition",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links a resource to its access condition."

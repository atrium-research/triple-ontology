      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dc:language"
      }
    },
    {
      "@id": "triple:originalLicense",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "original license"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },

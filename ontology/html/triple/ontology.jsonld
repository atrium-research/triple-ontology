    {
      "@id": "datacite:handle",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "datacite:handle"
      }
    },
    {
      "@id": "schema:dateModified",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update."
      },
      "rdfs:label": [
        "schema:dateModified",
        {
          "@language": "en",
          "@value": "schema:dateModified"
        }
      ]
    },
    {
      "@id": "triple:idref_schema",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "IdRef"
      }
    },
    {
      "@id": "dcterms:subject",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A topic of the resource (DCMI Metadata Terms). Super-property of sioc:topic and dcat:theme."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcterms:subject"
      }
    },
    {

  "@graph": [
    {
      "@id": "skos:definition",
      "@type": "owl:AnnotationProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A SKOS annotation property providing a complete explanation of the intended meaning of a concept."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "skos:definition"
      }
    },
    {
      "@id": "schema:about",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:about"
      }
    },
    {
      "@id": "dcterms:RightsStatement",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A statement about the intellectual property rights held in or over a resource (DCMI Metadata Terms). Superclass of triple:AccessCondition."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "dcterms:RightsStatement"
      }
    },
    {
      "@id": "triple:openToCollaboration",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Whether the registered user declared to be open to collaboration with other GoTriple users."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "open to collaboration"
      },
      "rdfs:range": {
        "@id": "xsd:boolean"
      }
    },
    {
      "@id": "triple:License",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "License"
      },
      "rdfs:subClassOf": [
        {
          "@id": "dcterms:LicenseDocument"
        },
        {
          "@id": "skos:Concept"
        }
      ]
    },
    {

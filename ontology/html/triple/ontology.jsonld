    {
      "@id": "triple:internal_id_schema",
      "@type": [
        "datacite:IdentifierScheme",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "TRIPLE Internal ID"
      }
    },
    {
      "@id": "schema:DefinedTerm",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "schema:DefinedTerm"
      },
      "rdfs:subClassOf": {
        "@id": "_:n298207f35443404c9cc1192715fefbd1b286"
      }
    },

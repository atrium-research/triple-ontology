  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalDatePublished">
    <rdfs:label xml:lang="en">original date published</rdfs:label>
    <rdfs:comment xml:lang="en">The publication date string exactly as received from the source provider, in whatever format the provider used (e.g. '03/05/2021', 'May 2021'), before conversion to ISO 8601. The normalized value is expressed via schema:datePublished.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/date">
        <rdfs:label xml:lang="en">dc:date</rdfs:label>
        <rdfs:comment xml:lang="en">A point or period of time associated with an event in the lifecycle of the resource (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/comment">
    <rdfs:label xml:lang="en">schema:comment</rdfs:label>
    <rdfs:comment xml:lang="en">Comments, typically from users.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/CreativeWork">
    <rdfs:label xml:lang="en">schema:CreativeWork</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/sponsor">
    <rdfs:label xml:lang="en">schema:sponsor</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports a thing through a pledge, promise, or financial contribution</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasLicense">
    <rdfs:label xml:lang="en">has license</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its licence.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/License"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/license"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/endDate">
    <rdfs:label xml:lang="en">schema:endDate</rdfs:label>
    <rdfs:comment xml:lang="en">The end date and time of the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/MediaObject">
    <rdfs:label xml:lang="en">schema:MediaObject</rdfs:label>
    <rdfs:comment xml:lang="en">A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset. Note that a creative work may have many media objects associated with it on the same web page.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/ContactPoint">
    <rdfs:label>schema:ContactPoint</rdfs:label>
    <rdfs:label xml:lang="en">schema:ContactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b288">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/email"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasContentType">
    <rdfs:label xml:lang="en">has content type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its content type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/spatialCoverage">
    <rdfs:label>schema:spatialCoverage</rdfs:label>
    <rdfs:label xml:lang="en">schema:spatialCoverage</rdfs:label>
    <rdfs:comment xml:lang="en">The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ContentType">
    <rdfs:label xml:lang="en">Content Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/detectedLanguage">
    <rdfs:label xml:lang="en">detected language</rdfs:label>
    <rdfs:comment xml:lang="en">The language tag identified by the GoTriple language-detection service for the resource's text, which may differ from the language declared by the provider (triple:originalLanguage) and from the normalized language (schema:inLanguage).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/License">
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:comment xml:lang="en">The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/LicenseDocument"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/type">
    <rdfs:label xml:lang="en">dc:type</rdfs:label>
    <rdfs:comment xml:lang="en">The nature or genre of the resource (Dublin Core Elements 1.1).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#distribution">
    <rdfs:label xml:lang="en">dcat:distribution</rdfs:label>
    <rdfs:comment xml:lang="en">An available distribution of the dataset (DCAT).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/cerif/frapo/Grant">
    <rdfs:label xml:lang="en">frapo:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A funding grant.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/image">
    <rdfs:label xml:lang="en">schema:image</rdfs:label>
    <rdfs:comment xml:lang="en">An image of the entity. Used in GoTriple for the URL of the personal picture chosen by the user.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalConditionsOfAccess">
    <rdfs:label xml:lang="en">original conditions of access</rdfs:label>
    <rdfs:comment xml:lang="en">The access rights statement exactly as received from the source provider (e.g. 'info:eu-repo/semantics/openAccess'), before normalization to the Access Condition controlled vocabulary. The normalized value is expressed via triple:hasAccessCondition.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/rights">
        <rdfs:label xml:lang="en">dc:rights</rdfs:label>
        <rdfs:comment xml:lang="en">Information about rights held in and over the resource (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/AccessCondition">
    <rdfs:label xml:lang="en">Access Condition</rdfs:label>
    <rdfs:comment xml:lang="en">The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/oa#Motivation">
    <rdfs:label xml:lang="en">Motivation</rdfs:label>
    <rdfs:label xml:lang="en">oa:Motivation</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
    <rdfs:label>schema:datePublished</rdfs:label>
    <rdfs:label xml:lang="en">schema:datePublished</rdfs:label>
    <rdfs:comment xml:lang="en">Date of first publication or broadcast. In GoTriple it is normalized to ISO 8601 (yyyy-mm-dd).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/name">
    <rdfs:label>schema:name</rdfs:label>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:label xml:lang="en">schema:name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the item.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE1_Dataset">
    <rdfs:label xml:lang="en">SHE1 Dataset</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:comment xml:lang="en">Associates an entity with a literal value representing its textual content.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/mentions">
    <rdfs:label xml:lang="en">mentions</rdfs:label>
    <rdfs:label xml:lang="en">schema:mentions</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/knowsLanguage">
    <rdfs:label xml:lang="en">schema:knowsLanguage</rdfs:label>
    <rdfs:comment xml:lang="en">A language the agent knows.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/topic_interest">
    <rdfs:label xml:lang="en">foaf:topic_interest</rdfs:label>
    <rdfs:comment xml:lang="en">A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/pronouns">
    <rdfs:label xml:lang="en">pronouns</rdfs:label>
    <rdfs:comment xml:lang="en">The personal pronouns chosen by the user for their GoTriple profile (e.g. "she/her").</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/openToCollaboration">
    <rdfs:label xml:lang="en">open to collaboration</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the registered user declared to be open to collaboration with other GoTriple users.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Grant">
    <rdfs:label xml:lang="en">schema:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b197">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b198">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/funder"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b201">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b202">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/sponsor"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdfs:label xml:lang="en">foaf:Organization</rdfs:label>
    <rdfs:comment xml:lang="en">An organization.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b290">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/adms#representationTechnique">
    <rdfs:label xml:lang="en">adms:representationTechnique</rdfs:label>
    <rdfs:comment xml:lang="en">More information about the format in which the semantic artefact is released. This is different from the file format: for example, a ZIP file (file format) could contain an XML schema (representation technique).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateModified">
    <rdfs:label>schema:dateModified</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateModified</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLanguage">
    <rdfs:label xml:lang="en">original language</rdfs:label>
    <rdfs:comment xml:lang="en">The language value exactly as received from the source provider, before normalization to a schema:Language entity (e.g. 'eng', 'English', 'fr-FR'). The normalized value is expressed via schema:inLanguage.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/language">
        <rdfs:label xml:lang="en">dc:language</rdfs:label>
        <rdfs:comment xml:lang="en">A language of the resource (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Dataset">
    <rdfs:label xml:lang="en">dcat:Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A collection of data, published or curated by a single agent, and available for access or download in one or more representations (DCAT). Superclass of triple:Dataset.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/publisher">
    <rdfs:label xml:lang="en">schema:publisher</rdfs:label>
    <rdfs:comment xml:lang="en">The publisher of the creative work.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/dcat#Distribution">
    <rdfs:label xml:lang="en">dcat:Distribution</rdfs:label>
    <rdfs:comment xml:lang="en">A specific representation of a dataset: a downloadable file, an API or a feed (DCAT).</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/subject">
    <rdfs:label xml:lang="en">dcterms:subject</rdfs:label>
    <rdfs:comment xml:lang="en">A topic of the resource (DCMI Metadata Terms). Super-property of sioc:topic and dcat:theme.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Dataset">
    <rdfs:label xml:lang="en">schema:Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A body of structured information describing some topic of one or more collections of data (Schema.org).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object">
    <rdfs:label xml:lang="en">E90 Symbolic Object</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/funding">
    <rdfs:label xml:lang="en">schema:funding</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E31_Document">
    <rdfs:label xml:lang="en">E31 Document</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/source">
    <rdfs:label xml:lang="en">dcterms:source</rdfs:label>
    <rdfs:comment xml:lang="en">A related resource from which the described resource is derived. In GoTriple it points to the system the document was harvested from.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/machineTranslatedLanguage">
    <rdfs:label xml:lang="en">machine translated language</rdfs:label>
    <rdfs:comment xml:lang="en">A language tag whose title and abstract versions were produced by the GoTriple machine-translation service. Title/abstract literals carrying this language tag are machine translations; the remaining language versions are as provided by the source.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/encodingFormat">
    <rdfs:label>schema:encodingFormat</rdfs:label>
    <rdfs:label xml:lang="en">schema:encodingFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type typically expressed using a MIME format.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/fabio/ScholarlyWork">
    <rdfs:label xml:lang="en">fabio:ScholarlyWork</rdfs:label>
    <rdfs:comment xml:lang="en">A scholarly work.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/affiliation">
    <rdfs:label xml:lang="en">schema:affiliation</rdfs:label>
    <rdfs:comment xml:lang="en">An organization the agent is affiliated with. Used in GoTriple for the current organization specified by the user in the Experience tab.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLicense">
    <rdfs:label xml:lang="en">original license</rdfs:label>
    <rdfs:comment xml:lang="en">The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/fabio/Dataset">
    <rdfs:label xml:lang="en">fabio:Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A dataset.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE8_Publication">
    <rdfs:label xml:lang="en">SHE8 Publication</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/temporalCoverage">
    <rdfs:label>schema:temporalCoverage</rdfs:label>
    <rdfs:label xml:lang="en">schema:temporalCoverage</rdfs:label>
    <rdfs:comment xml:lang="en">The temporalCoverage of a CreativeWork indicates the period that the content applies to.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#theme">
    <rdfs:label xml:lang="en">dcat:theme</rdfs:label>
    <rdfs:comment xml:lang="en">A main category of the dataset, as originally assigned by the source provider (e.g. a concept from the provider's thematic vocabulary). Distinct from sioc:topic, which carries the automatically assigned TRIPLE disciplines.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <rdfs:Datatype rdf:about="https://schema.org/Text"/>
  <owl:Class rdf:about="https://schema.org/Person">
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:label xml:lang="en">schema:Person</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/dc/terms/LicenseDocument">
    <rdfs:label xml:lang="en">dcterms:LicenseDocument</rdfs:label>
    <rdfs:comment xml:lang="en">A legal document giving official permission to do something with a resource (DCMI Metadata Terms). Superclass of triple:License.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/provider">
    <rdfs:label xml:lang="en">schema:provider</rdfs:label>
    <rdfs:comment xml:lang="en">The service provider, service operator, or service performer; the goods producer.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/alternateName">
    <rdfs:label xml:lang="en">schema:alternateName</rdfs:label>
    <rdfs:comment xml:lang="en">An alias for the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalSource">
    <rdfs:label xml:lang="en">original source</rdfs:label>
    <rdfs:comment xml:lang="en">The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/source">
        <rdfs:label xml:lang="en">dc:source</rdfs:label>
        <rdfs:comment xml:lang="en">A related resource from which the described resource is derived (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Thing">
    <rdfs:label xml:lang="en">schema:Thing</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:label xml:lang="en">skos:Concept</rdfs:label>
    <rdfs:comment xml:lang="en">A concept of a knowledge organization system, from SKOS. Values of schema:about are the concepts of the TRIPLE Vocabulary (SSH-LCSH), maintained by the TRIPLE consortium and published on semantics.gr.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/provenance">
    <rdfs:label xml:lang="en">dcterms:provenance</rdfs:label>
    <rdfs:comment xml:lang="en">A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/dc/terms/ProvenanceStatement"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated">
    <rdfs:label>schema:dateCreated</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateCreated</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/author">
    <rdfs:label xml:lang="en">schema:author</rdfs:label>
    <rdfs:comment xml:lang="en">The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isOutputOf">
    <rdfs:label xml:lang="en">frapo:isOutputOf</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a research output is the result of a particular project.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/organizer">
    <rdfs:label xml:lang="en">schema:organizer</rdfs:label>
    <rdfs:comment xml:lang="en">The organization who organizes the event or project.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#bbox">
    <rdfs:label xml:lang="en">dcat:bbox</rdfs:label>
    <rdfs:comment xml:lang="en">The bounding box of the dataset, expressed as a literal (e.g., WKT).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/datacite/Identifier">
    <rdfs:label xml:lang="en">datacite:Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">An identifier that uniquely identifies an entity according to some identification scheme.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b205">
        <owl:onClass rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/usesIdentifierScheme"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b206">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/duration">
    <rdfs:label xml:lang="en">schema:duration</rdfs:label>
    <rdfs:comment xml:lang="en">The duration of the item (movie, audio recording, event, etc.) in ISO 8601 duration format.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/description">
    <rdfs:label xml:lang="en">schema:description</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the item. Used in GoTriple for the self-description of a profile.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/email">
    <rdfs:label xml:lang="en">schema:email</rdfs:label>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/headline">
    <rdfs:label>schema:headline</rdfs:label>
    <rdfs:label xml:lang="en">schema:headline</rdfs:label>
    <rdfs:comment xml:lang="en">Headline of the article.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E7_Activity">
    <rdfs:label xml:lang="en">E7 Activity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/spar/datacite/IdentifierScheme">
    <rdfs:label xml:lang="en">datacite:IdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">A scheme that uniquely identifies entities of a particular type.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/Place">
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <rdfs:label xml:lang="en">schema:Place</rdfs:label>
    <rdfs:comment xml:lang="en">Entities that have a somewhat fixed, physical extension.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b287">
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/startDate">
    <rdfs:label xml:lang="en">schema:startDate</rdfs:label>
    <rdfs:comment xml:lang="en">The start date and time of the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/dc/terms/ProvenanceStatement">
    <rdfs:label xml:lang="en">dcterms:ProvenanceStatement</rdfs:label>
    <rdfs:comment xml:lang="en">A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/dc/terms/RightsStatement">
    <rdfs:label xml:lang="en">dcterms:RightsStatement</rdfs:label>
    <rdfs:comment xml:lang="en">A statement about the intellectual property rights held in or over a resource (DCMI Metadata Terms). Superclass of triple:AccessCondition.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/knowsAbout">
    <rdfs:label xml:lang="en">schema:knowsAbout</rdfs:label>
    <rdfs:comment xml:lang="en">A topic the agent knows about. Schema.org declares it for Person and Organization, so it is in domain here: every triple:Profile is a person or an organization. It carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) the user declares to know about. The data model revision leaves this field unmapped: the choice of this property is the ontology own.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/registeredUser">
    <rdfs:label xml:lang="en">registered user</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the profile belongs to a registered GoTriple user (true) or was automatically created for an author extracted from harvested document metadata (false).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/familyName">
    <rdfs:label xml:lang="en">foaf:familyName</rdfs:label>
    <rdfs:comment xml:lang="en">The family name (last name) of a person.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/OnlineAccount">
    <rdfs:label xml:lang="en">foaf:OnlineAccount</rdfs:label>
    <rdfs:comment xml:lang="en">An online account held by a GoTriple user. Created inside the platform, so it carries only its internal identifier.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://w3id.org/mod#SemanticArtefact">
    <rdfs:label xml:lang="en">mod:SemanticArtefact</rdfs:label>
    <rdfs:comment xml:lang="en">A machine-readable object that formalises a shared conceptualisation: an ontology, a thesaurus, a taxonomy, a vocabulary (MOD, Metadata for Ontology Description and publication).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ProjectType">
    <rdfs:label xml:lang="en">Project Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of research project (funded, crowdfunded, citizen science, ...), drawn from the Project Type controlled vocabulary.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Document">
    <rdfs:label xml:lang="en">foaf:Document</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/Project">
    <rdfs:label xml:lang="en">schema:Project</rdfs:label>
    <rdfs:comment xml:lang="en">An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE3_SSH_Project">
    <rdfs:label xml:lang="en">SHE3 SSH Project</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/funder">
    <rdfs:label xml:lang="en">schema:funder</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports something through some kind of financial contribution</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/mainEntityOfPage">
    <rdfs:label xml:lang="en">schema:mainEntityOfPage</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a page (or other CreativeWork) for which this thing is the main entity being described.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/inLanguage">
    <rdfs:label xml:lang="en">schema:inLanguage</rdfs:label>
    <rdfs:comment xml:lang="en">The language of the content or performance or used in an action.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/url">
    <rdfs:label xml:lang="en">schema:url</rdfs:label>
    <rdfs:comment xml:lang="en">The URL of the entity. Used in GoTriple for the personal web pages of the profile.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalType">
    <rdfs:label xml:lang="en">original type</rdfs:label>
    <rdfs:comment xml:lang="en">The resource type exactly as received from the source provider, before normalization to the Content Type controlled vocabulary (e.g. 'journalArticle'). The normalized value is expressed via triple:hasContentType.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/type"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Organization">
    <rdfs:label xml:lang="en">schema:Organization</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/fileFormat">
    <rdfs:label>schema:fileFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type, typically MIME format</rdfs:comment>
  </owl:DatatypeProperty>
</rdf:RDF>

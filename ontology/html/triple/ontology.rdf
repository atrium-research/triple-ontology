  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#motivatedBy">
    <rdfs:label xml:lang="en">motivatedBy</rdfs:label>
    <rdfs:label xml:lang="en">oa:motivatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The reason why the Annotation was created; oa:classifying for discipline assignments, oa:tagging for keyword assignments.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#downloadURL">
    <rdfs:label xml:lang="en">dcat:downloadURL</rdfs:label>
    <rdfs:comment xml:lang="en">The URL of the downloadable file of a distribution in a given format. IRI-valued.</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/full_text_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Full Text URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL providing direct access to the full content of the document.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/issn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:issn</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Serial Number - the identifier of a serial publication, standardised as ISO 3297.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/source_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Source URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the original publication location or source repository.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
    <rdfs:comment xml:lang="en">Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch">
    <rdfs:label xml:lang="en">skos:closeMatch</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS property indicating that two concepts are sufficiently similar to be used interchangeably in some contexts.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://gotriple.eu/ontology/triple">
    <rdfs:label xml:lang="en">TRIPLE Ontology</rdfs:label>
    <dcterms:abstract xml:lang="en">The TRIPLE Ontology defines a comprehensive model for representing Social Sciences and Humanities (SSH) resources in the GoTriple discovery platform, extending Schema.org and FOAF.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">GoTriple is an advanced multilingual discovery platform specifically designed for the Social Sciences and Humanities (SSH) sector. The platform aggregates, processes, and semantically enriches diverse SSH resources including scholarly publications, research datasets, project descriptions, and researcher profiles from various European language repositories. The TRIPLE ontology serves as the data model for this platform, facilitating cross-disciplinary and cross-linguistic discovery and reuse of resources.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">TRIPLE Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>triple</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://gotriple.eu/ontology/triple/</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Comprehensive semantic representation of the GoTriple discovery platform's data model for Social Sciences and Humanities (SSH) research artifacts.</rdfs:comment>
    <owl:priorVersion rdf:resource="https://gotriple.eu/ontology/triple/2.2.0"/>
    <owl:versionIRI rdf:resource="https://gotriple.eu/ontology/triple/3.0.0"/>
    <owl:versionInfo>3.0.0</owl:versionInfo>
  </owl:Ontology>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/idref_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">IdRef</rdfs:label>
    <rdfs:comment xml:lang="en">IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/creator">
    <rdfs:label xml:lang="en">schema:creator</rdfs:label>
    <rdfs:comment xml:lang="en">The creator or author of this CreativeWork (Schema.org). Super-property of schema:author.</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/gotriple_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">GoTriple ID</rdfs:label>
    <rdfs:comment xml:lang="en">The OPERAS/GoTriple identifier assigned to a profile (the goTripleId field).</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/isBasedOn">
    <rdfs:label xml:lang="en">schema:isBasedOn</rdfs:label>
    <rdfs:comment xml:lang="en">A resource from which this work is derived or from which it is a modification or adaptation. Supersedes the deprecated schema:isBasedOnUrl, which the data model revision still names. The value is an IRI (role-B link): an external resource today, possibly a platform resource tomorrow, with the same triple shape.</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/landing_page_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Landing Page URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the landing page containing metadata and descriptive information about the document.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/references">
    <rdfs:label xml:lang="en">dcterms:references</rdfs:label>
    <rdfs:comment xml:lang="en">A related resource that is referenced, cited, or otherwise pointed to by the described resource. Declared inverse of dcterms:isReferencedBy (DCMI), which the model already carries on Dataset, MediaObject and SemanticArtefact: this is the active side, on the document. Not a formal bibliographic citation.</rdfs:comment>
    <owl:inverseOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isReferencedBy">
        <rdfs:label xml:lang="en">dcterms:isReferencedBy</rdfs:label>
        <rdfs:comment xml:lang="en">A related resource that references, cites, or otherwise points to the described resource.</rdfs:comment>
      </owl:ObjectProperty>
    </owl:inverseOf>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/jobTitle">
    <rdfs:label xml:lang="en">schema:jobTitle</rdfs:label>
    <rdfs:comment xml:lang="en">The job title of the person, as the plain string the provider supplies. Chosen over schema:hasOccupation, whose range demands a structured schema:Occupation node: when an Occupation vocabulary exists, hasOccupation will be added beside jobTitle without changing it.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/confidence">
    <rdfs:label xml:lang="en">confidence</rdfs:label>
    <rdfs:comment xml:lang="en">The trust score of an automatic enrichment, between 0 and 1, as produced by the GoTriple pipeline (SKG-IF 'trust').</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/creator">
    <rdfs:label xml:lang="en">dcterms:creator</rdfs:label>
    <rdfs:comment xml:lang="en">The agent responsible for the annotation; for GoTriple enrichments, the GoTriple pipeline (SKG-IF associated_with).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdfs:label xml:lang="en">skos:definition</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS annotation property providing a complete explanation of the intended meaning of a concept.</rdfs:comment>
  </owl:AnnotationProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdfs:label xml:lang="en">skos:exactMatch</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS property indicating that two concepts can be used interchangeably across all contexts.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#classifying">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">oa:classifying</rdfs:label>
    <rdfs:comment xml:lang="en">The motivation for when the user intends to classify the Target as something; used for GoTriple discipline assignments.</rdfs:comment>
  </owl:NamedIndividual>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/uri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:uri</rdfs:label>
    <rdfs:comment xml:lang="en">Uniform Resource Identifier - a string of characters that unambiguously identifies a particular resource.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/isni">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:isni</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Name Identifier - an ISO standard identifier for the public identities of contributors to media content.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/isDiscarded">
    <rdfs:label xml:lang="en">is discarded</rdfs:label>
    <rdfs:comment xml:lang="en">A boolean flag indicating whether an entity (author or keyword) has been marked as discarded and should not be used for search/filtering.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasTarget">
    <rdfs:label xml:lang="en">hasTarget</rdfs:label>
    <rdfs:label xml:lang="en">oa:hasTarget</rdfs:label>
    <rdfs:comment xml:lang="en">The relationship between an Annotation and its Target.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/original_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Original Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number).</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/isbn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:isbn</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Book Number - a numeric identifier for books and book-like products.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/sameAs">
    <rdfs:label xml:lang="en">schema:sameAs</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity).</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/orcid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:orcid</rdfs:label>
    <rdfs:comment xml:lang="en">Open Researcher and Contributor ID - a persistent identifier for researchers, maintained by ORCID Inc.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#accessURL">
    <rdfs:label xml:lang="en">dcat:accessURL</rdfs:label>
    <rdfs:comment xml:lang="en">A URL of a resource that gives access to a distribution of the dataset — a landing page, portal or feed. When the URL is the file itself, dcat:downloadURL is the right property. IRI-valued by DCAT's own range (rdfs:Resource).</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasBody">
    <rdfs:label xml:lang="en">hasBody</rdfs:label>
    <rdfs:label xml:lang="en">oa:hasBody</rdfs:label>
    <rdfs:comment xml:lang="en">The object of the Annotation: for enrichment annotations, the concept or term assigned to the target.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#prefLabel"/>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#identifying">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">identifying</rdfs:label>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://schema.org/abstract">
    <rdfs:label>schema:abstract</rdfs:label>
    <rdfs:label xml:lang="en">schema:abstract</rdfs:label>
    <rdfs:comment xml:lang="en">An abstract is a short description that summarizes a CreativeWork.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contactPoint">
    <rdfs:label xml:lang="en">schema:contactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasAccessCondition">
    <rdfs:label xml:lang="en">has access condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its access condition.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/AccessCondition"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/accessRights">
        <rdfs:label xml:lang="en">dcterms:accessRights</rdfs:label>
        <rdfs:comment xml:lang="en">Information about who access the resource or an indication of its security status (DCMI Metadata Terms). Super-property of triple:hasAccessCondition.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/license">
    <rdfs:label xml:lang="en">dcterms:license</rdfs:label>
    <rdfs:comment xml:lang="en">A legal document giving official permission to do something with the resource (DCMI Metadata Terms). Super-property of triple:hasLicense.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasProjectType">
    <rdfs:label xml:lang="en">has project type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a project to its project type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ProjectType"/>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/type">
        <rdfs:label xml:lang="en">dcterms:type</rdfs:label>
        <rdfs:comment xml:lang="en">The nature or genre of the resource (DCMI Metadata Terms). Super-property of triple:hasContentType and triple:hasProjectType.</rdfs:comment>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#alternateOf">
    <rdfs:label xml:lang="en">prov:alternateOf</rdfs:label>
    <rdfs:comment xml:lang="en">PROV-O property relating two entities that present aspects of the same thing. Reflexive, symmetric and transitive by specification: the direction that tells the representative apart is added by its specialisation triple:isDuplicateOf.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contributor">
    <rdfs:label xml:lang="en">schema:contributor</rdfs:label>
    <rdfs:comment xml:lang="en">A secondary contributor to the CreativeWork or Event.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/creativeWorkStatus">
    <rdfs:label>schema:creativeWorkStatus</rdfs:label>
    <rdfs:label xml:lang="en">schema:creativeWorkStatus</rdfs:label>
    <rdfs:comment xml:lang="en">The status of a creative work in terms of its stage in a lifecycle.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/oa#Annotation">
    <rdfs:label xml:lang="en">Annotation</rdfs:label>
    <rdfs:label xml:lang="en">oa:Annotation</rdfs:label>
    <rdfs:comment xml:lang="en">A Web Annotation; used by GoTriple to record enrichment provenance (classification and tagging) with its confidence.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdfs:label xml:lang="en">foaf:Person</rdfs:label>
    <rdfs:comment xml:lang="en">A person.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b289">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
    <owl:equivalentClass rdf:resource="https://schema.org/Person"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/spar/fabio/Work">
    <rdfs:label xml:lang="en">fabio:Work</rdfs:label>
    <rdfs:comment xml:lang="en">A work.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/givenName">
    <rdfs:label xml:lang="en">foaf:givenName</rdfs:label>
    <rdfs:comment xml:lang="en">The given name (first name) of a person.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
    <rdfs:label xml:lang="en">foaf:Agent</rdfs:label>
    <rdfs:comment xml:lang="en">An agent (person or organization).</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/account">
    <rdfs:label xml:lang="en">foaf:account</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates an account held by this agent</rdfs:comment>
  </owl:ObjectProperty>
  <rdfs:Datatype rdf:about="https://schema.org/URL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:URL</rdfs:label>
    <rdfs:comment xml:lang="en">Data type: URL.</rdfs:comment>
  </rdfs:Datatype>
  <owl:DatatypeProperty rdf:about="https://schema.org/version">
    <rdfs:label>schema:version</rdfs:label>
    <rdfs:comment xml:lang="en">The version of the CreativeWork</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/aggregator">
    <rdfs:label xml:lang="en">aggregator</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregator that collates resources from different sources</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b207">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/contributor"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/size">
    <rdfs:label xml:lang="en">schema:size</rdfs:label>
    <rdfs:comment xml:lang="en">A standardized size of a product or creative work, specified either through a simple textual string or a QuantitativeValue.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/DefinedTerm">
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
    <rdfs:comment xml:lang="en">A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b286">
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Text"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/isDuplicateOf">
    <rdfs:label xml:lang="en">is duplicate of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a record to the representative record of the same scholarly work, elected by the GoTriple deduplication pipeline (API field cluster_id carries the representative's identifier; is_duplicate and is_cluster derive from this link). The representative is the target and asserts nothing; subject and object are records of the same content entity. A representative is never itself a duplicate and a record never points at itself: both rules are checked in shapes/.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#alternateOf"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Document">
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="en">Document (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Document</rdfs:label>
    <rdfs:label xml:lang="pl">Dokument</rdfs:label>
    <rdfs:label xml:lang="pt">Documento</rdfs:label>
    <rdfs:comment xml:lang="en">A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b210">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
        <owl:onProperty rdf:resource="http://purl.org/cerif/frapo/isOutputOf"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b211">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b212">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/publisher"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b215">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b216">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/provider"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b219">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b220">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/aggregator"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b223">
        <owl:allValuesFrom rdf:resource="https://schema.org/ContactPoint"/>
        <owl:onProperty rdf:resource="https://schema.org/contactPoint"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b224">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b225">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/author"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b228">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b229">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/contributor"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b232">
        <owl:onProperty rdf:resource="https://schema.org/mentions"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b233">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Discipline"/>
        <owl:onProperty rdf:resource="http://rdfs.org/sioc/ns#topic"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b234">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/License"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasLicense"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b235">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/AccessCondition"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasAccessCondition"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b236">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasContentType"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b237">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Document"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/isDuplicateOf"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b238">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:onProperty rdf:resource="https://schema.org/about"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b239">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/detectedLanguage"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b240">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/machineTranslatedLanguage"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b241">
        <owl:onProperty rdf:resource="https://schema.org/keywords"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b242">
        <owl:onProperty rdf:resource="https://schema.org/spatialCoverage"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Place"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="na097ed390e6149d1b338e8fb32a485c5b243">
        <owl:onProperty rdf:resource="https://schema.org/temporalCoverage"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>

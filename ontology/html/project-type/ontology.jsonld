    "dcam": "http://purl.org/dc/dcam/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dcmitype": "http://purl.org/dc/dcmitype/",
    "dcterms": "http://purl.org/dc/terms/",
    "doap": "http://usefulinc.com/ns/doap#",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "geo": "http://www.opengis.net/ont/geosparql#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "org": "http://www.w3.org/ns/org#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "prof": "http://www.w3.org/ns/dx/prof/",
    "prov": "http://www.w3.org/ns/prov#",
    "pt": "https://gotriple.eu/ontology/project-type/",
    "qb": "http://purl.org/linked-data/cube#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sosa": "http://www.w3.org/ns/sosa/",
    "ssn": "http://www.w3.org/ns/ssn/",
    "time": "http://www.w3.org/2006/time#",
    "triple": "https://gotriple.eu/ontology/triple/",
    "vann": "http://purl.org/vocab/vann/",
    "void": "http://rdfs.org/ns/void#",
    "wgs": "https://www.w3.org/2003/01/geo/wgs84_pos#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "pt:institutional",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project funded or run internally by an institution, such as a university or research centre."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Institutional"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project funded or run internally by an institution, such as a university or research centre."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Institutional"
      }
    },
    {
      "@id": "triple:ProjectType",
      "@type": "owl:Class",
      "rdfs:label": {
        "@language": "en",
        "@value": "Project Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "pt:legacy",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A completed or historical research project included for archival and reference purposes."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Legacy"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A completed or historical research project included for archival and reference purposes."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Legacy"
      }
    },
    {
      "@id": "pt:crowdfunded",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project financed through collective contributions, typically via a crowdfunding platform."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Crowdfunded"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project financed through collective contributions, typically via a crowdfunding platform."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Crowdfunded"
      }
    },
    {
      "@id": "https://gotriple.eu/ontology/project-type",
      "@type": "owl:Ontology",
      "dcterms:abstract": {
        "@language": "en",
        "@value": "A controlled vocabulary for classifying research projects."
      },
      "dcterms:contributor": [
        "Luca De Santis",
        "Silvio Peroni"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2021-12-01"
      },
      "dcterms:creator": "Alessandro Bertozzi",
      "dcterms:description": {
        "@language": "en",
        "@value": "The Project Type vocabulary defines the various categories of research projects included in the TRIPLE platform, distinguishing between different funding schemes and project structures."
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-10"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Project Type"
      },
      "owl:versionInfo": "3.0.0",
      "vann:preferredNamespacePrefix": "pt",
      "vann:preferredNamespaceUri": "https://gotriple.eu/ontology/project-type/"
    },
    {
      "@id": "pt:citizen_science",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project conducted with the active participation of the general public."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Citizen Science"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project conducted with the active participation of the general public."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Citizen Science"
      }
    },
    {
      "@id": "pt:funded",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project financed by a formal funding programme, such as a European or national grant."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Funded"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project financed by a formal funding programme, such as a European or national grant."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Funded"
      }
    },
    {
      "@id": "pt:non_funded",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project carried out without dedicated external funding."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Non-funded"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project carried out without dedicated external funding."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Non-funded"
      }
    },
    {
      "@id": "pt:community_based",
      "@type": [
        "owl:NamedIndividual",
        "triple:ProjectType"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A research project initiated and driven by a community, typically outside formal institutional structures."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Community-based"
      },
      "skos:definition": {
        "@language": "en",
        "@value": "A research project initiated and driven by a community, typically outside formal institutional structures."
      },
      "skos:prefLabel": {
        "@language": "en",
        "@value": "Community-based"
      }
    }
  ]
}
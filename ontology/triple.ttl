@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix frapo: <http://purl.org/cerif/frapo/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix mod: <https://w3id.org/mod#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sshoc: <https://sshoc.eu/ontology/> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:creator a owl:ObjectProperty ;
    rdfs:label "dcterms:creator"@en ;
    rdfs:comment "The agent responsible for the annotation; for GoTriple enrichments, the GoTriple pipeline (SKG-IF associated_with)."@en .

datacite:ark a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:ark"@en ;
    rdfs:comment "Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints."@en .

datacite:doi a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:doi"@en ;
    rdfs:comment "Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation."@en .

datacite:handle a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:handle"@en ;
    rdfs:comment "Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built."@en .

datacite:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "datacite:hasIdentifier",
        "datacite:hasIdentifier"@en ;
    rdfs:comment "Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity."@en ;
    rdfs:range datacite:Identifier .

datacite:isbn a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:isbn"@en ;
    rdfs:comment "International Standard Book Number - a numeric identifier for books and book-like products."@en .

datacite:isni a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:isni"@en ;
    rdfs:comment "International Standard Name Identifier - an ISO standard identifier for the public identities of contributors to media content."@en .

datacite:issn a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:issn"@en ;
    rdfs:comment "International Standard Serial Number - the identifier of a serial publication, standardised as ISO 3297."@en .

datacite:orcid a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:orcid"@en ;
    rdfs:comment "Open Researcher and Contributor ID - a persistent identifier for researchers, maintained by ORCID Inc."@en .

datacite:researcherid a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:researcherid"@en ;
    rdfs:comment "ResearcherID - an identifier system for scientific authors, owned by Clarivate (formerly Thomson Reuters)."@en .

datacite:uri a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "datacite:uri"@en ;
    rdfs:comment "Uniform Resource Identifier - a string of characters that unambiguously identifies a particular resource."@en .

skos:closeMatch a owl:ObjectProperty ;
    rdfs:label "skos:closeMatch"@en ;
    rdfs:comment "A SKOS property indicating that two concepts are sufficiently similar to be used interchangeably in some contexts."@en .

skos:definition a owl:AnnotationProperty ;
    rdfs:label "skos:definition"@en ;
    rdfs:comment "A SKOS annotation property providing a complete explanation of the intended meaning of a concept."@en .

skos:exactMatch a owl:ObjectProperty ;
    rdfs:label "skos:exactMatch"@en ;
    rdfs:comment "A SKOS property indicating that two concepts can be used interchangeably across all contexts."@en .

skos:prefLabel a owl:AnnotationProperty .

dcat:accessURL a owl:ObjectProperty ;
    rdfs:label "dcat:accessURL"@en ;
    rdfs:comment "A URL of a resource that gives access to a distribution of the dataset — a landing page, portal or feed. When the URL is the file itself, dcat:downloadURL is the right property. IRI-valued by DCAT's own range (rdfs:Resource)."@en .

dcat:downloadURL a owl:ObjectProperty ;
    rdfs:label "dcat:downloadURL"@en ;
    rdfs:comment "The URL of the downloadable file of a distribution in a given format. IRI-valued."@en .

oa:classifying a owl:NamedIndividual,
        oa:Motivation ;
    rdfs:label "oa:classifying"@en ;
    rdfs:comment "The motivation for when the user intends to classify the Target as something; used for GoTriple discipline assignments."@en .

oa:hasBody a owl:ObjectProperty ;
    rdfs:label "hasBody"@en,
        "oa:hasBody"@en ;
    rdfs:comment "The object of the Annotation: for enrichment annotations, the concept or term assigned to the target."@en .

oa:hasTarget a owl:ObjectProperty ;
    rdfs:label "hasTarget"@en,
        "oa:hasTarget"@en ;
    rdfs:comment "The relationship between an Annotation and its Target."@en .

oa:identifying a owl:NamedIndividual,
        oa:Motivation ;
    rdfs:label "identifying"@en .

oa:motivatedBy a owl:ObjectProperty ;
    rdfs:label "motivatedBy"@en,
        "oa:motivatedBy"@en ;
    rdfs:comment "The reason why the Annotation was created; oa:classifying for discipline assignments, oa:tagging for keyword assignments."@en ;
    rdfs:range oa:Motivation .

oa:tagging a owl:NamedIndividual,
        oa:Motivation ;
    rdfs:label "oa:tagging"@en ;
    rdfs:comment "The motivation for when the user intends to associate a tag with the Target; used for GoTriple keyword assignments."@en .

<https://gotriple.eu/ontology/triple> a owl:Ontology ;
    rdfs:label "TRIPLE Ontology"@en ;
    dcterms:abstract "The TRIPLE Ontology defines a comprehensive model for representing Social Sciences and Humanities (SSH) resources in the GoTriple discovery platform, extending Schema.org and FOAF."@en ;
    dcterms:contributor "Luca De Santis",
        "Silvio Peroni" ;
    dcterms:created "2021-12-01"^^xsd:date ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:description "GoTriple is an advanced multilingual discovery platform specifically designed for the Social Sciences and Humanities (SSH) sector. The platform aggregates, processes, and semantically enriches diverse SSH resources including scholarly publications, research datasets, project descriptions, and researcher profiles from various European language repositories. The TRIPLE ontology serves as the data model for this platform, facilitating cross-disciplinary and cross-linguistic discovery and reuse of resources."@en ;
    dcterms:modified "2026-08-10"^^xsd:date ;
    dcterms:title "TRIPLE Ontology"@en ;
    vann:preferredNamespacePrefix "triple" ;
    vann:preferredNamespaceUri "https://gotriple.eu/ontology/triple/" ;
    rdfs:comment "Comprehensive semantic representation of the GoTriple discovery platform's data model for Social Sciences and Humanities (SSH) research artifacts."@en ;
    owl:priorVersion triple:2.2.0 ;
    owl:versionIRI triple:3.0.0 ;
    owl:versionInfo "3.0.0" .

triple:Dataset a owl:Class ;
    rdfs:label "Dataset"@en,
        "Dataset (Triple)"@en,
        "Jeu de Données"@fr,
        "Zbiór Danych"@pl,
        "Base de Dados"@pt ;
    rdfs:comment "A dataset in the GoTriple platform, representing research data with specific metadata including spatial coverage, temporal coverage, and distribution information. It is a subclass of dcat:Dataset. Original provider values are preserved before normalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom schema:Place ;
            owl:onProperty schema:spatialCoverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty schema:funding ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:ContactPoint ;
            owl:onProperty schema:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty schema:mentions ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:DefinedTerm ;
            owl:onProperty schema:keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty dcat:theme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:temporalCoverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:encodingFormat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:size ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:creativeWorkStatus ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:headline ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:abstract ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:about ],
        [ a owl:Restriction ;
            owl:onProperty schema:inLanguage ;
            owl:someValuesFrom schema:Language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:comment ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Document ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:mainEntityOfPage ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcat:Distribution ;
            owl:onProperty dcat:distribution ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty dcat:bbox ],
        [ a owl:Restriction ;
            owl:allValuesFrom dcterms:ProvenanceStatement ;
            owl:onProperty dcterms:provenance ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:License ;
            owl:onProperty triple:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:AccessCondition ;
            owl:onProperty triple:hasAccessCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:ContentType ;
            owl:onProperty triple:hasContentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:contributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalConditionsOfAccess ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalDatePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Project ;
            owl:onProperty frapo:isOutputOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty dcterms:isReferencedBy ],
        dcat:Dataset,
        schema:Dataset ;
    skos:closeMatch fabio:Dataset,
        sshoc:SHE1_Dataset .

triple:MediaObject a owl:Class ;
    rdfs:label "Media Object"@en,
        "Media Object (Triple)"@en,
        "Multimédia"@fr,
        "Multimedia"@pl,
        "Multimédia"@pt ;
    rdfs:comment "A multimedia object in the GoTriple platform, representing various types of media files (audio, video, images) associated with scholarly works. Original provider values are preserved before normalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalDatePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalConditionsOfAccess ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Project ;
            owl:onProperty frapo:isOutputOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:DefinedTerm ;
            owl:onProperty schema:keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Place ;
            owl:onProperty schema:spatialCoverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:headline ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:abstract ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:encodingFormat ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:duration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:size ],
        [ a owl:Restriction ;
            owl:onProperty schema:inLanguage ;
            owl:someValuesFrom schema:Language ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:License ;
            owl:onProperty triple:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:AccessCondition ;
            owl:onProperty triple:hasAccessCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:temporalCoverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:about ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty schema:mentions ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:ContentType ;
            owl:onProperty triple:hasContentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Document ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:ContactPoint ;
            owl:onProperty schema:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:contributor ],
        schema:MediaObject ;
    skos:closeMatch fabio:Work,
        crm:E90_Symbolic_Object .

triple:Profile a owl:Class ;
    rdfs:label "profile"@en,
        "Profil"@fr,
        "Profil"@pl,
        "Perfil"@pt ;
    rdfs:comment "A profile representing either a person or an organization in the GoTriple system. Can be associated or not associated with a user account."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:givenName ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:pronouns ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:image ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:image ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty foaf:topic_interest ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:knowsAbout ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Language ;
            owl:onProperty schema:knowsLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty schema:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty triple:registeredUser ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:registeredUser ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:givenName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty triple:openToCollaboration ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:openToCollaboration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:familyName ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:familyName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:pronouns ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty foaf:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass foaf:OnlineAccount ;
            owl:onProperty foaf:account ],
        [ owl:unionOf ( foaf:Person foaf:Organization ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:jobTitle ],
        foaf:Agent .

triple:SemanticArtefact a owl:Class ;
    rdfs:label "Semantic Artefact"@en,
        "Artefact Sémantique"@fr,
        "Artefakt Semantyczny"@pl,
        "Artefacto Semântico"@pt ;
    rdfs:comment "A semantic artefact in the context of GoTriple platform, representing formal knowledge representations such as ontologies, controlled vocabularies, and other semantic resources used in SSH research. Original provider values are preserved before normalization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalDatePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalConditionsOfAccess ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Project ;
            owl:onProperty frapo:isOutputOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:contributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:author ],
        [ a owl:Restriction ;
            owl:onProperty schema:inLanguage ;
            owl:someValuesFrom schema:Language ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:version ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty triple:aggregator ],
        [ a owl:Restriction ;
            owl:onProperty schema:fileFormat ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty schema:encodingFormat ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:ContactPoint ;
            owl:onProperty schema:contactPoint ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:creativeWorkStatus ],
        [ a owl:Restriction ;
            owl:onProperty schema:headline ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:DefinedTerm ;
            owl:onProperty schema:keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Document ;
            owl:onProperty dcterms:isReferencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Place ;
            owl:onProperty schema:spatialCoverage ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:about ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:License ;
            owl:onProperty triple:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:AccessCondition ;
            owl:onProperty triple:hasAccessCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:ContentType ;
            owl:onProperty triple:hasContentType ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty adms:representationTechnique ],
        [ a owl:Restriction ;
            owl:allValuesFrom owl:Thing ;
            owl:onProperty schema:mentions ],
        [ a owl:Restriction ;
            owl:onProperty schema:abstract ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty schema:isBasedOn ],
        schema:CreativeWork,
        mod:SemanticArtefact ;
    skos:closeMatch fabio:Work,
        crm:E90_Symbolic_Object .

triple:confidence a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
    rdfs:comment "The trust score of an automatic enrichment, between 0 and 1, as produced by the GoTriple pipeline (SKG-IF 'trust')."@en ;
    rdfs:domain oa:Annotation ;
    rdfs:range xsd:decimal .

triple:full_text_url_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "Full Text URL"@en ;
    rdfs:comment "URL providing direct access to the full content of the document."@en .

triple:gotriple_id_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "GoTriple ID"@en ;
    rdfs:comment "The OPERAS/GoTriple identifier assigned to a profile (the goTripleId field)."@en .

triple:idref_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "IdRef"@en ;
    rdfs:comment "IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it."@en .

triple:internal_id_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "TRIPLE Internal ID"@en ;
    rdfs:comment "Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id."@en .

triple:isDiscarded a owl:DatatypeProperty ;
    rdfs:label "is discarded"@en ;
    rdfs:comment "A boolean flag indicating whether an entity (author or keyword) has been marked as discarded and should not be used for search/filtering."@en ;
    rdfs:range xsd:boolean .

triple:landing_page_url_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "Landing Page URL"@en ;
    rdfs:comment "URL of the landing page containing metadata and descriptive information about the document."@en .

triple:original_id_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "Original Identifier"@en ;
    rdfs:comment "Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number)."@en .

triple:source_url_schema a datacite:IdentifierScheme,
        owl:NamedIndividual ;
    rdfs:label "Source URL"@en ;
    rdfs:comment "URL of the original publication location or source repository."@en .

schema:creator a owl:ObjectProperty ;
    rdfs:label "schema:creator"@en ;
    rdfs:comment "The creator or author of this CreativeWork (Schema.org). Super-property of schema:author."@en .

schema:sameAs a owl:ObjectProperty ;
    rdfs:label "schema:sameAs"@en ;
    rdfs:comment "URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity)."@en .

frapo:Grant a owl:Class ;
    rdfs:label "frapo:Grant"@en ;
    rdfs:comment "A funding grant."@en .

dc:date a owl:DatatypeProperty ;
    rdfs:label "dc:date"@en ;
    rdfs:comment "A point or period of time associated with an event in the lifecycle of the resource (Dublin Core Elements 1.1)."@en .

dc:language a owl:DatatypeProperty ;
    rdfs:label "dc:language"@en ;
    rdfs:comment "A language of the resource (Dublin Core Elements 1.1)."@en .

dc:source a owl:DatatypeProperty ;
    rdfs:label "dc:source"@en ;
    rdfs:comment "A related resource from which the described resource is derived (Dublin Core Elements 1.1)."@en .

dc:type a owl:DatatypeProperty ;
    rdfs:label "dc:type"@en ;
    rdfs:comment "The nature or genre of the resource (Dublin Core Elements 1.1)."@en .

dcterms:LicenseDocument a owl:Class ;
    rdfs:label "dcterms:LicenseDocument"@en ;
    rdfs:comment "A legal document giving official permission to do something with a resource (DCMI Metadata Terms). Superclass of triple:License."@en .

dcterms:RightsStatement a owl:Class ;
    rdfs:label "dcterms:RightsStatement"@en ;
    rdfs:comment "A statement about the intellectual property rights held in or over a resource (DCMI Metadata Terms). Superclass of triple:AccessCondition."@en .

dcterms:accessRights a owl:ObjectProperty ;
    rdfs:label "dcterms:accessRights"@en ;
    rdfs:comment "Information about who access the resource or an indication of its security status (DCMI Metadata Terms). Super-property of triple:hasAccessCondition."@en .

dcterms:license a owl:ObjectProperty ;
    rdfs:label "dcterms:license"@en ;
    rdfs:comment "A legal document giving official permission to do something with the resource (DCMI Metadata Terms). Super-property of triple:hasLicense."@en .

dcterms:provenance a owl:ObjectProperty ;
    rdfs:label "dcterms:provenance"@en ;
    rdfs:comment "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
    rdfs:range dcterms:ProvenanceStatement .

dcterms:references a owl:ObjectProperty ;
    rdfs:label "dcterms:references"@en ;
    rdfs:comment "A related resource that is referenced, cited, or otherwise pointed to by the described resource. Declared inverse of dcterms:isReferencedBy (DCMI), which the model already carries on Dataset, MediaObject and SemanticArtefact: this is the active side, on the document. Not a formal bibliographic citation."@en ;
    owl:inverseOf dcterms:isReferencedBy .

dcterms:source a owl:ObjectProperty ;
    rdfs:label "dcterms:source"@en ;
    rdfs:comment "A related resource from which the described resource is derived. In GoTriple it points to the system the document was harvested from."@en .

datacite:usesIdentifierScheme a owl:ObjectProperty ;
    rdfs:label "datacite:usesIdentifierScheme"@en ;
    rdfs:comment "Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another."@en ;
    rdfs:domain datacite:Identifier ;
    rdfs:range datacite:IdentifierScheme .

fabio:Dataset a owl:Class ;
    rdfs:label "fabio:Dataset"@en ;
    rdfs:comment "A dataset."@en .

fabio:ScholarlyWork a owl:Class ;
    rdfs:label "fabio:ScholarlyWork"@en ;
    rdfs:comment "A scholarly work."@en .

crm:E31_Document a owl:Class ;
    rdfs:label "E31 Document"@en .

crm:E7_Activity a owl:Class ;
    rdfs:label "E7 Activity"@en .

litre:hasLiteralValue a owl:DatatypeProperty ;
    rdfs:label "litre:hasLiteralValue"@en ;
    rdfs:comment "Associates an entity with a literal value representing its textual content."@en .

adms:representationTechnique a owl:ObjectProperty ;
    rdfs:label "adms:representationTechnique"@en ;
    rdfs:comment "More information about the format in which the semantic artefact is released. This is different from the file format: for example, a ZIP file (file format) could contain an XML schema (representation technique)."@en ;
    rdfs:range skos:Concept .

dcat:Dataset a owl:Class ;
    rdfs:label "dcat:Dataset"@en ;
    rdfs:comment "A collection of data, published or curated by a single agent, and available for access or download in one or more representations (DCAT). Superclass of triple:Dataset."@en .

dcat:Distribution a owl:Class ;
    rdfs:label "dcat:Distribution"@en ;
    rdfs:comment "A specific representation of a dataset: a downloadable file, an API or a feed (DCAT)."@en .

dcat:bbox a owl:DatatypeProperty ;
    rdfs:label "dcat:bbox"@en ;
    rdfs:comment "The bounding box of the dataset, expressed as a literal (e.g., WKT)."@en ;
    rdfs:range rdfs:Literal .

dcat:distribution a owl:ObjectProperty ;
    rdfs:label "dcat:distribution"@en ;
    rdfs:comment "An available distribution of the dataset (DCAT)."@en .

dcat:theme a owl:ObjectProperty ;
    rdfs:label "dcat:theme"@en ;
    rdfs:comment "A main category of the dataset, as originally assigned by the source provider (e.g. a concept from the provider's thematic vocabulary). Distinct from sioc:topic, which carries the automatically assigned TRIPLE disciplines."@en ;
    rdfs:subPropertyOf dcterms:subject .

prov:alternateOf a owl:ObjectProperty ;
    rdfs:label "prov:alternateOf"@en ;
    rdfs:comment "PROV-O property relating two entities that present aspects of the same thing. Reflexive, symmetric and transitive by specification: the direction that tells the representative apart is added by its specialisation triple:isDuplicateOf."@en .

foaf:Agent a owl:Class ;
    rdfs:label "foaf:Agent"@en ;
    rdfs:comment "An agent (person or organization)."@en .

foaf:Document a owl:Class ;
    rdfs:label "foaf:Document"@en .

foaf:OnlineAccount a owl:Class ;
    rdfs:label "foaf:OnlineAccount"@en ;
    rdfs:comment "An online account held by a GoTriple user. Created inside the platform, so it carries only its internal identifier."@en .

foaf:account a owl:ObjectProperty ;
    rdfs:label "foaf:account"@en ;
    rdfs:comment "Indicates an account held by this agent"@en .

foaf:topic_interest a owl:ObjectProperty ;
    rdfs:label "foaf:topic_interest"@en ;
    rdfs:comment "A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications."@en .

triple:detectedLanguage a owl:DatatypeProperty ;
    rdfs:label "detected language"@en ;
    rdfs:comment "The language tag identified by the GoTriple language-detection service for the resource's text, which may differ from the language declared by the provider (triple:originalLanguage) and from the normalized language (schema:inLanguage)."@en ;
    rdfs:range xsd:string .

triple:hasProjectType a owl:ObjectProperty ;
    rdfs:label "has project type"@en ;
    rdfs:comment "Links a project to its project type."@en ;
    rdfs:range triple:ProjectType ;
    rdfs:subPropertyOf dcterms:type .

triple:isDuplicateOf a owl:ObjectProperty ;
    rdfs:label "is duplicate of"@en ;
    rdfs:comment "Links a record to the representative record of the same scholarly work, elected by the GoTriple deduplication pipeline (API field cluster_id carries the representative's identifier; is_duplicate and is_cluster derive from this link). The representative is the target and asserts nothing; subject and object are records of the same content entity. A representative is never itself a duplicate and a record never points at itself: both rules are checked in shapes/."@en ;
    rdfs:subPropertyOf prov:alternateOf .

triple:machineTranslatedLanguage a owl:DatatypeProperty ;
    rdfs:label "machine translated language"@en ;
    rdfs:comment "A language tag whose title and abstract versions were produced by the GoTriple machine-translation service. Title/abstract literals carrying this language tag are machine translations; the remaining language versions are as provided by the source."@en ;
    rdfs:range xsd:string .

schema:Dataset a owl:Class ;
    rdfs:label "schema:Dataset"@en ;
    rdfs:comment "A body of structured information describing some topic of one or more collections of data (Schema.org)."@en .

schema:Grant a owl:Class ;
    rdfs:label "schema:Grant"@en ;
    rdfs:comment "A Grant that directly or indirectly provide funding or sponsorship for this item."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:funder ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:sponsor ] .

schema:MediaObject a owl:Class ;
    rdfs:label "schema:MediaObject"@en ;
    rdfs:comment "A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset. Note that a creative work may have many media objects associated with it on the same web page."@en .

schema:Organization a owl:Class ;
    rdfs:label "schema:Organization"@en .

schema:Person a owl:Class ;
    rdfs:label "Person"@en,
        "schema:Person"@en .

schema:Project a owl:Class ;
    rdfs:label "schema:Project"@en ;
    rdfs:comment "An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim."@en .

schema:Text a rdfs:Datatype .

schema:affiliation a owl:ObjectProperty ;
    rdfs:label "schema:affiliation"@en ;
    rdfs:comment "An organization the agent is affiliated with. Used in GoTriple for the current organization specified by the user in the Experience tab."@en .

schema:alternateName a owl:DatatypeProperty ;
    rdfs:label "schema:alternateName"@en ;
    rdfs:comment "An alias for the item"@en .

schema:comment a owl:DatatypeProperty ;
    rdfs:label "schema:comment"@en ;
    rdfs:comment "Comments, typically from users."@en .

schema:duration a owl:DatatypeProperty ;
    rdfs:label "schema:duration"@en ;
    rdfs:comment "The duration of the item (movie, audio recording, event, etc.) in ISO 8601 duration format."@en .

schema:email a owl:DatatypeProperty ;
    rdfs:label "schema:email"@en .

schema:fileFormat a owl:DatatypeProperty ;
    rdfs:label "schema:fileFormat" ;
    rdfs:comment "Media type, typically MIME format"@en .

schema:funder a owl:ObjectProperty ;
    rdfs:label "schema:funder"@en ;
    rdfs:comment "A person or organization that supports something through some kind of financial contribution"@en .

schema:jobTitle a owl:DatatypeProperty ;
    rdfs:label "schema:jobTitle"@en ;
    rdfs:comment "The job title of the person, as the plain string the provider supplies. Chosen over schema:hasOccupation, whose range demands a structured schema:Occupation node: when an Occupation vocabulary exists, hasOccupation will be added beside jobTitle without changing it."@en .

schema:knowsAbout a owl:ObjectProperty ;
    rdfs:label "schema:knowsAbout"@en ;
    rdfs:comment "A topic the agent knows about. Schema.org declares it for Person and Organization, so it is in domain here: every triple:Profile is a person or an organization. It carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) the user declares to know about. The data model revision leaves this field unmapped: the choice of this property is the ontology own."@en .

schema:knowsLanguage a owl:ObjectProperty ;
    rdfs:label "schema:knowsLanguage"@en ;
    rdfs:comment "A language the agent knows."@en .

schema:organizer a owl:ObjectProperty ;
    rdfs:label "schema:organizer"@en ;
    rdfs:comment "The organization who organizes the event or project."@en .

schema:sponsor a owl:ObjectProperty ;
    rdfs:label "schema:sponsor"@en ;
    rdfs:comment "A person or organization that supports a thing through a pledge, promise, or financial contribution"@en .

schema:url a owl:ObjectProperty ;
    rdfs:label "schema:url"@en ;
    rdfs:comment "The URL of the entity. Used in GoTriple for the personal web pages of the profile."@en .

schema:version a owl:DatatypeProperty ;
    rdfs:label "schema:version" ;
    rdfs:comment "The version of the CreativeWork"@en .

sshoc:SHE1_Dataset a owl:Class ;
    rdfs:label "SHE1 Dataset"@en .

sshoc:SHE3_SSH_Project a owl:Class ;
    rdfs:label "SHE3 SSH Project"@en .

sshoc:SHE8_Publication a owl:Class ;
    rdfs:label "SHE8 Publication"@en .

mod:SemanticArtefact a owl:Class ;
    rdfs:label "mod:SemanticArtefact"@en ;
    rdfs:comment "A machine-readable object that formalises a shared conceptualisation: an ontology, a thesaurus, a taxonomy, a vocabulary (MOD, Metadata for Ontology Description and publication)."@en .

dc:rights a owl:DatatypeProperty ;
    rdfs:label "dc:rights"@en ;
    rdfs:comment "Information about rights held in and over the resource (Dublin Core Elements 1.1)."@en .

dcterms:ProvenanceStatement a owl:Class ;
    rdfs:label "dcterms:ProvenanceStatement"@en ;
    rdfs:comment "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en .

dcterms:subject a owl:ObjectProperty ;
    rdfs:label "dcterms:subject"@en ;
    rdfs:comment "A topic of the resource (DCMI Metadata Terms). Super-property of sioc:topic and dcat:theme."@en .

dcterms:type a owl:ObjectProperty ;
    rdfs:label "dcterms:type"@en ;
    rdfs:comment "The nature or genre of the resource (DCMI Metadata Terms). Super-property of triple:hasContentType and triple:hasProjectType."@en .

datacite:Identifier a owl:Class ;
    rdfs:label "datacite:Identifier"@en ;
    rdfs:comment "An identifier that uniquely identifies an entity according to some identification scheme."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass datacite:IdentifierScheme ;
            owl:onProperty datacite:usesIdentifierScheme ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty litre:hasLiteralValue ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

fabio:Work a owl:Class ;
    rdfs:label "fabio:Work"@en ;
    rdfs:comment "A work."@en .

crm:E90_Symbolic_Object a owl:Class ;
    rdfs:label "E90 Symbolic Object"@en .

oa:Annotation a owl:Class ;
    rdfs:label "Annotation"@en,
        "oa:Annotation"@en ;
    rdfs:comment "A Web Annotation; used by GoTriple to record enrichment provenance (classification and tagging) with its confidence."@en .

foaf:familyName a owl:DatatypeProperty ;
    rdfs:label "foaf:familyName"@en ;
    rdfs:comment "The family name (last name) of a person."@en .

foaf:givenName a owl:DatatypeProperty ;
    rdfs:label "foaf:givenName"@en ;
    rdfs:comment "The given name (first name) of a person."@en .

triple:ProjectType a owl:Class ;
    rdfs:label "Project Type"@en ;
    rdfs:comment "The kind of research project (funded, crowdfunded, citizen science, ...), drawn from the Project Type controlled vocabulary."@en ;
    rdfs:subClassOf skos:Concept .

triple:aggregator a owl:ObjectProperty ;
    rdfs:label "aggregator"@en ;
    rdfs:comment "An aggregator that collates resources from different sources"@en ;
    rdfs:range [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
    rdfs:subPropertyOf schema:contributor .

triple:openToCollaboration a owl:DatatypeProperty ;
    rdfs:label "open to collaboration"@en ;
    rdfs:comment "Whether the registered user declared to be open to collaboration with other GoTriple users."@en ;
    rdfs:range xsd:boolean .

triple:pronouns a owl:DatatypeProperty ;
    rdfs:label "pronouns"@en ;
    rdfs:comment "The personal pronouns chosen by the user for their GoTriple profile (e.g. \"she/her\")."@en ;
    rdfs:range xsd:string .

triple:registeredUser a owl:DatatypeProperty ;
    rdfs:label "registered user"@en ;
    rdfs:comment "Whether the profile belongs to a registered GoTriple user (true) or was automatically created for an author extracted from harvested document metadata (false)."@en ;
    rdfs:range xsd:boolean .

schema:Thing a owl:Class ;
    rdfs:label "schema:Thing"@en .

schema:creativeWorkStatus a owl:DatatypeProperty ;
    rdfs:label "schema:creativeWorkStatus",
        "schema:creativeWorkStatus"@en ;
    rdfs:comment "The status of a creative work in terms of its stage in a lifecycle."@en .

schema:description a owl:DatatypeProperty ;
    rdfs:label "schema:description"@en ;
    rdfs:comment "A description of the item. Used in GoTriple for the self-description of a profile."@en .

schema:endDate a owl:DatatypeProperty ;
    rdfs:label "schema:endDate"@en ;
    rdfs:comment "The end date and time of the item"@en .

schema:funding a owl:ObjectProperty ;
    rdfs:label "schema:funding"@en ;
    rdfs:comment "A Grant that directly or indirectly provide funding or sponsorship for this item."@en .

schema:image a owl:ObjectProperty ;
    rdfs:label "schema:image"@en ;
    rdfs:comment "An image of the entity. Used in GoTriple for the URL of the personal picture chosen by the user."@en .

schema:isBasedOn a owl:ObjectProperty ;
    rdfs:label "schema:isBasedOn"@en ;
    rdfs:comment "A resource from which this work is derived or from which it is a modification or adaptation. Supersedes the deprecated schema:isBasedOnUrl, which the data model revision still names. The value is an IRI (role-B link): an external resource today, possibly a platform resource tomorrow, with the same triple shape."@en .

schema:mainEntityOfPage a owl:DatatypeProperty ;
    rdfs:label "schema:mainEntityOfPage"@en ;
    rdfs:comment "Indicates a page (or other CreativeWork) for which this thing is the main entity being described."@en .

schema:size a owl:DatatypeProperty ;
    rdfs:label "schema:size"@en ;
    rdfs:comment "A standardized size of a product or creative work, specified either through a simple textual string or a QuantitativeValue."@en .

schema:startDate a owl:DatatypeProperty ;
    rdfs:label "schema:startDate"@en ;
    rdfs:comment "The start date and time of the item"@en .

foaf:name a owl:DatatypeProperty ;
    rdfs:label "foaf:name"@en ;
    rdfs:comment "The full name of the agent, as a plain string. Chosen over schema:name for FOAF-typed agents (profiles, persons, organizations): it completes the FOAF naming triad with foaf:givenName and foaf:familyName, and is declared rdfs:subPropertyOf rdfs:label by FOAF itself, so generic consumers see it as a label by inference. schema:name remains on schema-typed things (projects, languages, keywords, places)."@en .

triple:originalSource a owl:DatatypeProperty ;
    rdfs:label "original source"@en ;
    rdfs:comment "The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:source .

schema:provider a owl:ObjectProperty ;
    rdfs:label "schema:provider"@en ;
    rdfs:comment "The service provider, service operator, or service performer; the goods producer."@en .

schema:temporalCoverage a owl:DatatypeProperty ;
    rdfs:label "schema:temporalCoverage",
        "schema:temporalCoverage"@en ;
    rdfs:comment "The temporalCoverage of a CreativeWork indicates the period that the content applies to."@en .

frapo:isOutputOf a owl:ObjectProperty ;
    rdfs:label "frapo:isOutputOf"@en ;
    rdfs:comment "Indicates that a research output is the result of a particular project."@en .

oa:Motivation a owl:Class ;
    rdfs:label "Motivation"@en,
        "oa:Motivation"@en .

triple:Document a owl:Class ;
    rdfs:label "Document"@en,
        "Document (Triple)"@en,
        "Document"@fr,
        "Dokument"@pl,
        "Documento"@pt ;
    rdfs:comment "A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty schema:keywords ;
            owl:someValuesFrom schema:DefinedTerm ],
        [ a owl:Restriction ;
            owl:onProperty schema:spatialCoverage ;
            owl:someValuesFrom schema:Place ],
        [ a owl:Restriction ;
            owl:onProperty schema:temporalCoverage ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:about ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:detectedLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:machineTranslatedLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalDatePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalConditionsOfAccess ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:originalSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Project ;
            owl:onProperty frapo:isOutputOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:License ;
            owl:onProperty triple:hasLicense ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:AccessCondition ;
            owl:onProperty triple:hasAccessCondition ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:ContentType ;
            owl:onProperty triple:hasContentType ],
        [ a owl:Restriction ;
            owl:onProperty schema:mentions ;
            owl:someValuesFrom oa:Annotation ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty schema:isBasedOn ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:CreativeWork ;
            owl:onProperty dcterms:references ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:provider ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty triple:aggregator ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:ContactPoint ;
            owl:onProperty schema:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:author ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
            owl:onProperty schema:contributor ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Document ;
            owl:onProperty triple:isDuplicateOf ],
        [ a owl:Restriction ;
            owl:onProperty dcterms:source ;
            owl:someValuesFrom owl:Thing ],
        [ a owl:Restriction ;
            owl:onProperty schema:encodingFormat ;
            owl:someValuesFrom xsd:string ],
        [ a owl:Restriction ;
            owl:onProperty sioc:topic ;
            owl:someValuesFrom skos:Concept ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:datePublished ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:onProperty schema:inLanguage ;
            owl:someValuesFrom schema:Language ],
        [ a owl:Restriction ;
            owl:onProperty schema:headline ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ],
        [ a owl:Restriction ;
            owl:onProperty schema:abstract ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ],
        foaf:Document,
        schema:CreativeWork ;
    skos:closeMatch fabio:ScholarlyWork,
        sshoc:SHE8_Publication ;
    skos:exactMatch crm:E31_Document .

triple:Project a owl:Class ;
    rdfs:label "Project"@en,
        "Project (Triple)"@en,
        "Projet"@fr,
        "Projekt"@pl,
        "Projeto"@pt ;
    rdfs:comment "A research project in the Social Sciences and Humanities domain integrated into the GoTriple platform. It is a subclass of schema:Project."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:startDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:startDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:endDate ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:endDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Grant ;
            owl:onProperty schema:funding ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty sioc:topic ],
        [ a owl:Restriction ;
            owl:allValuesFrom skos:Concept ;
            owl:onProperty schema:about ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:DefinedTerm ;
            owl:onProperty schema:keywords ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty schema:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:langString ;
            owl:onProperty schema:alternateName ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Organization ;
            owl:onProperty schema:organizer ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:mainEntityOfPage ],
        [ a owl:Restriction ;
            owl:onProperty schema:inLanguage ;
            owl:someValuesFrom schema:Language ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateCreated ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:ContactPoint ;
            owl:onProperty schema:contactPoint ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:ProjectType ;
            owl:onProperty triple:hasProjectType ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:name ],
        schema:Project ;
    skos:closeMatch frapo:Grant,
        crm:E7_Activity,
        sshoc:SHE3_SSH_Project .

triple:hasAccessCondition a owl:ObjectProperty ;
    rdfs:label "has access condition"@en ;
    rdfs:comment "Links a resource to its access condition."@en ;
    rdfs:range triple:AccessCondition ;
    rdfs:subPropertyOf dcterms:accessRights .

triple:hasContentType a owl:ObjectProperty ;
    rdfs:label "has content type"@en ;
    rdfs:comment "Links a resource to its content type."@en ;
    rdfs:range triple:ContentType ;
    rdfs:subPropertyOf dcterms:type .

triple:hasLicense a owl:ObjectProperty ;
    rdfs:label "has license"@en ;
    rdfs:comment "Links a resource to its licence."@en ;
    rdfs:range triple:License ;
    rdfs:subPropertyOf dcterms:license .

triple:originalConditionsOfAccess a owl:DatatypeProperty ;
    rdfs:label "original conditions of access"@en ;
    rdfs:comment "The access rights statement exactly as received from the source provider (e.g. 'info:eu-repo/semantics/openAccess'), before normalization to the Access Condition controlled vocabulary. The normalized value is expressed via triple:hasAccessCondition."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:rights .

triple:originalDatePublished a owl:DatatypeProperty ;
    rdfs:label "original date published"@en ;
    rdfs:comment "The publication date string exactly as received from the source provider, in whatever format the provider used (e.g. '03/05/2021', 'May 2021'), before conversion to ISO 8601. The normalized value is expressed via schema:datePublished."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:date .

triple:originalLanguage a owl:DatatypeProperty ;
    rdfs:label "original language"@en ;
    rdfs:comment "The language value exactly as received from the source provider, before normalization to a schema:Language entity (e.g. 'eng', 'English', 'fr-FR'). The normalized value is expressed via schema:inLanguage."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:language .

triple:originalLicense a owl:DatatypeProperty ;
    rdfs:label "original license"@en ;
    rdfs:comment "The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:rights .

triple:originalType a owl:DatatypeProperty ;
    rdfs:label "original type"@en ;
    rdfs:comment "The resource type exactly as received from the source provider, before normalization to the Content Type controlled vocabulary (e.g. 'journalArticle'). The normalized value is expressed via triple:hasContentType."@en ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dc:type .

schema:URL a rdfs:Datatype,
        owl:Class ;
    rdfs:label "schema:URL"@en ;
    rdfs:comment "Data type: URL."@en .

schema:abstract a owl:DatatypeProperty ;
    rdfs:label "schema:abstract",
        "schema:abstract"@en ;
    rdfs:comment "An abstract is a short description that summarizes a CreativeWork."@en .

schema:author a owl:ObjectProperty ;
    rdfs:label "schema:author"@en ;
    rdfs:comment "The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property."@en .

schema:encodingFormat a owl:DatatypeProperty ;
    rdfs:label "schema:encodingFormat",
        "schema:encodingFormat"@en ;
    rdfs:comment "Media type typically expressed using a MIME format."@en .

schema:headline a owl:DatatypeProperty ;
    rdfs:label "schema:headline",
        "schema:headline"@en ;
    rdfs:comment "Headline of the article."@en .

schema:mentions a owl:ObjectProperty ;
    rdfs:label "mentions"@en,
        "schema:mentions"@en ;
    rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing."@en .

schema:publisher a owl:ObjectProperty ;
    rdfs:label "schema:publisher"@en ;
    rdfs:comment "The publisher of the creative work."@en .

schema:spatialCoverage a owl:ObjectProperty ;
    rdfs:label "schema:spatialCoverage",
        "schema:spatialCoverage"@en ;
    rdfs:comment "The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content."@en ;
    rdfs:range schema:Place .

triple:AccessCondition a owl:Class ;
    rdfs:label "Access Condition"@en ;
    rdfs:comment "The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights."@en ;
    rdfs:subClassOf dcterms:RightsStatement,
        skos:Concept .

triple:ContentType a owl:Class ;
    rdfs:label "Content Type"@en ;
    rdfs:comment "The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types."@en ;
    rdfs:subClassOf skos:Concept .

triple:License a owl:Class ;
    rdfs:label "License"@en ;
    rdfs:comment "The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX."@en ;
    rdfs:subClassOf dcterms:LicenseDocument,
        skos:Concept .

schema:DefinedTerm a owl:Class ;
    rdfs:label "schema:DefinedTerm"@en ;
    rdfs:comment "A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty schema:name ;
            owl:someValuesFrom schema:Text ] .

schema:Place a owl:Class ;
    rdfs:label "Place"@en,
        "schema:Place"@en ;
    rdfs:comment "Entities that have a somewhat fixed, physical extension."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty schema:name ;
            owl:someValuesFrom xsd:string ] .

schema:about a owl:ObjectProperty ;
    rdfs:label "schema:about"@en ;
    rdfs:comment "The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them."@en .

schema:contactPoint a owl:ObjectProperty ;
    rdfs:label "schema:contactPoint"@en ;
    rdfs:comment "A contact point for a person or organization."@en ;
    rdfs:range schema:ContactPoint .

schema:contributor a owl:ObjectProperty ;
    rdfs:label "schema:contributor"@en ;
    rdfs:comment "A secondary contributor to the CreativeWork or Event."@en .

schema:inLanguage a owl:ObjectProperty ;
    rdfs:label "schema:inLanguage"@en ;
    rdfs:comment "The language of the content or performance or used in an action."@en .

schema:keywords a owl:ObjectProperty ;
    rdfs:label "schema:keywords",
        "schema:keywords"@en ;
    rdfs:comment "Keywords or tags used to describe this content. In GoTriple these are the producer's own keywords, free text with no URI; the concepts detected by the enrichment pipeline are carried by schema:about instead."@en .

schema:name a owl:DatatypeProperty ;
    rdfs:label "schema:name",
        "name"@en,
        "schema:name"@en ;
    rdfs:comment "The name of the item."@en .

triple:Discipline a owl:Class ;
    rdfs:label "Discipline"@en ;
    rdfs:comment "An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification."@en ;
    rdfs:subClassOf skos:Concept .

schema:ContactPoint a owl:Class ;
    rdfs:label "schema:ContactPoint",
        "schema:ContactPoint"@en ;
    rdfs:comment "A contact point for a person or organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema:email ] .

schema:Language a owl:Class ;
    rdfs:label "schema:Language"@en ;
    rdfs:comment "Natural language such as Spanish, Tamil, or English."@en .

sioc:topic a owl:ObjectProperty ;
    rdfs:label "sioc:topic"@en ;
    rdfs:comment "The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus."@en ;
    rdfs:subPropertyOf dcterms:subject .

dcterms:isReferencedBy a owl:ObjectProperty ;
    rdfs:label "dcterms:isReferencedBy"@en ;
    rdfs:comment "A related resource that references, cites, or otherwise points to the described resource."@en .

schema:CreativeWork a owl:Class ;
    rdfs:label "schema:CreativeWork"@en .

schema:dateCreated a owl:DatatypeProperty ;
    rdfs:label "schema:dateCreated",
        "schema:dateCreated"@en ;
    rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed."@en .

schema:datePublished a owl:DatatypeProperty ;
    rdfs:label "schema:datePublished",
        "schema:datePublished"@en ;
    rdfs:comment "Date of first publication or broadcast. In GoTriple it is normalized to ISO 8601 (yyyy-mm-dd)."@en .

schema:dateModified a owl:DatatypeProperty ;
    rdfs:label "schema:dateModified",
        "schema:dateModified"@en ;
    rdfs:comment "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update."@en .

skos:Concept a owl:Class ;
    rdfs:label "Concept"@en,
        "skos:Concept"@en ;
    rdfs:comment "A concept of a knowledge organization system, from SKOS. Values of schema:about are the concepts of the TRIPLE Vocabulary (SSH-LCSH), maintained by the TRIPLE consortium and published on semantics.gr."@en .

datacite:IdentifierScheme a owl:Class ;
    rdfs:label "datacite:IdentifierScheme"@en ;
    rdfs:comment "A scheme that uniquely identifies entities of a particular type."@en .

foaf:Person a owl:Class ;
    rdfs:label "foaf:Person"@en ;
    rdfs:comment "A person."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty foaf:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:Thing ;
    owl:equivalentClass schema:Person .

foaf:Organization a owl:Class ;
    rdfs:label "foaf:Organization"@en ;
    rdfs:comment "An organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty foaf:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:Thing .


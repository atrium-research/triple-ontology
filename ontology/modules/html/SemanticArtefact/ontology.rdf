  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
    <rdfs:comment xml:lang="en">Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/uri">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:uri</rdfs:label>
    <rdfs:comment xml:lang="en">Uniform Resource Identifier - a string of characters that unambiguously identifies a particular resource.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:comment xml:lang="en">Associates an entity with a literal value representing its textual content.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="https://schema.org/name">
    <rdfs:label>schema:name</rdfs:label>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:label xml:lang="en">schema:name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the item.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/original_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Original Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number).</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/doi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:doi</rdfs:label>
    <rdfs:comment xml:lang="en">Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
    <rdfs:comment xml:lang="en">Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/spatialCoverage">
    <rdfs:label>schema:spatialCoverage</rdfs:label>
    <rdfs:label xml:lang="en">schema:spatialCoverage</rdfs:label>
    <rdfs:comment xml:lang="en">The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contributor">
    <rdfs:label xml:lang="en">schema:contributor</rdfs:label>
    <rdfs:comment xml:lang="en">A secondary contributor to the CreativeWork or Event.</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b88">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b91">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/aggregator">
    <rdfs:label xml:lang="en">aggregator</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregator that collates resources from different sources</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b55">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/contributor"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/publisher">
    <rdfs:label xml:lang="en">schema:publisher</rdfs:label>
    <rdfs:comment xml:lang="en">The publisher of the creative work.</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b82">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b85">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/type">
    <rdfs:label xml:lang="en">dc:type</rdfs:label>
    <rdfs:comment xml:lang="en">The nature or genre of the resource (Dublin Core Elements 1.1).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasAccessCondition">
    <rdfs:label xml:lang="en">has access condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its access condition.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/AccessCondition"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/accessRights"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/encodingFormat">
    <rdfs:label>schema:encodingFormat</rdfs:label>
    <rdfs:label xml:lang="en">schema:encodingFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type typically expressed using a MIME format.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contactPoint">
    <rdfs:label xml:lang="en">schema:contactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalDatePublished">
    <rdfs:label xml:lang="en">original date published</rdfs:label>
    <rdfs:comment xml:lang="en">The publication date string exactly as received from the source provider, in whatever format the provider used (e.g. '03/05/2021', 'May 2021'), before conversion to ISO 8601. The normalized value is expressed via schema:datePublished.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/date">
        <rdfs:label xml:lang="en">dc:date</rdfs:label>
        <rdfs:comment xml:lang="en">A point or period of time associated with an event in the lifecycle of the resource (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/headline">
    <rdfs:label>schema:headline</rdfs:label>
    <rdfs:label xml:lang="en">schema:headline</rdfs:label>
    <rdfs:comment xml:lang="en">Headline of the article.</rdfs:comment>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b73">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b76">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b79">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/abstract">
    <rdfs:label>schema:abstract</rdfs:label>
    <rdfs:label xml:lang="en">schema:abstract</rdfs:label>
    <rdfs:comment xml:lang="en">An abstract is a short description that summarizes a CreativeWork.</rdfs:comment>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b58">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b61">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b64">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/author">
    <rdfs:label xml:lang="en">schema:author</rdfs:label>
    <rdfs:comment xml:lang="en">The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property.</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b67">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b70">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/creator"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Document">
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="en">Document (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Document</rdfs:label>
    <rdfs:label xml:lang="pl">Dokument</rdfs:label>
    <rdfs:label xml:lang="pt">Documento</rdfs:label>
    <rdfs:comment xml:lang="en">A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
    <skos:exactMatch rdf:resource="http://purl.org/spar/fabio/ScholarlyWork"/>
    <skos:exactMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
    <skos:exactMatch rdf:resource="https://sshoc.eu/ontology/SHE8_Publication"/>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/AccessCondition">
    <rdfs:label xml:lang="en">Access Condition</rdfs:label>
    <rdfs:comment xml:lang="en">The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/version">
    <rdfs:label>schema:version</rdfs:label>
    <rdfs:comment xml:lang="en">The version of the CreativeWork</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/fileFormat">
    <rdfs:label>schema:fileFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type, typically MIME format</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/datacite/Identifier">
    <rdfs:label xml:lang="en">datacite:Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">An identifier that uniquely identifies an entity according to some identification scheme.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalSource">
    <rdfs:label xml:lang="en">original source</rdfs:label>
    <rdfs:comment xml:lang="en">The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/source">
        <rdfs:label xml:lang="en">dc:source</rdfs:label>
        <rdfs:comment xml:lang="en">A related resource from which the described resource is derived (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/ContactPoint">
    <rdfs:label>schema:ContactPoint</rdfs:label>
    <rdfs:label xml:lang="en">schema:ContactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ContentType">
    <rdfs:label xml:lang="en">Content Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateModified">
    <rdfs:label>schema:dateModified</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateModified</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Language">
    <rdfs:label xml:lang="en">schema:Language</rdfs:label>
    <rdfs:comment xml:lang="en">Natural language such as Spanish, Tamil, or English.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/language">
    <rdfs:label xml:lang="en">dc:language</rdfs:label>
    <rdfs:comment xml:lang="en">A language of the resource (Dublin Core Elements 1.1).</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/adms#representationTechnique">
    <rdfs:label xml:lang="en">adms:representationTechnique</rdfs:label>
    <rdfs:comment xml:lang="en">More information about the format in which the semantic artefact is released. This is different from the file format: for example, a ZIP file (file format) could contain an XML schema (representation technique).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Place">
    <rdfs:label xml:lang="en">Place</rdfs:label>
    <rdfs:label xml:lang="en">schema:Place</rdfs:label>
    <rdfs:comment xml:lang="en">Entities that have a somewhat fixed, physical extension.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
    <rdfs:label>schema:datePublished</rdfs:label>
    <rdfs:label xml:lang="en">schema:datePublished</rdfs:label>
    <rdfs:comment xml:lang="en">Date of first publication or broadcast. In GoTriple it is normalized to ISO 8601 (yyyy-mm-dd).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated">
    <rdfs:label>schema:dateCreated</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateCreated</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/License">
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:comment xml:lang="en">The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/LicenseDocument"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/spar/datacite/IdentifierScheme">
    <rdfs:label xml:lang="en">datacite:IdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">A scheme that uniquely identifies entities of a particular type.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object">
    <rdfs:label xml:lang="en">E90 Symbolic Object</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Project">
    <rdfs:label xml:lang="en">Project</rdfs:label>
    <rdfs:label xml:lang="en">Project (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Projet</rdfs:label>
    <rdfs:label xml:lang="pl">Projekt</rdfs:label>
    <rdfs:label xml:lang="pt">Projeto</rdfs:label>
    <rdfs:comment xml:lang="en">A research project in the Social Sciences and Humanities domain integrated into the GoTriple platform. It is a subclass of schema:Project.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://schema.org/Project"/>
    <skos:closeMatch rdf:resource="http://purl.org/cerif/frapo/Grant"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:exactMatch rdf:resource="https://sshoc.eu/ontology/SHE3_SSH_Project"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasContentType">
    <rdfs:label xml:lang="en">has content type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its content type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:label xml:lang="en">skos:Concept</rdfs:label>
    <rdfs:comment xml:lang="en">A concept of a knowledge organization system, from SKOS. Values of schema:about are the concepts of the TRIPLE Vocabulary (SSH-LCSH), maintained by the TRIPLE consortium and published on semantics.gr.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/DefinedTerm">
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
    <rdfs:comment xml:lang="en">A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/creativeWorkStatus">
    <rdfs:label>schema:creativeWorkStatus</rdfs:label>
    <rdfs:label xml:lang="en">schema:creativeWorkStatus</rdfs:label>
    <rdfs:comment xml:lang="en">The status of a creative work in terms of its stage in a lifecycle.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalType">
    <rdfs:label xml:lang="en">original type</rdfs:label>
    <rdfs:comment xml:lang="en">The resource type exactly as received from the source provider, before normalization to the Content Type controlled vocabulary (e.g. 'journalArticle'). The normalized value is expressed via triple:hasContentType.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/type"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/CreativeWork">
    <rdfs:label xml:lang="en">schema:CreativeWork</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalConditionsOfAccess">
    <rdfs:label xml:lang="en">original conditions of access</rdfs:label>
    <rdfs:comment xml:lang="en">The access rights statement exactly as received from the source provider (e.g. 'info:eu-repo/semantics/openAccess'), before normalization to the Access Condition controlled vocabulary. The normalized value is expressed via triple:hasAccessCondition.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/rights">
        <rdfs:label xml:lang="en">dc:rights</rdfs:label>
        <rdfs:comment xml:lang="en">Information about rights held in and over the resource (Dublin Core Elements 1.1).</rdfs:comment>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isOutputOf">
    <rdfs:label xml:lang="en">frapo:isOutputOf</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a research output is the result of a particular project.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/keywords">
    <rdfs:label>schema:keywords</rdfs:label>
    <rdfs:label xml:lang="en">schema:keywords</rdfs:label>
    <rdfs:comment xml:lang="en">Keywords or tags used to describe this content. In GoTriple these are the producer's own keywords, free text with no URI; the concepts detected by the enrichment pipeline are carried by schema:about instead.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdfs:label xml:lang="en">foaf:Organization</rdfs:label>
    <rdfs:comment xml:lang="en">An organization.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLicense">
    <rdfs:label xml:lang="en">original license</rdfs:label>
    <rdfs:comment xml:lang="en">The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/mentions">
    <rdfs:label xml:lang="en">mentions</rdfs:label>
    <rdfs:label xml:lang="en">schema:mentions</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/inLanguage">
    <rdfs:label xml:lang="en">schema:inLanguage</rdfs:label>
    <rdfs:comment xml:lang="en">The language of the content or performance or used in an action.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Language"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasLicense">
    <rdfs:label xml:lang="en">has license</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its licence.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/License"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/license"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://w3id.org/mod#SemanticArtefact">
    <rdfs:label xml:lang="en">mod:SemanticArtefact</rdfs:label>
    <rdfs:comment xml:lang="en">A machine-readable object that formalises a shared conceptualisation: an ontology, a thesaurus, a taxonomy, a vocabulary (MOD, Metadata for Ontology Description and publication).</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdfs:label xml:lang="en">foaf:Person</rdfs:label>
    <rdfs:comment xml:lang="en">A person.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
    <owl:equivalentClass rdf:resource="https://schema.org/Person"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/isReferencedBy">
    <rdfs:label xml:lang="en">dcterms:isReferencedBy</rdfs:label>
    <rdfs:comment xml:lang="en">A related resource that references, cites, or otherwise points to the described resource.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLanguage">
    <rdfs:label xml:lang="en">original language</rdfs:label>
    <rdfs:comment xml:lang="en">The language value exactly as received from the source provider, before normalization to a schema:Language entity (e.g. 'eng', 'English', 'fr-FR'). The normalized value is expressed via schema:inLanguage.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/language"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/fabio/Work">
    <rdfs:label xml:lang="en">fabio:Work</rdfs:label>
    <rdfs:comment xml:lang="en">A work.</rdfs:comment>
  </owl:Class>
</rdf:RDF>

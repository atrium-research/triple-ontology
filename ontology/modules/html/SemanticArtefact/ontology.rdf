    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/License"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/license"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>

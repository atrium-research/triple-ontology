>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/SemanticArtefact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Semantic Artefact</rdfs:label>
    <rdfs:label xml:lang="fr">Artefact Sémantique</rdfs:label>
    <rdfs:label xml:lang="pl">Artefakt Semantyczny</rdfs:label>
    <rdfs:label xml:lang="pt">Artefacto Semântico</rdfs:label>
    <dcterms:abstract xml:lang="en">The Semantic Artefact module of the TRIPLE Ontology, defining Ontologies, Vocabularies, and Thesauri.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Semantic Artefact module is dedicated to describing the semantic assets used or indexed by the GoTriple platform, such as ontologies, taxonomies, and thesauri. It extends the MOD (Metadata for Ontology Description) ontology to provide rich metadata about these knowledge organization systems, including their versioning, format, and status.</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Semantic Artefact</dcterms:title>
    <rdfs:comment xml:lang="en">A semantic artefact in the context of GoTriple platform, representing formal knowledge representations such as ontologies, controlled vocabularies, and other semantic resources used in SSH research. Original provider values are preserved before normalization.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n4473bc88446a415590cdfba6d29426c7b1">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
        <owl:onProperty rdf:resource="http://purl.org/cerif/frapo/isOutputOf"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>

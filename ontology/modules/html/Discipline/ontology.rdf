  <owl:Ontology rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dcterms:title xml:lang="en">Discipline</dcterms:title>
    <dcterms:description xml:lang="en">The Discipline vocabulary provides a classification scheme for academic disciplines and fields of study, with a focus on Humanities and Social Sciences. It allows resources to be categorized by their subject area.</dcterms:description>
    <dcterms:abstract xml:lang="en">A controlled vocabulary of academic disciplines, supporting multilingual discovery of resources.</dcterms:abstract>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <owl:versionInfo>3.0.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>disc</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://gotriple.eu/ontology/triple/Discipline/</vann:preferredNamespaceUri>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-10</dcterms:modified>
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Ontology>

<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:datacite="http://purl.org/spar/datacite/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:schema="https://schema.org/"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/isni">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">datacite:isni</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Name Identifier - an ISO standard identifier for the public identities of contributors to media content.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="http://purl.org/spar/literal/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Ontology rdf:about="https://gotriple.eu/ontology/triple/Profile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Profile</rdfs:label>
    <rdfs:label xml:lang="en">profile</rdfs:label>
    <rdfs:label xml:lang="pt">Perfil</rdfs:label>
    <rdfs:label xml:lang="pl">Profil</rdfs:label>
    <rdfs:label xml:lang="fr">Profil</rdfs:label>
    <dcterms:title xml:lang="en">Profile</dcterms:title>
    <dcterms:abstract xml:lang="en">The Profile module of the TRIPLE Ontology, defining Agents (People, Organizations) and Accounts.</dcterms:abstract>
    <dcterms:description xml:lang="en">The Profile module models the actors within the GoTriple ecosystem. It defines `triple:Profile` for describing researchers and organizations, aligning them with `foaf:Person` and `foaf:Organization`. It also manages User Accounts (`foaf:OnlineAccount`) and their association with profiles to handle platform access and identity. Since iteration 19 the profile also carries personal names, self-description, pronouns, photo, personal web pages, disciplines of interest, thesaurus keywords, known languages, affiliation, registration and collaboration flags, the date of the last GoTriple update, and several identifiers kept apart by their scheme: the internal Elasticsearch id (`triple:ID`), the persistent identifier minted by GoTriple (`triple:PID`), the OPERAS/GoTriple id and the external person PIDs (ORCID, IdRef, ISNI, ResearcherID).</dcterms:description>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:modified>2026-07-27</dcterms:modified>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <owl:versionInfo>2.2.0</owl:versionInfo>
    <schema:creativeWorkStatus>Ontology Module</schema:creativeWorkStatus>
    <rdfs:comment xml:lang="en">A profile representing either a person or an organization in the GoTriple system. Can be associated or not associated with a user account.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb1">
        <owl:onClass rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb2">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb3">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onClass rdf:resource="http://xmlns.com/foaf/0.1/OnlineAccount"/>
        <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/account"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb4">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/givenName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb5">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/givenName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb6">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/familyName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb7">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/familyName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb8">
        <owl:allValuesFrom>
          <rdfs:Datatype rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb9">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
              <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>

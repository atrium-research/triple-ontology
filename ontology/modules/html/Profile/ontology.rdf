    <skos:exactMatch rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
  </owl:Ontology>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ID">
    <rdfs:label xml:lang="en">Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Internal identifier used within the GoTriple platform for resource management. On profiles it carries the Elasticsearch id.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/researcherid">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">datacite:researcherid</rdfs:label>
    <rdfs:comment xml:lang="en">ResearcherID - an identifier system for scientific authors, owned by Clarivate (formerly Thomson Reuters).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://gotriple.eu/ontology/triple/idref_schema">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">IdRef</rdfs:label>
    <rdfs:comment xml:lang="en">IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://gotriple.eu/ontology/triple/gotriple_id_schema">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">GoTriple ID</rdfs:label>
    <rdfs:comment xml:lang="en">The OPERAS/GoTriple identifier assigned to a profile (the goTripleId field).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/PID">
    <rdfs:label xml:lang="en">Persistent ID</rdfs:label>
    <rdfs:comment xml:lang="en">Persistent identifier generated and exposed externally by the GoTriple platform. On profiles it carries the pid field, distinct from the OPERAS/GoTriple id.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/orcid">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">datacite:orcid</rdfs:label>
    <rdfs:comment xml:lang="en">Open Researcher and Contributor ID - a persistent identifier for researchers, maintained by ORCID Inc.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="http://purl.org/spar/datacite/local-resource-identifier-scheme">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdfs:label xml:lang="en">datacite:local-resource-identifier-scheme</rdfs:label>
    <rdfs:comment xml:lang="en">Local resource identifier scheme, used for the internal Elasticsearch id of the profile.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdfs:label xml:lang="en">foaf:Person</rdfs:label>
    <rdfs:comment xml:lang="en">A person.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb30">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
    <owl:equivalentClass rdf:resource="https://schema.org/Person"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/url">
    <rdfs:label xml:lang="en">schema:url</rdfs:label>
    <rdfs:comment xml:lang="en">The URL of the entity. Used in GoTriple for the personal web pages of the profile.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/registeredUser">
    <rdfs:label xml:lang="en">registered user</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the profile belongs to a registered GoTriple user (true) or was automatically created for an author extracted from harvested document metadata (false).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/pronouns">
    <rdfs:label xml:lang="en">pronouns</rdfs:label>
    <rdfs:comment xml:lang="en">The personal pronouns chosen by the user for their GoTriple profile (e.g. "she/her").</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/account">
    <rdfs:label xml:lang="en">foaf:account</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates an account held by this agent</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/name">
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/image">
    <rdfs:label xml:lang="en">schema:image</rdfs:label>
    <rdfs:comment xml:lang="en">An image of the entity. Used in GoTriple for the URL of the personal picture chosen by the user.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/DefinedTerm">
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
    <rdfs:comment xml:lang="en">A word, name, acronym or phrase defined in a controlled vocabulary. Used for structured thesaurus keywords.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdfs:label xml:lang="en">foaf:Organization</rdfs:label>
    <rdfs:comment xml:lang="en">An organization.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb31">
        <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/knowsLanguage">
    <rdfs:label xml:lang="en">schema:knowsLanguage</rdfs:label>
    <rdfs:comment xml:lang="en">A language the agent knows.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/description">
    <rdfs:label xml:lang="en">schema:description</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the entity. Used in GoTriple for the self-description of the profile.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
    <rdfs:label xml:lang="en">foaf:Agent</rdfs:label>
    <rdfs:comment xml:lang="en">An agent (person or organization).</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/openToCollaboration">
    <rdfs:label xml:lang="en">open to collaboration</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the registered user declared to be open to collaboration with other GoTriple users.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/URL">
    <rdfs:label xml:lang="en">schema:URL</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/OnlineAccount">
    <rdfs:label xml:lang="en">foaf:OnlineAccount</rdfs:label>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n3b615f44788f4dd6aac9aea33547feebb32">
        <owl:onClass rdf:resource="http://purl.org/spar/datacite/Identifier"/>
        <owl:onProperty rdf:resource="http://purl.org/spar/datacite/hasIdentifier"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/affiliation">
    <rdfs:label xml:lang="en">schema:affiliation</rdfs:label>
    <rdfs:comment xml:lang="en">An organization the agent is affiliated with. Used in GoTriple for the current organization specified by the user in the Experience tab.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/spar/datacite/Identifier">
    <rdfs:label xml:lang="en">datacite:Identifier</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/spar/datacite/IdentifierScheme">
    <rdfs:label xml:lang="en">datacite:IdentifierScheme</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateModified">
    <rdfs:label xml:lang="en">schema:dateModified</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the entity was most recently modified. Used on profiles for the last GoTriple update.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/familyName">
    <rdfs:label xml:lang="en">foaf:familyName</rdfs:label>
    <rdfs:comment xml:lang="en">The family name (last name) of a person.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Thing">
    <rdfs:label xml:lang="en">schema:Thing</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/topic_interest">
    <rdfs:label xml:lang="en">foaf:topic_interest</rdfs:label>
    <rdfs:comment xml:lang="en">A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Person">
    <rdfs:label xml:lang="en">Person</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">skos:Concept</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/givenName">
    <rdfs:label xml:lang="en">foaf:givenName</rdfs:label>
    <rdfs:comment xml:lang="en">The given name (first name) of a person.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/knowsAbout">
    <rdfs:label xml:lang="en">schema:knowsAbout</rdfs:label>
    <rdfs:comment xml:lang="en">A topic the agent knows about. Natively declared by Schema.org for Person and Organization; used in GoTriple to link a profile to structured thesaurus keywords.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Language">
    <rdfs:label xml:lang="en">schema:Language</rdfs:label>
  </owl:Class>
</rdf:RDF>

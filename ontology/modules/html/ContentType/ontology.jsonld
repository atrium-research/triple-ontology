    {
      "@id": "triple:ContentType",
      "@type": [
        "owl:Ontology",
        "owl:Class"
      ],
      "dcterms:abstract": {
        "@language": "en",
        "@value": "A hierarchical controlled vocabulary for classifying the nature and genre of scholarly resources."
      },
      "dcterms:contributor": [
        "Luca De Santis",
        "Silvio Peroni"
      ],
      "dcterms:created": {
        "@type": "xsd:date",
        "@value": "2021-12-01"
      },
      "dcterms:creator": "Alessandro Bertozzi",
      "dcterms:description": {
        "@language": "en",
        "@value": "The Content Type vocabulary categorizes the different types of resources available in the TRIPLE platform, such as journal articles, datasets, images, and video. It includes mappings to the COAR Resource Type Vocabulary to ensure interoperability."
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-10"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "Content Type"
      },
      "owl:versionInfo": "3.0.0",
      "rdfs:label": {
        "@language": "en",
        "@value": "Content Type"
      },
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "vann:preferredNamespacePrefix": "ct",
      "vann:preferredNamespaceUri": "https://gotriple.eu/ontology/triple/ContentType/"
    },

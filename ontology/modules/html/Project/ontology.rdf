<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:schema="https://schema.org/"
>
  <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isOutputOf">
    <rdfs:label xml:lang="en">frapo:isOutputOf</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a research output is the result of a particular project.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasProjectType">
    <rdfs:label xml:lang="en">has project type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a project to its project type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ProjectType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E7_Activity">
    <rdfs:label xml:lang="en">E7 Activity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Project</rdfs:label>
    <rdfs:label xml:lang="en">Project (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Projet</rdfs:label>
    <rdfs:label xml:lang="pl">Projekt</rdfs:label>
    <rdfs:label xml:lang="pt">Projeto</rdfs:label>
    <dcterms:abstract xml:lang="en">The Project module of the TRIPLE Ontology, defining Projects, Grants, and Funding.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Project module describes research projects and their funding structures. It defines the `triple:Project` class and links it to Grants (`schema:Grant`, `frapo:Grant`), Funding sources, and Organizations. It also includes the `triple:ProjectType` classification to categorize projects (e.g., EU-funded, National, Citizen Science).</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Project</dcterms:title>
    <rdfs:comment xml:lang="en">A research project in the Social Sciences and Humanities domain integrated into the GoTriple platform. It is a subclass of schema:Project.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b1">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/endDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b2">
        <owl:onProperty rdf:resource="https://schema.org/inLanguage"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Language"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b3">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b4">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b5">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b6">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b7">
        <owl:allValuesFrom rdf:resource="https://schema.org/ContactPoint"/>
        <owl:onProperty rdf:resource="https://schema.org/contactPoint"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b8">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ProjectType"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasProjectType"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b9">
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b10">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/startDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b11">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/startDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b12">
        <owl:allValuesFrom rdf:resource="https://schema.org/Grant"/>
        <owl:onProperty rdf:resource="https://schema.org/funding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b13">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/endDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b14">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:onProperty rdf:resource="https://schema.org/about"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b15">
        <owl:allValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
        <owl:onProperty rdf:resource="https://schema.org/keywords"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b16">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <owl:onProperty rdf:resource="https://schema.org/description"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b17">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <owl:onProperty rdf:resource="https://schema.org/alternateName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b18">
        <owl:allValuesFrom rdf:resource="https://schema.org/Organization"/>
        <owl:onProperty rdf:resource="https://schema.org/organizer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b19">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Discipline"/>
        <owl:onProperty rdf:resource="http://rdfs.org/sioc/ns#topic"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b20">
        <owl:allValuesFrom rdf:resource="https://schema.org/URL"/>
        <owl:onProperty rdf:resource="https://schema.org/mainEntityOfPage"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Project"/>
    <owl:versionInfo>3.0.0</owl:versionInfo>
    <skos:closeMatch rdf:resource="http://purl.org/cerif/frapo/Grant"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:exactMatch rdf:resource="https://sshoc.eu/ontology/SHE3_SSH_Project"/>
    <schema:creativeWorkStatus>Ontology Module</schema:creativeWorkStatus>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/description">
    <rdfs:label xml:lang="en">schema:description</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the item. Used in GoTriple for the self-description of a profile.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Project">
    <rdfs:label xml:lang="en">schema:Project</rdfs:label>
    <rdfs:comment xml:lang="en">An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/organizer">
    <rdfs:label xml:lang="en">schema:organizer</rdfs:label>
    <rdfs:comment xml:lang="en">The organization who organizes the event or project.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Organization"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/endDate">
    <rdfs:label xml:lang="en">schema:endDate</rdfs:label>
    <rdfs:comment xml:lang="en">The end date and time of the item</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ProjectType">
    <rdfs:label xml:lang="en">Project Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of research project (funded, crowdfunded, citizen science, ...), drawn from the Project Type controlled vocabulary.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Grant">
    <rdfs:label xml:lang="en">schema:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b21">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b22">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/funder"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b25">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b26">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://schema.org/sponsor"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/startDate">
    <rdfs:label xml:lang="en">schema:startDate</rdfs:label>
    <rdfs:comment xml:lang="en">The start date and time of the item</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/alternateName">
    <rdfs:label xml:lang="en">schema:alternateName</rdfs:label>
    <rdfs:comment xml:lang="en">An alias for the item</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/funder">
    <rdfs:label xml:lang="en">schema:funder</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports something through some kind of financial contribution</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="nff0cbdd747a54733a560d9665eddb091b29">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/cerif/frapo/Grant">
    <rdfs:label xml:lang="en">frapo:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A funding grant.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/sponsor">
    <rdfs:label xml:lang="en">schema:sponsor</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports a thing through a pledge, promise, or financial contribution</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/funding">
    <rdfs:label xml:lang="en">schema:funding</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE3_SSH_Project">
    <rdfs:label xml:lang="en">SHE3 SSH Project</rdfs:label>
  </owl:Class>
</rdf:RDF>

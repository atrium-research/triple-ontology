<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:datacite="http://purl.org/spar/datacite/"
  xmlns:schema="https://schema.org/"
>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Project</rdfs:label>
    <rdfs:label xml:lang="en">Project (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Projet</rdfs:label>
    <rdfs:label xml:lang="pl">Projekt</rdfs:label>
    <rdfs:label xml:lang="pt">Projeto</rdfs:label>
    <dcterms:abstract xml:lang="en">The Project module of the TRIPLE Ontology, defining Projects, Grants, and Funding.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Project module describes research projects and their funding structures. It defines the `triple:Project` class and links it to Grants (`schema:Grant`, `frapo:Grant`), Funding sources, and Organizations. It also includes the `triple:ProjectType` classification to categorize projects (e.g., EU-funded, National, Citizen Science).</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Project</dcterms:title>
    <rdfs:comment xml:lang="en">A research project in the Social Sciences and Humanities domain integrated into the GoTriple platform. It is a subclass of schema:Project.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb1">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/startDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb2">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/startDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb3">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/endDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb4">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/endDate"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb5">
        <owl:allValuesFrom rdf:resource="https://schema.org/Grant"/>
        <owl:onProperty rdf:resource="https://schema.org/funding"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb6">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Discipline"/>
        <owl:onProperty rdf:resource="http://rdfs.org/sioc/ns#topic"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb7">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <owl:onProperty rdf:resource="https://schema.org/about"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb8">
        <owl:allValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
        <owl:onProperty rdf:resource="https://schema.org/keywords"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb9">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <owl:onProperty rdf:resource="https://schema.org/description"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb10">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
        <owl:onProperty rdf:resource="https://schema.org/alternateName"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb11">
        <owl:allValuesFrom rdf:resource="https://schema.org/Organization"/>
        <owl:onProperty rdf:resource="https://schema.org/organizer"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb12">
        <owl:allValuesFrom rdf:resource="https://schema.org/URL"/>
        <owl:onProperty rdf:resource="https://schema.org/mainEntityOfPage"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb13">
        <owl:onProperty rdf:resource="https://schema.org/inLanguage"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Language"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb14">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb15">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb16">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb17">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb18">
        <owl:allValuesFrom rdf:resource="https://schema.org/ContactPoint"/>
        <owl:onProperty rdf:resource="https://schema.org/contactPoint"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb19">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ProjectType"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasProjectType"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nc76d28d9e4ab48f78465bd924160c69eb20">
        <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
        <owl:onProperty rdf:resource="https://schema.org/name"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf rdf:resource="https://schema.org/Project"/>
    <owl:versionInfo>3.0.0</owl:versionInfo>
    <skos:closeMatch rdf:resource="http://purl.org/cerif/frapo/Grant"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:exactMatch rdf:resource="https://sshoc.eu/ontology/SHE3_SSH_Project"/>
    <schema:creativeWorkStatus>Ontology Module</schema:creativeWorkStatus>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/funder">
    <rdfs:label xml:lang="en">schema:funder</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports something through some kind of financial contribution</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isOutputOf">
    <rdfs:label xml:lang="en">frapo:isOutputOf</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a research output is the result of a particular project.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/sponsor">
    <rdfs:label xml:lang="en">schema:sponsor</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports a thing through a pledge, promise, or financial contribution</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
    <rdfs:comment xml:lang="en">Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/original_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Original Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number).</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ProjectType">
    <rdfs:label xml:lang="en">Project Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of research project (funded, crowdfunded, citizen science, ...), drawn from the Project Type controlled vocabulary.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE3_SSH_Project">
    <rdfs:label xml:lang="en">SHE3 SSH Project</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/description">
    <rdfs:label xml:lang="en">schema:description</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the item. Used in GoTriple for the self-description of a profile.</rdfs:comment>
  </owl:DatatypeProperty>
  <rdfs:Datatype rdf:about="https://schema.org/URL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:URL</rdfs:label>
    <rdfs:comment xml:lang="en">Data type: URL.</rdfs:comment>
  </rdfs:Datatype>
  <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Project">
    <rdfs:label xml:lang="en">schema:Project</rdfs:label>
    <rdfs:comment xml:lang="en">An enterprise (potentially individual but typically collaborative), planned to achieve a particular aim.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/keywords">
    <rdfs:label>schema:keywords</rdfs:label>
    <rdfs:label xml:lang="en">schema:keywords</rdfs:label>
    <rdfs:comment xml:lang="en">Keywords or tags used to describe this content. In GoTriple these are the producer's own keywords, free text with no URI; the concepts detected by the enrichment pipeline are carried by schema:about instead.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/mainEntityOfPage">
    <rdfs:label xml:lang="en">schema:mainEntityOfPage</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a page (or other CreativeWork) for which this thing is the main entity being described.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateCreated">
    <rdfs:label>schema:dateCreated</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateCreated</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contactPoint">
    <rdfs:label xml:lang="en">schema:contactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
    <rdfs:label xml:lang="en">skos:Concept</rdfs:label>
    <rdfs:comment xml:lang="en">A concept of a knowledge organization system, from SKOS. Values of schema:about are the concepts of the TRIPLE Vocabulary (SSH-LCSH), maintained by the TRIPLE consortium and published on semantics.gr.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/name">
    <rdfs:label>schema:name</rdfs:label>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:label xml:lang="en">schema:name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the item.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/Grant">
    <rdfs:label xml:lang="en">schema:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/endDate">
    <rdfs:label xml:lang="en">schema:endDate</rdfs:label>
    <rdfs:comment xml:lang="en">The end date and time of the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/Organization">
    <rdfs:label xml:lang="en">schema:Organization</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/alternateName">
    <rdfs:label xml:lang="en">schema:alternateName</rdfs:label>
    <rdfs:comment xml:lang="en">An alias for the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateModified">
    <rdfs:label>schema:dateModified</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateModified</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update.</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/startDate">
    <rdfs:label xml:lang="en">schema:startDate</rdfs:label>
    <rdfs:comment xml:lang="en">The start date and time of the item</rdfs:comment>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/DefinedTerm">
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
    <rdfs:comment xml:lang="en">A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/ContactPoint">
    <rdfs:label>schema:ContactPoint</rdfs:label>
    <rdfs:label xml:lang="en">schema:ContactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/Language">
    <rdfs:label xml:lang="en">schema:Language</rdfs:label>
    <rdfs:comment xml:lang="en">Natural language such as Spanish, Tamil, or English.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/inLanguage">
    <rdfs:label xml:lang="en">schema:inLanguage</rdfs:label>
    <rdfs:comment xml:lang="en">The language of the content or performance or used in an action.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/organizer">
    <rdfs:label xml:lang="en">schema:organizer</rdfs:label>
    <rdfs:comment xml:lang="en">The organization who organizes the event or project.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasProjectType">
    <rdfs:label xml:lang="en">has project type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a project to its project type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ProjectType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/funding">
    <rdfs:label xml:lang="en">schema:funding</rdfs:label>
    <rdfs:comment xml:lang="en">A Grant that directly or indirectly provide funding or sponsorship for this item.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E7_Activity">
    <rdfs:label xml:lang="en">E7 Activity</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/cerif/frapo/Grant">
    <rdfs:label xml:lang="en">frapo:Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A funding grant.</rdfs:comment>
  </owl:Class>
</rdf:RDF>

    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/abstract">
    <rdfs:label xml:lang="en">schema:abstract</rdfs:label>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n29b2e24e6c794b318a7d095e583f46b7b56">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/encodingFormat">
    <rdfs:label>schema:encodingFormat</rdfs:label>
    <rdfs:label xml:lang="en">schema:encodingFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type typically expressed using a MIME format.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://schema.org/MediaObject">
    <rdfs:label xml:lang="en">schema:MediaObject</rdfs:label>
    <rdfs:comment xml:lang="en">A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset. Note that a creative work may have many media objects associated with it on the same web page.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/keywords">
    <rdfs:label xml:lang="en">schema:keywords</rdfs:label>
    <rdfs:range rdf:resource="https://schema.org/DefinedTerm"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalSource">
    <rdfs:label xml:lang="en">original source</rdfs:label>
    <rdfs:comment xml:lang="en">The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/source"/>
  </owl:DatatypeProperty>

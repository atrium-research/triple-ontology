    <rdfs:label xml:lang="en">schema:duration</rdfs:label>
    <rdfs:comment xml:lang="en">The duration of the item (movie, audio recording, event, etc.) in ISO 8601 duration format.</rdfs:comment>
  </owl:DatatypeProperty>

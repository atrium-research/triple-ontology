      <owl:Restriction rdf:nodeID="n29b2e24e6c794b318a7d095e583f46b7b75">
        <owl:onProperty rdf:resource="https://schema.org/name"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Text"/>
      </owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasAccessCondition">
    <rdfs:label xml:lang="en">has access condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its access condition.</rdfs:comment>

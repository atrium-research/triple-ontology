  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalDatePublished">
    <rdfs:label xml:lang="en">original date published</rdfs:label>
    <rdfs:comment xml:lang="en">The publication date string exactly as received from the source provider, in whatever format the provider used (e.g. '03/05/2021', 'May 2021'), before conversion to ISO 8601. The normalized value is expressed via schema:datePublished.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/knowsAbout">
    <rdfs:label xml:lang="en">knows about</rdfs:label>
    <rdfs:comment xml:lang="en">Links a GoTriple resource to a keyword extracted by the enrichment pipeline, represented as a schema:DefinedTerm with multilingual labels and an optional external URI. Introduced because schema:knowsAbout is declared only for Person and Organization; schema:about is the in-domain super-property for creative works.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/DefinedTerm"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/about"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/spar/fabio/Work">
    <rdfs:label xml:lang="en">fabio:Work</rdfs:label>
  </owl:Class>

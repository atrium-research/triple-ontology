  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/MediaObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Media Object</rdfs:label>
    <rdfs:label xml:lang="en">Media Object (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Multimédia</rdfs:label>
    <rdfs:label xml:lang="pl">Multimedia</rdfs:label>
    <rdfs:label xml:lang="pt">Multimédia</rdfs:label>
    <dcterms:abstract xml:lang="en">The Media Object module of the TRIPLE Ontology, defining Audio, Video, and Image resources.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Media Object module manages multimedia resources within the platform. It defines the `triple:MediaObject` class for audio, video, and image content, providing properties to describe their technical characteristics (duration, size, encoding format) and intellectual content, aligned with `schema:MediaObject` and `fabio:Work`.</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Media Object</dcterms:title>
    <rdfs:comment xml:lang="en">A media object such as an image, video, audio, or other multimedia content used in SSH research.</rdfs:comment>
    <rdfs:comment xml:lang="en">A multimedia object in the GoTriple platform, representing various types of media files (audio, video, images) associated with scholarly works.</rdfs:comment>

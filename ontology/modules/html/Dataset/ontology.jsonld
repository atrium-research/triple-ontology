  {
    "@id": "https://gotriple.eu/ontology/triple/Document",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Document"
      },
      {
        "@language": "en",
        "@value": "Document (Triple)"
      },
      {
        "@language": "fr",
        "@value": "Document"
      },
      {
        "@language": "pl",
        "@value": "Dokument"
      },
      {
        "@language": "pt",
        "@value": "Documento"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://xmlns.com/foaf/0.1/Document"
      },
      {
        "@id": "https://schema.org/CreativeWork"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#exactMatch": [
      {
        "@id": "http://purl.org/spar/fabio/ScholarlyWork"
      },
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E31_Document"
      },
      {
        "@id": "https://sshoc.eu/ontology/SHE8_Publication"
      }
    ]
  },
  {
    "@id": "https://gotriple.eu/ontology/triple/internal_id_schema",
    "@type": [
      "http://purl.org/spar/datacite/IdentifierScheme",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "TRIPLE Internal ID"
      }
    ]
  },
  {
    "@id": "https://gotriple.eu/ontology/triple/original_id_schema",
    "@type": [
      "http://purl.org/spar/datacite/IdentifierScheme",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Original Identifier"
      }
    ]
  },

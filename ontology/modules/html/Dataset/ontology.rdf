  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
    <rdfs:comment xml:lang="en">Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:comment xml:lang="en">Associates an entity with a literal value representing its textual content.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="https://schema.org/name">
    <rdfs:label>schema:name</rdfs:label>
    <rdfs:label xml:lang="en">name</rdfs:label>
    <rdfs:label xml:lang="en">schema:name</rdfs:label>
    <rdfs:comment xml:lang="en">The name of the item.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/original_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Original Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number).</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/doi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:doi</rdfs:label>
    <rdfs:comment xml:lang="en">Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
    <rdfs:comment xml:lang="en">Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/spatialCoverage">
    <rdfs:label>schema:spatialCoverage</rdfs:label>
    <rdfs:label xml:lang="en">schema:spatialCoverage</rdfs:label>
    <rdfs:comment xml:lang="en">The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
  </owl:ObjectProperty>

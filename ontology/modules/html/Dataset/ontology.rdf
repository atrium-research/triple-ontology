        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n780149d5a09748d9a66aaa6d3d4db59cb86">
        <owl:unionOf rdf:parseType="Collection">

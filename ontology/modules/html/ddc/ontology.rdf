  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:NamedIndividual rdf:about="https://gotriple.eu/ontology/triple/ddc/304">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label xml:lang="en">Factors affecting social behavior</rdfs:label>
    <rdfs:isDefinedBy>
      <owl:Ontology rdf:about="https://gotriple.eu/ontology/triple/ddc">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <dcterms:title xml:lang="en">Dewey Decimal Classification proxies</dcterms:title>
        <dcterms:description xml:lang="en">Local proxy resources for the Dewey Decimal Classification classes that the Discipline vocabulary maps to. They are not TRIPLE disciplines: they are concepts of an external classification, minted locally because OCLC withdrew dewey.info and no dereferenceable DDC IRI exists.</dcterms:description>
        <dcterms:abstract xml:lang="en">Proxy concepts for the DDC classes referenced by the Discipline vocabulary.</dcterms:abstract>
        <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
        <dcterms:contributor>Luca De Santis</dcterms:contributor>
        <dcterms:contributor>Silvio Peroni</dcterms:contributor>
        <owl:versionInfo>3.0.0</owl:versionInfo>
        <vann:preferredNamespacePrefix>ddc</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://gotriple.eu/ontology/triple/ddc/</vann:preferredNamespaceUri>
        <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-01</dcterms:created>
        <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-10</dcterms:modified>
        <rdfs:label xml:lang="en">Dewey Decimal Classification</rdfs:label>
        <rdfs:comment xml:lang="en">Local proxies for Dewey Decimal Classification classes, used as mapping targets by the Discipline vocabulary. OCLC withdrew dewey.info and no dereferenceable DDC IRI exists, so TRIPLE mints its own. Notations are those of the source vocabulary: some are truncated (78 for 780) and need review against the classification itself.</rdfs:comment>
      </owl:Ontology>
    </rdfs:isDefinedBy>
    <skos:notation>304</skos:notation>
    <skos:prefLabel xml:lang="en">Factors affecting social behavior</skos:prefLabel>
  </owl:NamedIndividual>

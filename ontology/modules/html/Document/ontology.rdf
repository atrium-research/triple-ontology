<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:datacite="http://purl.org/spar/datacite/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:oa="http://www.w3.org/ns/oa#"
  xmlns:schema="https://schema.org/"
>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#motivatedBy">
    <rdfs:label xml:lang="en">oa:motivatedBy</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#tagging">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">oa:tagging</rdfs:label>
    <rdfs:comment xml:lang="en">The motivation for when the user intends to associate a tag with the Target; used for GoTriple keyword assignments.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://schema.org/sameAs">
    <rdfs:label xml:lang="en">schema:sameAs</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity).</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/issn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:issn</rdfs:label>
  </datacite:IdentifierScheme>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#classifying">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">oa:classifying</rdfs:label>
    <rdfs:comment xml:lang="en">The motivation for when the user intends to classify the Target as something; used for GoTriple discipline assignments.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasBody">
    <rdfs:label xml:lang="en">oa:hasBody</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasTarget">
    <rdfs:label xml:lang="en">oa:hasTarget</rdfs:label>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/isbn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:isbn</rdfs:label>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/doi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:doi</rdfs:label>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/confidence">
    <rdfs:label xml:lang="en">confidence</rdfs:label>
    <rdfs:comment xml:lang="en">The trust score of an automatic enrichment, between 0 and 1, as produced by the GoTriple pipeline (SKG-IF 'trust').</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalDatePublished">
    <rdfs:label xml:lang="en">original date published</rdfs:label>
    <rdfs:comment xml:lang="en">The publication date string exactly as received from the source provider, in whatever format the provider used (e.g. '03/05/2021', 'May 2021'), before conversion to ISO 8601. The normalized value is expressed via schema:datePublished.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/date">
        <rdfs:label xml:lang="en">dc:date</rdfs:label>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/inCluster">
    <rdfs:label xml:lang="en">in cluster</rdfs:label>
    <rdfs:comment xml:lang="en">Associates a document with its cluster (for deduplication purposes).</rdfs:comment>
    <rdfs:domain rdf:resource="https://gotriple.eu/ontology/triple/Document"/>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/Cluster"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="en">Document (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Document</rdfs:label>
    <rdfs:label xml:lang="pl">Dokument</rdfs:label>
    <rdfs:label xml:lang="pt">Documento</rdfs:label>
    <dcterms:abstract xml:lang="en">The Document module of the TRIPLE Ontology, defining the core Document class and shared definitions.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Document module serves as the core of the TRIPLE Ontology. It defines the `triple:Document` class, representing scholarly publications and research outputs. Crucially, it also acts as the central hub for shared definitions used across the entire ontology, including Identifiers (DataCite), Licenses, Disciplines, and common schema.org properties.</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Document</dcterms:title>
    <rdfs:comment xml:lang="en">A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb1">
        <owl:onProperty rdf:resource="https://schema.org/mentions"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb2">
        <owl:allValuesFrom>
          <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb3">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </owl:allValuesFrom>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/aggregator"/>
      </owl:Restriction>
    </rdfs:subClassOf>

        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
        <owl:onProperty rdf:resource="http://purl.org/cerif/frapo/isOutputOf"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>

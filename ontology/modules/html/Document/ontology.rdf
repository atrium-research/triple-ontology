    <owl:versionInfo>3.0.0</owl:versionInfo>
    <skos:exactMatch rdf:resource="http://purl.org/spar/fabio/ScholarlyWork"/>
    <skos:exactMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
    <skos:exactMatch rdf:resource="https://sshoc.eu/ontology/SHE8_Publication"/>
    <schema:creativeWorkStatus>Ontology Module</schema:creativeWorkStatus>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalSource">
    <rdfs:label xml:lang="en">original source</rdfs:label>
    <rdfs:comment xml:lang="en">The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/source">
        <rdfs:label xml:lang="en">dc:source</rdfs:label>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalType">
    <rdfs:label xml:lang="en">original type</rdfs:label>
    <rdfs:comment xml:lang="en">The resource type exactly as received from the source provider, before normalization to the Content Type controlled vocabulary (e.g. 'journalArticle'). The normalized value is expressed via triple:hasContentType.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/type">
        <rdfs:label xml:lang="en">dc:type</rdfs:label>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/abstract">
    <rdfs:label xml:lang="en">schema:abstract</rdfs:label>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb60">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isOutputOf">
    <rdfs:label xml:lang="en">frapo:isOutputOf</rdfs:label>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLicense">
    <rdfs:label xml:lang="en">original license</rdfs:label>
    <rdfs:comment xml:lang="en">The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/rights">
        <rdfs:label xml:lang="en">dc:rights</rdfs:label>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/AccessCondition">
    <rdfs:label xml:lang="en">Access Condition</rdfs:label>
    <rdfs:comment xml:lang="en">The access condition of a resource — how and to whom it is available — drawn from the Access Condition controlled vocabulary and aligned with COAR access rights.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/detectedLanguage">
    <rdfs:label xml:lang="en">detected language</rdfs:label>
    <rdfs:comment xml:lang="en">The language tag identified by the GoTriple language-detection service for the resource's text, which may differ from the language declared by the provider (triple:originalLanguage) and from the normalized language (schema:inLanguage).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdfs:label xml:lang="en">foaf:Organization</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/dateModified">
    <rdfs:label xml:lang="en">schema:dateModified</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Cluster">
    <rdfs:label xml:lang="en">Cluster</rdfs:label>
    <rdfs:comment xml:lang="en">A cluster groups multiple documents from different sources that represent the same scholarly work. Used for deduplication. A cluster is computed by GoTriple, so it carries only its internal identifier: it has no source system it was harvested from.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E31_Document">
    <rdfs:label xml:lang="en">E31 Document</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/datePublished">
    <rdfs:label xml:lang="en">schema:datePublished</rdfs:label>
    <rdfs:comment xml:lang="en">Date of first publication or broadcast. In GoTriple it is normalized to ISO 8601 (yyyy-mm-dd).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/mentions">
    <rdfs:label xml:lang="en">mentions</rdfs:label>
    <rdfs:label xml:lang="en">schema:mentions</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasContentType">
    <rdfs:label xml:lang="en">has content type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its content type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/2002/07/owl#Thing">
    <rdfs:label xml:lang="en">schema:Thing</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/License">
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:comment xml:lang="en">The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://schema.org/headline">
    <rdfs:label xml:lang="en">schema:headline</rdfs:label>
    <rdfs:range>
      <rdfs:Datatype rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb69">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
          <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
        </owl:unionOf>
      </rdfs:Datatype>
    </rdfs:range>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Project">
    <rdfs:label xml:lang="en">Project</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://www.w3.org/ns/oa#Motivation">
    <rdfs:label xml:lang="en">oa:Motivation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/DefinedTerm">
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalLanguage">
    <rdfs:label xml:lang="en">original language</rdfs:label>
    <rdfs:comment xml:lang="en">The language value exactly as received from the source provider, before normalization to a schema:Language entity (e.g. 'eng', 'English', 'fr-FR'). The normalized value is expressed via schema:inLanguage.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf>
      <owl:DatatypeProperty rdf:about="http://purl.org/dc/elements/1.1/language">
        <rdfs:label xml:lang="en">dc:language</rdfs:label>
      </owl:DatatypeProperty>
    </rdfs:subPropertyOf>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/aggregator">
    <rdfs:label xml:lang="en">aggregator</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregator that collates resources from different sources</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb57">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/publisher">
    <rdfs:label xml:lang="en">schema:publisher</rdfs:label>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb75">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/author">
    <rdfs:label xml:lang="en">schema:author</rdfs:label>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb63">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/contributor">
    <rdfs:label xml:lang="en">schema:contributor</rdfs:label>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb66">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/ContentType">
    <rdfs:label xml:lang="en">Content Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/contactPoint">
    <rdfs:label xml:lang="en">schema:contactPoint</rdfs:label>
    <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/encodingFormat">
    <rdfs:label xml:lang="en">schema:encodingFormat</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/machineTranslatedLanguage">
    <rdfs:label xml:lang="en">machine translated language</rdfs:label>
    <rdfs:comment xml:lang="en">A language tag whose title and abstract versions were produced by the GoTriple machine-translation service. Title/abstract literals carrying this language tag are machine translations; the remaining language versions are as provided by the source.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Document">
    <rdfs:label xml:lang="en">foaf:Document</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/spatialCoverage">
    <rdfs:label xml:lang="en">schema:spatialCoverage</rdfs:label>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasAccessCondition">
    <rdfs:label xml:lang="en">has access condition</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its access condition.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/AccessCondition"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/accessRights"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/originalConditionsOfAccess">
    <rdfs:label xml:lang="en">original conditions of access</rdfs:label>
    <rdfs:comment xml:lang="en">The access rights statement exactly as received from the source provider (e.g. 'info:eu-repo/semantics/openAccess'), before normalization to the Access Condition controlled vocabulary. The normalized value is expressed via triple:hasAccessCondition.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdfs:label xml:lang="en">foaf:Person</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/hasLicense">
    <rdfs:label xml:lang="en">has license</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its licence.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/License"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/license"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/about">
    <rdfs:label xml:lang="en">schema:about</rdfs:label>
    <rdfs:comment xml:lang="en">The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://schema.org/temporalCoverage">
    <rdfs:label xml:lang="en">schema:temporalCoverage</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="http://purl.org/spar/datacite/IdentifierScheme">
    <rdfs:label xml:lang="en">datacite:IdentifierScheme</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/Place">
    <rdfs:label xml:lang="en">Place</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/ns/oa#Annotation">
    <rdfs:label xml:lang="en">Annotation</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://sshoc.eu/ontology/SHE8_Publication">
    <rdfs:label xml:lang="en">SHE8 Publication</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </owl:Class>
  <owl:Class rdf:about="http://purl.org/spar/fabio/ScholarlyWork">
    <rdfs:label xml:lang="en">fabio:ScholarlyWork</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/inLanguage">
    <rdfs:label xml:lang="en">schema:inLanguage</rdfs:label>
    <rdfs:range rdf:resource="https://schema.org/Language"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="http://purl.org/spar/datacite/Identifier">
    <rdfs:label xml:lang="en">datacite:Identifier</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="https://schema.org/ContactPoint">
    <rdfs:label xml:lang="en">schema:ContactPoint</rdfs:label>
  </owl:Class>
  <owl:Class rdf:about="http://www.w3.org/2004/02/skos/core#Concept">
    <rdfs:label xml:lang="en">Concept</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/provider">
    <rdfs:label xml:lang="en">schema:provider</rdfs:label>
    <rdfs:range>
      <rdf:Description rdf:nodeID="n1e56180e161e4cf99a8a9da6dd3d652cb72">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://schema.org/CreativeWork">
    <rdfs:label xml:lang="en">schema:CreativeWork</rdfs:label>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://schema.org/keywords">
    <rdfs:label xml:lang="en">schema:keywords</rdfs:label>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/source"/>
  <owl:Class rdf:about="https://schema.org/Language">
    <rdfs:label xml:lang="en">schema:Language</rdfs:label>
  </owl:Class>
</rdf:RDF>

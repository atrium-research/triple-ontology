<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:oa="http://www.w3.org/ns/oa#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:schema="https://schema.org/"
  xmlns:datacite="http://purl.org/spar/datacite/"
>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/confidence">
    <rdfs:label xml:lang="en">confidence</rdfs:label>
    <rdfs:comment xml:lang="en">The trust score of an automatic enrichment, between 0 and 1, as produced by the GoTriple pipeline (SKG-IF 'trust').</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#motivatedBy">
    <rdfs:label xml:lang="en">motivatedBy</rdfs:label>
    <rdfs:label xml:lang="en">oa:motivatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The reason why the Annotation was created; oa:classifying for discipline assignments, oa:tagging for keyword assignments.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/full_text_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Full Text URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL providing direct access to the full content of the document.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#tagging">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">oa:tagging</rdfs:label>
    <rdfs:comment xml:lang="en">The motivation for when the user intends to associate a tag with the Target; used for GoTriple keyword assignments.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/landing_page_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Landing Page URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the landing page containing metadata and descriptive information about the document.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
    <rdfs:comment xml:lang="en">Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="https://schema.org/sameAs">
    <rdfs:label xml:lang="en">schema:sameAs</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity).</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/issn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:issn</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Serial Number - the identifier of a serial publication, standardised as ISO 3297.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:DatatypeProperty rdf:about="http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue">
    <rdfs:label xml:lang="en">litre:hasLiteralValue</rdfs:label>
    <rdfs:comment xml:lang="en">Associates an entity with a literal value representing its textual content.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasTarget">
    <rdfs:label xml:lang="en">hasTarget</rdfs:label>
    <rdfs:label xml:lang="en">oa:hasTarget</rdfs:label>
    <rdfs:comment xml:lang="en">The relationship between an Annotation and its Target.</rdfs:comment>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/source_url_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Source URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the original publication location or source repository.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:NamedIndividual rdf:about="http://www.w3.org/ns/oa#classifying">
    <rdf:type rdf:resource="http://www.w3.org/ns/oa#Motivation"/>
    <rdfs:label xml:lang="en">oa:classifying</rdfs:label>
    <rdfs:comment xml:lang="en">The motivation for when the user intends to classify the Target as something; used for GoTriple discipline assignments.</rdfs:comment>
  </owl:NamedIndividual>
  <datacite:IdentifierScheme rdf:about="https://gotriple.eu/ontology/triple/original_id_schema">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Original Identifier</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number).</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </owl:ObjectProperty>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/doi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:doi</rdfs:label>
    <rdfs:comment xml:lang="en">Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
    <rdfs:comment xml:lang="en">Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints.</rdfs:comment>
  </datacite:IdentifierScheme>
  <datacite:IdentifierScheme rdf:about="http://purl.org/spar/datacite/isbn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:isbn</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Book Number - a numeric identifier for books and book-like products.</rdfs:comment>
  </datacite:IdentifierScheme>
  <owl:ObjectProperty rdf:about="http://www.w3.org/ns/oa#hasBody">
    <rdfs:label xml:lang="en">hasBody</rdfs:label>
    <rdfs:label xml:lang="en">oa:hasBody</rdfs:label>
    <rdfs:comment xml:lang="en">The object of the Annotation: for enrichment annotations, the concept or term assigned to the target.</rdfs:comment>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://gotriple.eu/ontology/triple/machineTranslatedLanguage">
    <rdfs:label xml:lang="en">machine translated language</rdfs:label>
    <rdfs:comment xml:lang="en">A language tag whose title and abstract versions were produced by the GoTriple machine-translation service. Title/abstract literals carrying this language tag are machine translations; the remaining language versions are as provided by the source.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://schema.org/spatialCoverage">
    <rdfs:label>schema:spatialCoverage</rdfs:label>
    <rdfs:label xml:lang="en">schema:spatialCoverage</rdfs:label>
    <rdfs:comment xml:lang="en">The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/Place"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://gotriple.eu/ontology/triple/aggregator">
    <rdfs:label xml:lang="en">aggregator</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregator that collates resources from different sources</rdfs:comment>
    <rdfs:range>
      <rdf:Description rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb57">
        <owl:unionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
          <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
        </owl:unionOf>
      </rdf:Description>
    </rdfs:range>
    <rdfs:subPropertyOf>
      <owl:ObjectProperty rdf:about="https://schema.org/contributor">
        <rdfs:label xml:lang="en">schema:contributor</rdfs:label>
        <rdfs:comment xml:lang="en">A secondary contributor to the CreativeWork or Event.</rdfs:comment>
        <rdfs:range>
          <rdf:Description rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb93">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </rdfs:range>
        <rdfs:range>
          <rdf:Description rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb96">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person"/>
              <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization"/>
            </owl:unionOf>
          </rdf:Description>
        </rdfs:range>
      </owl:ObjectProperty>
    </rdfs:subPropertyOf>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://gotriple.eu/ontology/triple/Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="en">Document (Triple)</rdfs:label>
    <rdfs:label xml:lang="fr">Document</rdfs:label>
    <rdfs:label xml:lang="pl">Dokument</rdfs:label>
    <rdfs:label xml:lang="pt">Documento</rdfs:label>
    <dcterms:abstract xml:lang="en">The Document module of the TRIPLE Ontology, defining the core Document class and shared definitions.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created>2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">The Document module serves as the core of the TRIPLE Ontology. It defines the `triple:Document` class, representing scholarly publications and research outputs. Crucially, it also acts as the central hub for shared definitions used across the entire ontology, including Identifiers (DataCite), Licenses, Disciplines, and common schema.org properties.</dcterms:description>
    <dcterms:modified>2026-08-10</dcterms:modified>
    <dcterms:title xml:lang="en">Document</dcterms:title>
    <rdfs:comment xml:lang="en">A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme.</rdfs:comment>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb1">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Discipline"/>
        <owl:onProperty rdf:resource="http://rdfs.org/sioc/ns#topic"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb2">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/License"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasLicense"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb3">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/AccessCondition"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasAccessCondition"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb4">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasContentType"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb5">
        <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Project"/>
        <owl:onProperty rdf:resource="http://purl.org/cerif/frapo/isOutputOf"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb6">
        <owl:onClass rdf:resource="https://gotriple.eu/ontology/triple/Cluster"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/inCluster"/>
        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb7">
        <owl:onProperty rdf:resource="https://schema.org/keywords"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb8">
        <owl:onProperty rdf:resource="https://schema.org/spatialCoverage"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Place"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb9">
        <owl:onProperty rdf:resource="https://schema.org/temporalCoverage"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb10">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalType"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb11">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalLanguage"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb12">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalDatePublished"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb13">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalLicense"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb14">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalConditionsOfAccess"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb15">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalSource"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb16">
        <owl:onProperty rdf:resource="http://purl.org/dc/terms/source"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb17">
        <owl:onProperty rdf:resource="https://schema.org/encodingFormat"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb18">
        <owl:onProperty rdf:resource="http://rdfs.org/sioc/ns#topic"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb19">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/datePublished"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb20">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/datePublished"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb21">
        <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb22">
        <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
        <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb23">
        <owl:onProperty rdf:resource="https://schema.org/inLanguage"/>
        <owl:someValuesFrom rdf:resource="https://schema.org/Language"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb24">
        <owl:onProperty rdf:resource="https://schema.org/headline"/>
        <owl:someValuesFrom>
          <rdfs:Datatype rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb25">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
              <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:unionOf>
          </rdfs:Datatype>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb28">
        <owl:onProperty rdf:resource="https://schema.org/abstract"/>
        <owl:someValuesFrom>
          <rdfs:Datatype rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb29">
            <owl:unionOf rdf:parseType="Collection">
              <rdf:Description rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
              <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:unionOf>
          </rdfs:Datatype>
        </owl:someValuesFrom>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>
      <owl:Restriction rdf:nodeID="nda1a51fb916449cc838f013c11d4a77fb32">
        <owl:onProperty rdf:resource="https://schema.org/mentions"/>
        <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/oa#Annotation"/>
      </owl:Restriction>
    </rdfs:subClassOf>
    <rdfs:subClassOf>

# Hand-written part of the MediaObject module: its own descriptive metadata, plus the
# terms it must carry that the projection does not reach (see scripts/build_modules.py).
# Version and modification date come from ontology/metadata.ttl.

@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix tbuild: <https://gotriple.eu/ontology/triple/build#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

triple:MediaObject dcterms:abstract "The Media Object module of the TRIPLE Ontology, defining Audio, Video, and Image resources."@en ;
    dcterms:contributor "Luca De Santis",
        "Silvio Peroni" ;
    dcterms:created "2021-12-01" ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:description "The Media Object module manages multimedia resources within the platform. It defines the `triple:MediaObject` class for audio, video, and image content, providing properties to describe their technical characteristics (duration, size, encoding format) and intellectual content, aligned with `schema:MediaObject` and `fabio:Work`."@en ;
    dcterms:title "Media Object"@en ;
    tbuild:includes dc:date,
        dc:language,
        dc:rights,
        dc:source,
        dc:type,
        datacite:Identifier,
        datacite:IdentifierScheme,
        datacite:doi,
        datacite:handle,
        <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>,
        foaf:Organization,
        schema:Thing,
        schema:name ;
    schema:creativeWorkStatus "Ontology Module" .


@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix litre: <http://purl.org/spar/literal/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://gotriple.eu/ontology/triple/Profile> a owl:Ontology ;
    rdfs:label "Profile"@en ;
    dcterms:title "Profile"@en ;
    dcterms:abstract "The Profile module of the TRIPLE Ontology, defining Agents (People, Organizations) and Accounts."@en ;
    dcterms:description "The Profile module models the actors within the GoTriple ecosystem. It defines `triple:Profile` for describing researchers and organizations, aligning them with `foaf:Person` and `foaf:Organization`. It also manages User Accounts (`foaf:OnlineAccount`) and their association with profiles to handle platform access and identity. Since iteration 19 the profile also carries personal names, self-description, pronouns, photo, personal web pages, disciplines of interest, thesaurus keywords, known languages, affiliation, registration and collaboration flags, the date of the last GoTriple update, and several identifiers kept apart by their scheme: the internal Elasticsearch id (`triple:ID`), the persistent identifier minted by GoTriple (`triple:PID`), the OPERAS/GoTriple id and the external person PIDs (ORCID, IdRef, ISNI, ResearcherID)."@en ;
    dcterms:created "2021-12-01" ;
    dcterms:modified "2026-07-27" ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:contributor "Luca De Santis", "Silvio Peroni" ;
    owl:versionInfo "2.2.0" ;
    schema:creativeWorkStatus "Ontology Module" .

triple:Profile a owl:Class ;
    rdfs:label "profile"@en,
        "Perfil"@pt,
        "Profil"@pl,
        "Profil"@fr ;
    rdfs:comment "A profile representing either a person or an organization in the GoTriple system. Can be associated or not associated with a user account."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass datacite:Identifier ;
            owl:onProperty datacite:hasIdentifier ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass foaf:OnlineAccount ;
            owl:onProperty foaf:account ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:givenName ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:givenName ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty foaf:familyName ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty foaf:familyName ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:unionOf ( rdf:langString xsd:string ) ] ;
            owl:onProperty schema:description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty triple:pronouns ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:pronouns ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:image ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:image ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:URL ;
            owl:onProperty schema:url ],
        [ a owl:Restriction ;
            owl:allValuesFrom triple:Discipline ;
            owl:onProperty foaf:topic_interest ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:DefinedTerm ;
            owl:onProperty schema:knowsAbout ],
        [ a owl:Restriction ;
            owl:allValuesFrom schema:Language ;
            owl:onProperty schema:knowsLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom foaf:Organization ;
            owl:onProperty schema:affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty triple:registeredUser ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:registeredUser ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty triple:openToCollaboration ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty triple:openToCollaboration ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty schema:dateModified ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty schema:dateModified ],
        [ owl:unionOf ( foaf:Person foaf:Organization ) ] ;
    skos:exactMatch foaf:Agent .

foaf:Agent a owl:Class ;
    rdfs:label "foaf:Agent"@en ;
    rdfs:comment "An agent (person or organization)."@en .

foaf:Person a owl:Class ;
    rdfs:label "foaf:Person"@en ;
    rdfs:comment "A person."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:Thing ;
    owl:equivalentClass schema:Person .

foaf:Organization a owl:Class ;
    rdfs:label "foaf:Organization"@en ;
    rdfs:comment "An organization."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onDataRange xsd:string ;
            owl:onProperty schema:name ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        schema:Thing .

schema:Person a owl:Class ;
    rdfs:label "Person"@en .

schema:Thing a owl:Class ;
    rdfs:label "schema:Thing"@en .

foaf:OnlineAccount a owl:Class ;
    rdfs:label "foaf:OnlineAccount"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass datacite:Identifier ;
            owl:onProperty datacite:hasIdentifier ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

triple:Discipline a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Discipline"@en .

skos:Concept a owl:Class ;
    rdfs:label "skos:Concept"@en .

schema:DefinedTerm a owl:Class ;
    rdfs:label "schema:DefinedTerm"@en ;
    rdfs:comment "A word, name, acronym or phrase defined in a controlled vocabulary. Used for structured thesaurus keywords."@en .

schema:Language a owl:Class ;
    rdfs:label "schema:Language"@en .

schema:URL a owl:Class ;
    rdfs:label "schema:URL"@en .

# Object properties
foaf:account a owl:ObjectProperty ;
    rdfs:label "foaf:account"@en ;
    rdfs:comment "Indicates an account held by this agent"@en .

foaf:topic_interest a owl:ObjectProperty ;
    rdfs:label "foaf:topic_interest"@en ;
    rdfs:comment "A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications."@en .

schema:knowsAbout a owl:ObjectProperty ;
    rdfs:label "schema:knowsAbout"@en ;
    rdfs:comment "A topic the agent knows about. Natively declared by Schema.org for Person and Organization; used in GoTriple to link a profile to structured thesaurus keywords."@en .

schema:knowsLanguage a owl:ObjectProperty ;
    rdfs:label "schema:knowsLanguage"@en ;
    rdfs:comment "A language the agent knows."@en .

schema:affiliation a owl:ObjectProperty ;
    rdfs:label "schema:affiliation"@en ;
    rdfs:comment "An organization the agent is affiliated with. Used in GoTriple for the current organization specified by the user in the Experience tab."@en .

schema:image a owl:ObjectProperty ;
    rdfs:label "schema:image"@en ;
    rdfs:comment "An image of the entity. Used in GoTriple for the URL of the personal picture chosen by the user."@en .

schema:url a owl:ObjectProperty ;
    rdfs:label "schema:url"@en ;
    rdfs:comment "The URL of the entity. Used in GoTriple for the personal web pages of the profile."@en .

# Data properties
schema:name a owl:DatatypeProperty ;
    rdfs:label "name"@en ;
    rdfs:range xsd:string .

foaf:givenName a owl:DatatypeProperty ;
    rdfs:label "foaf:givenName"@en ;
    rdfs:comment "The given name (first name) of a person."@en .

foaf:familyName a owl:DatatypeProperty ;
    rdfs:label "foaf:familyName"@en ;
    rdfs:comment "The family name (last name) of a person."@en .

schema:description a owl:DatatypeProperty ;
    rdfs:label "schema:description"@en ;
    rdfs:comment "A description of the entity. Used in GoTriple for the self-description of the profile."@en .

schema:dateModified a owl:DatatypeProperty ;
    rdfs:label "schema:dateModified"@en ;
    rdfs:comment "The date on which the entity was most recently modified. Used on profiles for the last GoTriple update."@en .

triple:pronouns a owl:DatatypeProperty ;
    rdfs:label "pronouns"@en ;
    rdfs:comment "The personal pronouns chosen by the user for their GoTriple profile (e.g. \"she/her\")."@en ;
    rdfs:range xsd:string .

triple:registeredUser a owl:DatatypeProperty ;
    rdfs:label "registered user"@en ;
    rdfs:comment "Whether the profile belongs to a registered GoTriple user (true) or was automatically created for an author extracted from harvested document metadata (false)."@en ;
    rdfs:range xsd:boolean .

triple:openToCollaboration a owl:DatatypeProperty ;
    rdfs:label "open to collaboration"@en ;
    rdfs:comment "Whether the registered user declared to be open to collaboration with other GoTriple users."@en ;
    rdfs:range xsd:boolean .

# Identifiers used in Profile (internal id and person PIDs)
datacite:Identifier a owl:Class ;
    rdfs:label "datacite:Identifier"@en .

triple:ID a owl:Class ;
    rdfs:label "Internal ID"@en ;
    rdfs:comment "Internal identifier used within the GoTriple platform for resource management. On profiles it carries the Elasticsearch id."@en ;
    rdfs:subClassOf datacite:Identifier .

triple:PID a owl:Class ;
    rdfs:label "Persistent ID"@en ;
    rdfs:comment "Persistent identifier generated and exposed externally by the GoTriple platform. On profiles it carries the pid field, distinct from the OPERAS/GoTriple id."@en ;
    rdfs:subClassOf datacite:Identifier .

datacite:hasIdentifier a owl:ObjectProperty ;
    rdfs:label "datacite:hasIdentifier"@en ;
    rdfs:range datacite:Identifier .

datacite:usesIdentifierScheme a owl:ObjectProperty ;
    rdfs:label "datacite:usesIdentifierScheme"@en .

datacite:IdentifierScheme a owl:Class ;
    rdfs:label "datacite:IdentifierScheme"@en .

litre:hasLiteralValue a owl:DatatypeProperty ;
    rdfs:label "litre:hasLiteralValue"@en ;
    rdfs:range xsd:string .

# Person identifier schemes
datacite:orcid a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "datacite:orcid"@en ;
    rdfs:comment "Open Researcher and Contributor ID - a persistent identifier for researchers, maintained by ORCID Inc."@en .

datacite:isni a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "datacite:isni"@en ;
    rdfs:comment "International Standard Name Identifier - an ISO standard identifier for the public identities of contributors to media content."@en .

datacite:researcherid a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "datacite:researcherid"@en ;
    rdfs:comment "ResearcherID - an identifier system for scientific authors, owned by Clarivate (formerly Thomson Reuters)."@en .

datacite:local-resource-identifier-scheme a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "datacite:local-resource-identifier-scheme"@en ;
    rdfs:comment "Local resource identifier scheme, used for the internal Elasticsearch id of the profile."@en .

triple:idref_schema a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "IdRef"@en ;
    rdfs:comment "IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it."@en .

triple:gotriple_id_schema a owl:NamedIndividual,
        datacite:IdentifierScheme ;
    rdfs:label "GoTriple ID"@en ;
    rdfs:comment "The OPERAS/GoTriple identifier assigned to a profile (the goTripleId field)."@en .

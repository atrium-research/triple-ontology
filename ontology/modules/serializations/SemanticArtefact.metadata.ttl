# Hand-written part of the SemanticArtefact module: its own descriptive metadata, plus the
# terms it must carry that the projection does not reach (see scripts/build_modules.py).
# Version and modification date come from ontology/metadata.ttl.

@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix tbuild: <https://gotriple.eu/ontology/triple/build#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

triple:SemanticArtefact dcterms:abstract "The Semantic Artefact module of the TRIPLE Ontology, defining Ontologies, Vocabularies, and Thesauri."@en ;
    dcterms:contributor "Luca De Santis",
        "Silvio Peroni" ;
    dcterms:created "2021-12-01" ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:description "The Semantic Artefact module is dedicated to describing the semantic assets used or indexed by the GoTriple platform, such as ontologies, taxonomies, and thesauri. It extends the MOD (Metadata for Ontology Description) ontology to provide rich metadata about these knowledge organization systems, including their versioning, format, and status."@en ;
    dcterms:title "Semantic Artefact"@en ;
    tbuild:includes dc:date,
        dc:language,
        dc:rights,
        dc:source,
        dc:type,
        datacite:Identifier,
        datacite:IdentifierScheme,
        datacite:doi,
        datacite:handle,
        datacite:uri,
        <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>,
        foaf:Organization,
        schema:name ;
    schema:creativeWorkStatus "Ontology Module" .


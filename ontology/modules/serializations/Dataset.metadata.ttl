# Hand-written part of the Dataset module: its own descriptive metadata, plus the
# terms it must carry that the projection does not reach (see scripts/build_modules.py).
# Version and modification date come from ontology/metadata.ttl.

@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix tbuild: <https://gotriple.eu/ontology/triple/build#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

triple:Dataset dcterms:abstract "The Dataset module of the TRIPLE Ontology, defining Datasets and Distributions aligned with DCAT."@en ;
    dcterms:contributor "Luca De Santis",
        "Silvio Peroni" ;
    dcterms:created "2021-12-01" ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:description "The Dataset module specializes in representing research data. It defines `triple:Dataset` as a connection point to the DCAT ontology, supporting the description of datasets, their distributions, temporal/spatial coverage, and access rights. This facilitates the discovery and reuse of research data within the SSH domain."@en ;
    dcterms:title "Dataset"@en ;
    tbuild:includes dc:date,
        dc:language,
        dc:rights,
        dc:type,
        datacite:Identifier,
        datacite:IdentifierScheme,
        datacite:doi,
        datacite:handle,
        <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>,
        foaf:Organization,
        schema:Thing,
        schema:name ;
    schema:creativeWorkStatus "Ontology Module" .


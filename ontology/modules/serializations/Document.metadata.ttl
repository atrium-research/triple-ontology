# Hand-written part of the Document module: its own descriptive metadata, plus the
# terms it must carry that the projection does not reach (see scripts/build_modules.py).
# Version and modification date come from ontology/metadata.ttl.

@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix schema: <https://schema.org/> .
@prefix tbuild: <https://gotriple.eu/ontology/triple/build#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

triple:Document dcterms:abstract "The Document module of the TRIPLE Ontology, defining the core Document class and shared definitions."@en ;
    dcterms:contributor "Luca De Santis",
        "Silvio Peroni" ;
    dcterms:created "2021-12-01" ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:description "The Document module serves as the core of the TRIPLE Ontology. It defines the `triple:Document` class, representing scholarly publications and research outputs. Crucially, it also acts as the central hub for shared definitions used across the entire ontology, including Identifiers (DataCite), Licenses, Disciplines, and common schema.org properties."@en ;
    dcterms:title "Document"@en ;
    tbuild:includes dc:date,
        dc:language,
        dc:rights,
        dc:source,
        dc:type,
        datacite:Identifier,
        datacite:IdentifierScheme,
        <http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue>,
        oa:Motivation,
        oa:classifying,
        oa:hasBody,
        oa:hasTarget,
        oa:motivatedBy,
        oa:tagging,
        foaf:Organization,
        triple:confidence,
        schema:sameAs ;
    schema:creativeWorkStatus "Ontology Module" .


@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

# Identifier Pattern
# Every identifier in the TRIPLE ontology is attached through datacite:hasIdentifier
# and is a datacite:Identifier. There is no other way of identifying an entity:
# schema:identifier strings are never used.

datacite:hasIdentifier rdf:type owl:ObjectProperty ;
                       rdfs:label "datacite:hasIdentifier"@en ;
                       rdfs:comment "Links an entity to one of its identifiers."@en ;
                       rdfs:range datacite:Identifier .

datacite:usesIdentifierScheme rdf:type owl:ObjectProperty ;
                              rdfs:label "datacite:usesIdentifierScheme"@en ;
                              rdfs:comment "Links an identifier to the scheme it belongs to."@en ;
                              rdfs:range datacite:IdentifierScheme .

datacite:Identifier rdf:type owl:Class ;
                    rdfs:label "datacite:Identifier"@en ;
                    rdfs:comment "An identifier that uniquely identifies an entity according to some identification scheme. Carries exactly one scheme and exactly one literal value."@en .

# ---------------------------------------------------------------------------
# The scheme is what tells one kind of identifier from another
# ---------------------------------------------------------------------------
# datacite:Identifier requires exactly one datacite:usesIdentifierScheme, so the
# scheme is always present and always sufficient to say what kind of identifier
# this is. A triple:* identifier class therefore exists ONLY when the model needs
# to name that kind inside a class-level axiom — which today means the three
# mandatory kinds. Everything else is a plain datacite:Identifier told apart by
# its scheme, and adding a new kind of identifier means adding one scheme, not a
# scheme plus a class.

# ---------------------------------------------------------------------------
# No identifier subclasses
# ---------------------------------------------------------------------------
# There are none. The kind of an identifier is its scheme, full stop — the same
# choice OpenCitations makes with this pattern. Earlier versions of this ontology
# minted triple:ID, triple:PID, triple:OriginalIdentifier, triple:DOI, Handle,
# ISBN, ISSN and URI; they were retired in 3.0.0 because a class pinned to a
# single scheme with owl:hasValue duplicates what the scheme already says, and
# because the mandatoriness they were needed to express now lives in SHACL.
#
# Adding a new kind of identifier therefore costs ONE individual — a scheme —
# and nothing else. It must be declared in the consolidated ontology, not only
# in an example dataset.

# ---------------------------------------------------------------------------
# Mandatoriness lives in shapes/, not here
# ---------------------------------------------------------------------------
# OWL restrictions describe inferences, not constraints: under open-world
# semantics a missing identifier is inferred to exist rather than reported, and
# owl:qualifiedCardinality 1 over two distinct nodes concludes they are the same
# node instead of flagging an error. Which identifiers an entity must carry is
# therefore expressed in shapes/entity.shapes.ttl, where it is verifiable:
#
#   Document, Dataset, MediaObject, SemanticArtefact, Project
#       exactly one   scheme triple:internal_id_schema
#       exactly one   scheme datacite:ark
#       at least one  scheme triple:original_id_schema
#   Profile                    the first two only — a registered user comes from
#                              no source system
#   Cluster, foaf:OnlineAccount  the internal id only — platform-created
#
# shapes/identifier.shapes.ttl additionally checks the shape of the values
# themselves (an ARK looks like ark:/NAAN/name, a DOI like 10.NNNN/suffix),
# which OWL cannot express at all.

# ---------------------------------------------------------------------------
# Identifier schemes (named individuals)
# ---------------------------------------------------------------------------
# Reused from the SPAR DataCite ontology:
#   datacite:ark, datacite:doi, datacite:handle, datacite:issn, datacite:isbn,
#   datacite:uri, datacite:orcid, datacite:isni, datacite:researcherid
# Minted in the TRIPLE namespace where DataCite has none:
#   triple:internal_id_schema     the GoTriple internal identifier
#   triple:original_id_schema     generic source-system identifier (fallback when
#                                 the source has no named scheme of its own)
#   triple:gotriple_id_schema     the OPERAS/GoTriple profile id
#   triple:idref_schema           IdRef, the French higher-education authority file
#   triple:landing_page_url_schema / triple:full_text_url_schema /
#   triple:source_url_schema      URLs, which are identifiers like any other
# Source-specific schemes are minted as needed (e.g. triple:h2020_scheme,
# triple:prin_scheme, triple:fwf_scheme for project identifiers).

triple:internal_id_schema rdf:type owl:NamedIndividual , datacite:IdentifierScheme ;
                          rdfs:label "TRIPLE Internal ID"@en .

triple:original_id_schema rdf:type owl:NamedIndividual , datacite:IdentifierScheme ;
                          rdfs:label "Original Identifier"@en .

# ---------------------------------------------------------------------------
# Example
# ---------------------------------------------------------------------------
# triple:example_document datacite:hasIdentifier
#     [ a datacite:Identifier ;
#       datacite:usesIdentifierScheme triple:internal_id_schema ;
#       litre:hasLiteralValue "TRIPLE_DOC_001" ] ,
#     [ a datacite:Identifier ;
#       datacite:usesIdentifierScheme datacite:ark ;
#       litre:hasLiteralValue "ark:/12345/doc-001" ] ,
#     [ a datacite:Identifier ;
#       datacite:usesIdentifierScheme triple:original_id_schema ;
#       litre:hasLiteralValue "hal-12345" ] ,
#     [ a datacite:Identifier ;
#       datacite:usesIdentifierScheme datacite:doi ;
#       litre:hasLiteralValue "10.4000/dh.1234" ] .
#
# Identifiers are anonymous nodes: nobody links to "the DOI node of document X",
# they link to the document, and datacite:hasIdentifier always reaches them by
# path. Note that hasIdentifier is owl:InverseFunctionalProperty in the DataCite
# ontology, so two entities sharing one identifier node are inferred to be the
# same entity — another reason not to reuse them.

# Standard Requirements:
# - Only the DataCite model: never schema:identifier, never a bare string.
#   (The ADR 005 tables say schema:identifier; where a schema.org view is needed
#   it is generated on output from these nodes, not modelled here.)
# - Exactly one scheme and exactly one litre:hasLiteralValue per identifier,
#   both required by the SPAR ontologies themselves.
# - No identifier subclasses: the scheme is the kind.
# - URLs (landing page, full text, source) are identifiers with their own schemes.
# - Conformance is checked with shapes/, not with OWL axioms.

@prefix ct: <https://gotriple.eu/ontology/content-type/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

<https://gotriple.eu/ontology/content-type> a owl:Ontology ;
    dcterms:title "Content Type"@en ;
    dcterms:description "The Content Type vocabulary categorizes the different types of resources available in the TRIPLE platform, such as journal articles, datasets, images, and video. It includes mappings to the COAR Resource Type Vocabulary to ensure interoperability."@en ;
    dcterms:abstract "A hierarchical controlled vocabulary for classifying the nature and genre of scholarly resources."@en ;
    dcterms:creator "Alessandro Bertozzi" ;
    dcterms:contributor "Luca De Santis", "Silvio Peroni" ;
    owl:versionInfo "3.2.0" ;
    vann:preferredNamespacePrefix "ct" ;
    vann:preferredNamespaceUri "https://gotriple.eu/ontology/content-type/" ;
    dcterms:created "2021-12-01"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date .


ct:other a owl:NamedIndividual,
        triple:ContentType ;
    rdfs:label "Other"@en,
        "Autre"@fr,
        "Inne"@pl,
        "Outros"@pt ;
    rdfs:comment "A content type that does not fit into other defined categories."@en ;
    skos:definition "A content type that does not fit into other defined categories."@en ;
    skos:notation "other" ;
    skos:prefLabel "Other"@en,
        "Autre"@fr,
        "Inne"@pl,
        "Outros"@pt .

ct:typ_article a owl:NamedIndividual,
        triple:ContentType ;
    rdfs:label "Wissenschaftlicher Artikel"@de,
        "Article"@en,
        "Article"@fr,
        "articolo in rivista"@it,
        "Artykuł"@pl,
        "Artigo"@pt ;
    rdfs:comment "A scholarly work that describes research results, published in a journal or other publication series."@en ;
    skos:definition "A scholarly work that describes research results, published in a journal or other publication series."@en ;
    skos:exactMatch <https://vocabularies.coar-repositories.org/resource_types/c_6501> ;
    skos:notation "typ_article" ;
    skos:prefLabel "Wissenschaftlicher Artikel"@de,
        "Article"@en,
        "Article"@fr,
        "articolo in rivista"@it,
        "Artykuł"@pl,
        "Artigo"@pt .


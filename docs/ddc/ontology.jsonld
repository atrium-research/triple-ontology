  {
    "@id": "https://gotriple.eu/ontology/ddc",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology",
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#ConceptScheme"
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@language": "en",
        "@value": "Proxy concepts for the DDC classes referenced by the Discipline vocabulary."
      }
    ],
    "http://purl.org/dc/terms/contributor": [
      {
        "@value": "Luca De Santis"
      },
      {
        "@value": "Silvio Peroni"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2021-12-01"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Alessandro Bertozzi"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Local proxy resources for the Dewey Decimal Classification classes that the Discipline vocabulary maps to. They are not TRIPLE disciplines: they are concepts of an external classification, minted locally because OCLC withdrew dewey.info and no dereferenceable DDC IRI exists."
      }
    ],
    "http://purl.org/dc/terms/modified": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-08-27"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "Dewey Decimal Classification proxies"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "ddc"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://gotriple.eu/ontology/ddc/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Local proxies for Dewey Decimal Classification classes, used as mapping targets by the Discipline vocabulary. OCLC withdrew dewey.info and no dereferenceable DDC IRI exists, so TRIPLE mints its own. Notations are those of the source vocabulary: some are truncated (78 for 780) and need review against the classification itself."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Dewey Decimal Classification"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "3.2.0"
      }
    ]
  },

<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/other">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">Other</rdfs:label>
    <rdfs:label xml:lang="fr">Autre</rdfs:label>
    <rdfs:label xml:lang="pl">Inne</rdfs:label>
    <rdfs:label xml:lang="pt">Outros</rdfs:label>
    <rdfs:comment xml:lang="en">Other access conditions not listed in the vocabulary.</rdfs:comment>
    <skos:definition xml:lang="en">Other access conditions not listed in the vocabulary.</skos:definition>
    <skos:notation>other</skos:notation>
    <skos:prefLabel xml:lang="en">Other</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Autre</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Inne</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Outros</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_restricted-access-or-use">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="de">eingeschränkter Zugang</rdfs:label>
    <rdfs:label xml:lang="en">Restricted access or use</rdfs:label>
    <rdfs:label xml:lang="fr">Accès ou Utilisation Restreints</rdfs:label>
    <rdfs:label xml:lang="it">accesso riservato</rdfs:label>
    <rdfs:label xml:lang="pl">Ograniczony dostęp lub użycie</rdfs:label>
    <rdfs:label xml:lang="pt">Acesso ou Uso Restrito</rdfs:label>
    <rdfs:comment xml:lang="en">Access or use of the resource is restricted.</rdfs:comment>
    <skos:definition xml:lang="en">Access or use of the resource is restricted.</skos:definition>
    <skos:exactMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_16ec/"/>
    <skos:notation>acr_restricted-access-or-use</skos:notation>
    <skos:prefLabel xml:lang="de">eingeschränkter Zugang</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Restricted access or use</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Accès ou Utilisation Restreints</skos:prefLabel>
    <skos:prefLabel xml:lang="it">accesso riservato</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Ograniczony dostęp lub użycie</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Acesso ou Uso Restrito</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_all-rights-reserved">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">All Rights Reserved</rdfs:label>
    <rdfs:label xml:lang="fr">Tous Droits Réservés</rdfs:label>
    <rdfs:label xml:lang="pl">Wszelkie prawa zastrzeżone</rdfs:label>
    <rdfs:label xml:lang="pt">Todos os Direitos Reservados</rdfs:label>
    <rdfs:comment xml:lang="en">All rights are reserved by the copyright holder.</rdfs:comment>
    <skos:definition xml:lang="en">All rights are reserved by the copyright holder.</skos:definition>
    <skos:notation>acr_all-rights-reserved</skos:notation>
    <skos:prefLabel xml:lang="en">All Rights Reserved</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Tous Droits Réservés</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Wszelkie prawa zastrzeżone</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Todos os Direitos Reservados</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_metadata-only-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="de">nur Metadaten</rdfs:label>
    <rdfs:label xml:lang="en">Metadata Only Access</rdfs:label>
    <rdfs:label xml:lang="fr">accès aux seules métadonnées</rdfs:label>
    <rdfs:label xml:lang="it">accesso limitato ai metadati</rdfs:label>
    <rdfs:label xml:lang="pt">acesso a metadados</rdfs:label>
    <rdfs:comment xml:lang="en">Only the metadata of the resource is accessible.</rdfs:comment>
    <skos:definition xml:lang="en">Only the metadata of the resource is accessible.</skos:definition>
    <skos:exactMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_14cb/"/>
    <skos:notation>acr_metadata-only-access</skos:notation>
    <skos:prefLabel xml:lang="de">nur Metadaten</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Metadata Only Access</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">accès aux seules métadonnées</skos:prefLabel>
    <skos:prefLabel xml:lang="it">accesso limitato ai metadati</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">acesso a metadados</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Condition of Access</dcterms:title>
    <dcterms:description xml:lang="en">The Condition of Access vocabulary defines the access rights associated with resources in the TRIPLE platform, such as Open Access, Restricted Access, or Closed Access. It facilitates the filtering and identification of resource availability.</dcterms:description>
    <dcterms:abstract xml:lang="en">A controlled vocabulary for specifying access conditions, aligned with COAR Access Rights where applicable.</dcterms:abstract>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <owl:versionInfo>3.1.0</owl:versionInfo>
    <vann:preferredNamespacePrefix>coa</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://gotriple.eu/ontology/condition-of-access/</vann:preferredNamespaceUri>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-01</dcterms:created>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-11</dcterms:modified>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_closed-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">Closed Access</rdfs:label>
    <rdfs:label xml:lang="fr">Accès Fermé</rdfs:label>
    <rdfs:label xml:lang="pl">Zamknięty dostęp</rdfs:label>
    <rdfs:label xml:lang="pt">Acesso Fechado</rdfs:label>
    <rdfs:comment xml:lang="en">Access to the resource is closed.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_14cb/"/>
    <skos:definition xml:lang="en">Access to the resource is closed.</skos:definition>
    <skos:notation>acr_closed-access</skos:notation>
    <skos:prefLabel xml:lang="en">Closed Access</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Accès Fermé</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Zamknięty dostęp</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Acesso Fechado</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_free-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">Free Access</rdfs:label>
    <rdfs:label xml:lang="fr">Accès Libre</rdfs:label>
    <rdfs:label xml:lang="pl">Bezpłatny dostęp</rdfs:label>
    <rdfs:label xml:lang="pt">Acesso Livre</rdfs:label>
    <rdfs:comment xml:lang="en">Access to the resource is free of charge.</rdfs:comment>
    <skos:closeMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_abf2/"/>
    <skos:definition xml:lang="en">Access to the resource is free of charge.</skos:definition>
    <skos:notation>acr_free-access</skos:notation>
    <skos:prefLabel xml:lang="en">Free Access</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Accès Libre</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Bezpłatny dostęp</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Acesso Livre</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/undefined">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">Undefined</rdfs:label>
    <rdfs:label xml:lang="fr">Non Défini</rdfs:label>
    <rdfs:label xml:lang="pl">Nieokreślone</rdfs:label>
    <rdfs:label xml:lang="pt">Indefinido</rdfs:label>
    <rdfs:comment xml:lang="en">Access condition is undefined or unknown.</rdfs:comment>
    <skos:definition xml:lang="en">Access condition is undefined or unknown.</skos:definition>
    <skos:notation>undefined</skos:notation>
    <skos:prefLabel xml:lang="en">Undefined</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Non Défini</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Nieokreślone</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Indefinido</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_public-domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="en">Public Domain</rdfs:label>
    <rdfs:label xml:lang="fr">Domaine Public</rdfs:label>
    <rdfs:label xml:lang="pl">Domena publiczna</rdfs:label>
    <rdfs:label xml:lang="pt">Domínio Púlico</rdfs:label>
    <rdfs:comment xml:lang="en">The resource is in the public domain.</rdfs:comment>
    <skos:definition xml:lang="en">The resource is in the public domain.</skos:definition>
    <skos:notation>acr_public-domain</skos:notation>
    <skos:prefLabel xml:lang="en">Public Domain</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Domaine Public</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Domena publiczna</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Domínio Púlico</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_open-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="de">offener Zugang</rdfs:label>
    <rdfs:label xml:lang="en">Open Access</rdfs:label>
    <rdfs:label xml:lang="fr">Accès Ouvert</rdfs:label>
    <rdfs:label xml:lang="it">accesso aperto</rdfs:label>
    <rdfs:label xml:lang="pl">Otwarty dostęp</rdfs:label>
    <rdfs:label xml:lang="pt">Acesso Aberto</rdfs:label>
    <rdfs:comment xml:lang="en">The resource is available under an open license.</rdfs:comment>
    <skos:definition xml:lang="en">The resource is available under an open license.</skos:definition>
    <skos:exactMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_abf2/"/>
    <skos:notation>acr_open-access</skos:notation>
    <skos:prefLabel xml:lang="de">offener Zugang</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Open Access</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">Accès Ouvert</skos:prefLabel>
    <skos:prefLabel xml:lang="it">accesso aperto</skos:prefLabel>
    <skos:prefLabel xml:lang="pl">Otwarty dostęp</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">Acesso Aberto</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/condition-of-access/acr_embargoed-access">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:label xml:lang="de">Zugang unterliegt Embargo</rdfs:label>
    <rdfs:label xml:lang="en">Embargoed Access</rdfs:label>
    <rdfs:label xml:lang="fr">sous embargo</rdfs:label>
    <rdfs:label xml:lang="it">accesso sottoposto a periodo di embargo</rdfs:label>
    <rdfs:label xml:lang="pt">acesso embargado</rdfs:label>
    <rdfs:comment xml:lang="en">Access to the resource is embargoed until a specific date.</rdfs:comment>
    <skos:definition xml:lang="en">Access to the resource is embargoed until a specific date.</skos:definition>
    <skos:exactMatch rdf:resource="https://vocabularies.coar-repositories.org/access_rights/c_f1cf/"/>
    <skos:notation>acr_embargoed-access</skos:notation>
    <skos:prefLabel xml:lang="de">Zugang unterliegt Embargo</skos:prefLabel>
    <skos:prefLabel xml:lang="en">Embargoed Access</skos:prefLabel>
    <skos:prefLabel xml:lang="fr">sous embargo</skos:prefLabel>
    <skos:prefLabel xml:lang="it">accesso sottoposto a periodo di embargo</skos:prefLabel>
    <skos:prefLabel xml:lang="pt">acesso embargado</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/ConditionOfAccess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Condition of Access</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
</rdf:RDF>

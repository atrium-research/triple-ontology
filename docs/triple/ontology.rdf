  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Project</rdfs:label>
    <rdfs:label xml:lang="fr">Projet</rdfs:label>
    <rdfs:label xml:lang="pl">Projekt</rdfs:label>
    <rdfs:label xml:lang="pt">Projeto</rdfs:label>
    <rdfs:comment xml:lang="en">A research project in the Social Sciences and Humanities domain integrated into the GoTriple platform. It is a subclass of schema:Project.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb271"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb272"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb273"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb274"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb275"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb276"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb277"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb278"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb279"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb280"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb281"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb282"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb283"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb284"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb285"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb286"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb287"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb288"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb289"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb290"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Project"/>
    <skos:closeMatch rdf:resource="http://purl.org/cerif/frapo/Grant"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:closeMatch rdf:resource="https://sshoc.eu/ontology/SHE3_SSH_Project"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/project/example&gt; a triple:Project ;
    schema:name "TRIPLE"@en ;
    schema:startDate "2019-10-01"^^xsd:date ;
    schema:endDate "2023-03-31"^^xsd:date ;
    triple:hasProjectType &lt;https://gotriple.eu/ontology/project-type/funded&gt; ;
    schema:funding [ a schema:Grant ;
        schema:funder [ a schema:FundingScheme ; schema:name "H2020" ] ] .</skos:example>
    <skos:scopeNote xml:lang="en">A Project is a research undertaking as a first-class resource of the platform, not a document: it has a name and a lifecycle (schema:startDate, schema:endDate), organizing and sponsoring bodies, and a project type from the controlled vocabulary. Its funding is a chain: schema:funding points to a schema:Grant whose schema:funder is the funding scheme - a schema:FundingScheme individual carried with its display name, deliberately outside any controlled vocabulary. Documents link to the projects they result from with frapo:isOutputOf.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb65">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>

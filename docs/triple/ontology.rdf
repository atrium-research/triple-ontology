    <rdfs:label xml:lang="en">schema:startDate</rdfs:label>
    <rdfs:comment xml:lang="en">The start date and time of the item</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb112">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Distribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">dcat:Distribution</rdfs:label>
    <rdfs:comment xml:lang="en">A specific representation of a dataset: a downloadable file, an API or a feed (DCAT).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb49">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasConditionOfAccess"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb45">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
    <owl:onProperty rdf:resource="http://www.w3.org/ns/dcat#distribution"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb27">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdf:rest rdf:nodeID="nda1c118ced93403d96dc967d8210963cb28"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb103">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:onProperty rdf:resource="https://schema.org/about"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb181">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <owl:onProperty rdf:resource="https://schema.org/about"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/openToCollaboration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">open to collaboration</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the registered user declared to be open to collaboration with other GoTriple users.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb198">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/CreativeWork"/>
    <owl:onProperty rdf:resource="http://purl.org/dc/terms/isReferencedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/image">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:image</rdfs:label>
    <rdfs:comment xml:lang="en">An image of the entity. Used in GoTriple for the URL of the personal picture chosen by the user.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb77">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/Place"/>
    <owl:onProperty rdf:resource="https://schema.org/spatialCoverage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/creator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:creator</rdfs:label>
    <rdfs:comment xml:lang="en">The creator or author of this CreativeWork (Schema.org). Super-property of schema:author.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb93">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb221">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.org/dc/terms/source"/>
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb92">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb184">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasContentType"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/references">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcterms:references</rdfs:label>
    <rdfs:comment xml:lang="en">A related resource that is referenced, cited, or otherwise pointed to by the described resource. Declared inverse of dcterms:isReferencedBy (DCMI), which the model already carries on Dataset, MediaObject and SemanticArtefact: this is the active side, on the document. Not a formal bibliographic citation.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://purl.org/dc/terms/isReferencedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb117">
    <owl:unionOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb118"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb15">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="http://purl.org/dc/terms/isReferencedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/jobTitle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schema:jobTitle</rdfs:label>
    <rdfs:comment xml:lang="en">The job title of the person, as the plain string the provider supplies. Chosen over schema:hasOccupation, whose range demands a structured schema:Occupation node: when an Occupation vocabulary exists, hasOccupation will be added beside jobTitle without changing it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="nda1c118ced93403d96dc967d8210963cb3"/>
    <owl:onProperty rdf:resource="https://schema.org/publisher"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb63">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalInLanguage"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb183">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasConditionOfAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/aggregator">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">aggregator</rdfs:label>
    <rdfs:comment xml:lang="en">An aggregator that collates resources from different sources</rdfs:comment>
    <rdfs:range rdf:nodeID="nda1c118ced93403d96dc967d8210963cb210"/>
    <rdfs:subPropertyOf rdf:resource="https://schema.org/contributor"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb257">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>

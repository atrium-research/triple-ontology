<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/detectedLanguage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">detected language</rdfs:label>
    <rdfs:comment xml:lang="en">The language tag identified by the GoTriple language-detection service for the resource's text, which may differ from the language declared by the provider (triple:originalInLanguage) and from the normalized language (schema:inLanguage).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/Document">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Document</rdfs:label>
    <rdfs:label xml:lang="fr">Document</rdfs:label>
    <rdfs:label xml:lang="pl">Dokument</rdfs:label>
    <rdfs:label xml:lang="pt">Documento</rdfs:label>
    <rdfs:comment xml:lang="en">A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb213"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb214"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb215"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb216"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb217"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb218"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb219"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb220"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb221"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb222"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb223"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb224"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb225"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb226"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb227"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb228"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb229"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb233"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb237"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb238"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb239"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb240"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb241"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb242"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb243"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb244"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb245"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb246"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb247"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb248"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb249"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb253"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb257"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb261"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb262"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb266"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb270"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/ScholarlyWork"/>
    <skos:closeMatch rdf:resource="https://sshoc.eu/ontology/SHE8_Publication"/>
    <skos:exactMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/document/example&gt; a triple:Document ;
    schema:headline "De l'esthetique au present"@fr ;
    schema:datePublished "1998-01-01"^^xsd:date ;
    schema:author &lt;https://w3id.org/gto/profile/example-author&gt; ;
    schema:publisher [ a foaf:Organization ; foaf:name "De Boeck Superieur" ] ;
    datacite:hasIdentifier [ a datacite:Identifier ;
        datacite:usesIdentifierScheme triple:internal_id_schema ;
        litre:hasLiteralValue "ftopenedition:oai:books:1234" ] ;
    triple:hasContentType ct:typ_book ;
    triple:hasConditionOfAccess coa:acr_open-access .</skos:example>
    <skos:scopeNote xml:lang="en">A Document is the platform's record of ONE provider's description of a scholarly resource: two providers describing the same publication yield two documents, kept distinct and related by triple:isDuplicateOf (duplicate to representative). The descriptive core is Schema.org (headline, abstract, datePublished, author, publisher, provider); classification and access come from the six controlled vocabularies through the has* bridge properties; every external key the record carries is a reified datacite:Identifier told apart by its scheme.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb145">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="nda1c118ced93403d96dc967d8210963cb146"/>
    <owl:onProperty rdf:resource="https://schema.org/contributor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://rdfs.org/sioc/ns#topic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">sioc:topic</rdfs:label>
    <rdfs:comment xml:lang="en">The discipline a resource is classified under, from the GoTriple 27-discipline SSH taxonomy (triple:Discipline). Distinct from schema:about, which carries the concepts of the TRIPLE thesaurus.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/handle">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:handle</rdfs:label>
    <rdfs:comment xml:lang="en">Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/SemanticArtefact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Semantic Artefact</rdfs:label>
    <rdfs:label xml:lang="fr">Artefact Sémantique</rdfs:label>
    <rdfs:label xml:lang="pl">Artefakt Semantyczny</rdfs:label>
    <rdfs:label xml:lang="pt">Artefacto Semântico</rdfs:label>
    <rdfs:comment xml:lang="en">A semantic artefact in the context of GoTriple platform, representing formal knowledge representations such as ontologies, controlled vocabularies, and other semantic resources used in SSH research. Original provider values are preserved before normalization.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb144"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb145"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb149"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb153"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb154"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb155"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb156"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb157"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb158"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb159"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb160"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb161"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb165"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb169"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb170"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb171"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb172"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb173"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb177"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb178"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb179"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb180"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb181"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb182"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb183"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb184"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb185"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb186"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb187"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb191"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb192"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb193"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb194"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb195"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb196"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb197"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb198"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/CreativeWork"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/mod#SemanticArtefact"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/Work"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/semanticartefact/example&gt; a triple:SemanticArtefact ;
    schema:headline "Backbone Thesaurus"@en ;
    adms:representationTechnique "SKOS" ;
    schema:version "1.2" .</skos:example>
    <skos:scopeNote xml:lang="en">A SemanticArtefact is a formal knowledge representation - an ontology, a controlled vocabulary, a terminology, a model - described as a resource with an identity of its own (from MOD, mod:SemanticArtefact); the document descriptive core reaches it through the current subclassing. adms:representationTechnique states how the artefact is expressed (OWL, SKOS, ...), schema:version which release the record describes.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/originalLicense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">original license</rdfs:label>
    <rdfs:comment xml:lang="en">The license statement exactly as received from the source provider (e.g. 'CC BY 4.0', a URL, free text), before normalization to the License controlled vocabulary. The normalized value is expressed via triple:hasLicense.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/MediaObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Media Object</rdfs:label>
    <rdfs:label xml:lang="fr">Multimédia</rdfs:label>
    <rdfs:label xml:lang="pl">Multimedia</rdfs:label>
    <rdfs:label xml:lang="pt">Multimédia</rdfs:label>
    <rdfs:comment xml:lang="en">A multimedia object in the GoTriple platform, representing various types of media files (audio, video, images) associated with scholarly works. Original provider values are preserved before normalization.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb62"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb63"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb64"/>

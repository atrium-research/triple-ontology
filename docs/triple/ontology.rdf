  <rdf:Description rdf:about="https://schema.org/contactPoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:contactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for a person or organization.</rdfs:comment>
    <rdfs:range rdf:resource="https://schema.org/ContactPoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/Profile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>

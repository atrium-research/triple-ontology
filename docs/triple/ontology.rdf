    <rdfs:label xml:lang="en">foaf:OnlineAccount</rdfs:label>
    <rdfs:comment xml:lang="en">An online account held by a GoTriple user. Created inside the platform, so it carries only its internal identifier.</rdfs:comment>
  </rdf:Description>

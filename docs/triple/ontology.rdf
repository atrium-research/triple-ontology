    <rdfs:label xml:lang="pl">Profil</rdfs:label>
    <rdfs:label xml:lang="pt">Perfil</rdfs:label>
    <rdfs:comment xml:lang="en">A profile representing either a person or an organization in the GoTriple system. Can be associated or not associated with a user account.</rdfs:comment>

  <rdf:Description rdf:about="http://purl.org/spar/datacite/usesIdentifierScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">datacite:usesIdentifierScheme</rdfs:label>
    <rdfs:comment xml:lang="en">Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another.</rdfs:comment>
    <rdfs:domain rdf:resource="http://purl.org/spar/datacite/Identifier"/>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/knowsAbout">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:knowsAbout</rdfs:label>
    <rdfs:comment xml:lang="en">A topic the agent knows about. Schema.org declares it for Person and Organization, so it is in domain here: every triple:Profile is a person or an organization. It carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) the user declares to know about. The data model revision leaves this field unmapped: the choice of this property is the ontology own.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://sshoc.eu/ontology/SHE3_SSH_Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">SHE3 SSH Project</rdfs:label>
  </rdf:Description>

    <rdfs:label xml:lang="en">foaf:familyName</rdfs:label>
    <rdfs:comment xml:lang="en">The family name (last name) of a person.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#definition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">skos:definition</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS annotation property providing a complete explanation of the intended meaning of a concept.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/mainEntityOfPage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schema:mainEntityOfPage</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a page (or other CreativeWork) for which this thing is the main entity being described.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb128">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <owl:onProperty rdf:resource="https://schema.org/affiliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/registeredUser">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">registered user</rdfs:label>
    <rdfs:comment xml:lang="en">Whether the profile belongs to a registered GoTriple user (true) or was automatically created for an author extracted from harvested document metadata (false).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb64">

    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/givenName"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb23">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:nodeID="nda1c118ced93403d96dc967d8210963cb24"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">skos:exactMatch</rdfs:label>
    <rdfs:comment xml:lang="en">A SKOS property indicating that two concepts can be used interchangeably across all contexts.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/ProjectType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Project Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of research project (funded, crowdfunded, citizen science, ...), drawn from the Project Type controlled vocabulary.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schema:endDate</rdfs:label>
    <rdfs:comment xml:lang="en">The end date and time of the item</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb164">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb48">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/License"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/hasLicense"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/issn">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:issn</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Serial Number - the identifier of a serial publication, standardised as ISO 3297.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#alternateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">prov:alternateOf</rdfs:label>
    <rdfs:comment xml:lang="en">PROV-O property relating two entities that present aspects of the same thing. Reflexive, symmetric and transitive by specification: the direction that tells the representative apart is added by its specialisation triple:isDuplicateOf.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/author">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:author</rdfs:label>
    <rdfs:comment xml:lang="en">The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb243">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalAdditionalType"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb99">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://schema.org/inLanguage"/>
    <owl:someValuesFrom rdf:resource="https://schema.org/Language"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/sponsor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:sponsor</rdfs:label>
    <rdfs:comment xml:lang="en">A person or organization that supports a thing through a pledge, promise, or financial contribution</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb151">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdf:rest rdf:nodeID="nda1c118ced93403d96dc967d8210963cb152"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb108">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/ContactPoint"/>
    <owl:onProperty rdf:resource="https://schema.org/contactPoint"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcterms:source</rdfs:label>
    <rdfs:comment xml:lang="en">A related resource from which the described resource is derived. In GoTriple it points to the system the document was harvested from.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/ContentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Content Type</rdfs:label>
    <rdfs:comment xml:lang="en">The kind of content a resource is (journal article, dataset, software, ...), drawn from the Content Type controlled vocabulary and aligned with COAR resource types.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb121">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/pronouns"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb66">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalConditionOfAccess"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb35">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/sameAs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:sameAs</rdfs:label>
    <rdfs:comment xml:lang="en">URL of a reference page that unambiguously indicates the item's identity (e.g. a Wikidata entity).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb265">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">foaf:name</rdfs:label>
    <rdfs:comment xml:lang="en">The full name of the agent, as a plain string. Chosen over schema:name for FOAF-typed agents (profiles, persons, organizations): it completes the FOAF naming triad with foaf:givenName and foaf:familyName, and is declared rdfs:subPropertyOf rdfs:label by FOAF itself, so generic consumers see it as a label by inference. schema:name remains on schema-typed things (projects, languages, keywords, places).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/license">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcterms:license</rdfs:label>
    <rdfs:comment xml:lang="en">A legal document giving official permission to do something with the resource (DCMI Metadata Terms). Super-property of triple:hasLicense.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb266">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="nda1c118ced93403d96dc967d8210963cb267"/>
    <owl:onProperty rdf:resource="https://schema.org/contributor"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb135">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://schema.org/dateModified"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb94">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://schema.org/datePublished"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb241">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>

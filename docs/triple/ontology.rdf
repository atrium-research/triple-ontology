    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:version</rdfs:label>
    <rdfs:comment xml:lang="en">The version of the CreativeWork</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/FundingScheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:FundingScheme</rdfs:label>
    <rdfs:comment xml:lang="en">A FundingScheme combines organizational, project and policy aspects of grant-based funding, e.g. Framework Programme 7 or Horizon 2020. In GoTriple it types the funding programme a grant is awarded under - the funding_scheme field of production (H2020, FP7, Horizon Europe) - attached to the Grant via schema:funder, which is admissible because a funding scheme is a kind of schema:Organization. The term is part of pending.schema.org; the subclass axiom restates the one asserted by the source.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://schema.org/Organization"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb279">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
    <owl:onProperty rdf:resource="https://schema.org/keywords"/>
  </rdf:Description>

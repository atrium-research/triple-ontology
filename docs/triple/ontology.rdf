    <rdfs:label xml:lang="en">dcat:bbox</rdfs:label>
    <rdfs:comment xml:lang="en">The bounding box of the dataset, expressed as a literal (e.g., WKT).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </rdf:Description>

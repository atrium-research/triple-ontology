    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb76"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb77"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb78"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb82"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb86"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb87"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb88"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb92"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb93"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb94"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb95"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb96"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb97"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb98"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb99"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb100"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb101"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb102"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb103"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb104"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb105"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb106"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb107"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb108"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb109"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb113"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb114"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/MediaObject"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/Work"/>
    <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E90_Symbolic_Object"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/mediaobject/example&gt; a triple:MediaObject ;
    schema:headline "Interview with the author"@en ;
    schema:encodingFormat "audio/mpeg" ;
    schema:duration "PT42M" ;
    schema:datePublished "2021-05-10"^^xsd:date .</skos:example>
    <skos:scopeNote xml:lang="en">A MediaObject is an audio, video or image resource with an identity of its own; the document descriptive core reaches it through the current subclassing. Its medium is what distinguishes it: the encoding (schema:encodingFormat), the size, and - for time-based media - the duration (schema:duration, ISO 8601).</skos:scopeNote>
  </rdf:Description>

    <rdfs:label xml:lang="en">dcterms:type</rdfs:label>
    <rdfs:comment xml:lang="en">The nature or genre of the resource (DCMI Metadata Terms). Super-property of triple:hasContentType and triple:hasProjectType.</rdfs:comment>
  </rdf:Description>

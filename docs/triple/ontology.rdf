    <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://schema.org/mentions"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/isBasedOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">schema:isBasedOn</rdfs:label>
    <rdfs:comment xml:lang="en">A resource from which this work is derived or from which it is a modification or adaptation. Supersedes the deprecated schema:isBasedOnUrl, which the data model revision still names. The value is an IRI (role-B link): an external resource today, possibly a platform resource tomorrow, with the same triple shape.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/topic_interest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">foaf:topic_interest</rdfs:label>
    <rdfs:comment xml:lang="en">A thing of interest to this person. Used in GoTriple to link a profile to the disciplines the user chose or that were automatically detected from the author's publications.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb272">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://schema.org/startDate"/>

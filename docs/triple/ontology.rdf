    <rdfs:comment xml:lang="en">The access rights statement exactly as received from the source provider (e.g. 'info:eu-repo/semantics/openAccess'), before normalization to the Condition of Access controlled vocabulary. The normalized value is expressed via triple:hasConditionOfAccess.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/rights"/>
  </rdf:Description>

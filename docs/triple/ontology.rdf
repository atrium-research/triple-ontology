    <rdfs:label xml:lang="en">dcat:theme</rdfs:label>
    <rdfs:comment xml:lang="en">A main category of the dataset, as originally assigned by the source provider (e.g. a concept from the provider's thematic vocabulary). Distinct from sioc:topic, which carries the automatically assigned TRIPLE disciplines.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/subject"/>
  </rdf:Description>

    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schema:description</rdfs:label>
    <rdfs:comment xml:lang="en">A description of the item. Used in GoTriple for the self-description of a profile.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb206">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Person"/>

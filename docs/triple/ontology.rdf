    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcterms:creator</rdfs:label>
    <rdfs:comment xml:lang="en">The agent responsible for the annotation; for GoTriple enrichments, the GoTriple pipeline (SKG-IF associated_with).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb291">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>

  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb215">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/machineTranslatedLanguage"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb62">

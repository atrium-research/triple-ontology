    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb143"/>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/profile/example&gt; a triple:Profile , foaf:Person ;
    foaf:name "Marie Dupont" ;
    triple:registeredUser true ;
    schema:knowsAbout &lt;http://semantics.gr/authorities/SSH-LCSH/example-concept&gt; ;
    foaf:account [ a foaf:OnlineAccount ] .</skos:example>
    <skos:scopeNote xml:lang="en">A Profile is the platform's representation of an agent - a person or an organization - whether harvested as an author from document metadata or born as a registered GoTriple user; triple:registeredUser tells the two populations apart. Every profile carries exactly one foaf:name and at most one platform account (foaf:OnlineAccount); registered users may add a self-description, a picture, contacts and personal pages, and declare expertise and interests (schema:knowsAbout, schema:knowsLanguage, foaf:topic_interest).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dataset</rdfs:label>
    <rdfs:label xml:lang="fr">Jeu de Données</rdfs:label>
    <rdfs:label xml:lang="pl">Zbiór Danych</rdfs:label>
    <rdfs:label xml:lang="pt">Base de Dados</rdfs:label>
    <rdfs:comment xml:lang="en">A dataset in the GoTriple platform, representing research data with specific metadata including spatial coverage, temporal coverage, and distribution information. It is a subclass of dcat:Dataset. Original provider values are preserved before normalization.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb1"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb2"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb6"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb10"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb11"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb12"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb13"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb14"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb15"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb16"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb17"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb18"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb19"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb20"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb21"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb25"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb29"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb33"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb34"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb35"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb36"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb37"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb38"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb39"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb40"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb41"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb42"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb43"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb44"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb45"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb46"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb47"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb48"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb49"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb50"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb51"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb55"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb56"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb57"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb58"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb59"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb60"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb61"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Dataset"/>
    <skos:closeMatch rdf:resource="http://purl.org/spar/fabio/Dataset"/>
    <skos:closeMatch rdf:resource="https://sshoc.eu/ontology/SHE1_Dataset"/>
    <skos:example xml:lang="en">&lt;https://w3id.org/gto/dataset/example&gt; a triple:Dataset ;
    schema:headline "Survey on digital reading practices"@en ;
    dcat:distribution [ a dcat:Distribution ;
        dcat:accessURL &lt;https://data.example.org/survey2020&gt; ;
        dcat:downloadURL &lt;https://data.example.org/survey2020.csv&gt; ;
        schema:encodingFormat "text/csv" ] ;
    schema:temporalCoverage "2019/2020" ;
    schema:spatialCoverage [ a schema:Place ; schema:name "France" ] .</skos:example>
    <skos:scopeNote xml:lang="en">A Dataset is research data as a resource with an identity of its own; the document descriptive core reaches it through the current subclassing. What is specific to data lives here: the DCAT distribution pattern (dcat:distribution to a dcat:Distribution carrying dcat:accessURL and dcat:downloadURL), size, encoding formats and version, and the extent of what the data covers in space (schema:spatialCoverage, dcat:bbox) and time (schema:temporalCoverage).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:nodeID="nda1c118ced93403d96dc967d8210963cb26"/>
    <owl:onProperty rdf:resource="https://schema.org/author"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/hasContentType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has content type</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its content type.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ContentType"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/type"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb196">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalSource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/source_url_schema">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Source URL</rdfs:label>
    <rdfs:comment xml:lang="en">URL of the original publication location or source repository.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb84">
    <rdf:first rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"/>
    <rdf:rest rdf:nodeID="nda1c118ced93403d96dc967d8210963cb85"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/idref_schema">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">IdRef</rdfs:label>
    <rdfs:comment xml:lang="en">IdRef (Identifiants et Referentiels pour l'enseignement superieur et la recherche) - the French authority file for higher education and research, maintained by ABES. Declared in the TRIPLE namespace because the DataCite ontology has no scheme for it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/dcat#accessURL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcat:accessURL</rdfs:label>
    <rdfs:comment xml:lang="en">A URL of a resource that gives access to a distribution of the dataset — a landing page, portal or feed. When the URL is the file itself, dcat:downloadURL is the right property. IRI-valued by DCAT's own range (rdfs:Resource).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/ConditionOfAccess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Condition of Access</rdfs:label>
    <rdfs:comment xml:lang="en">The access condition of a resource — how and to whom it is available — drawn from the Condition of Access controlled vocabulary and aligned with COAR access rights.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/encodingFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:encodingFormat</rdfs:label>
    <rdfs:label xml:lang="en">schema:encodingFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type typically expressed using a MIME format.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb36">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <owl:onProperty rdf:resource="https://schema.org/datePublished"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/creativeWorkStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:creativeWorkStatus</rdfs:label>
    <rdfs:label xml:lang="en">schema:creativeWorkStatus</rdfs:label>
    <rdfs:comment xml:lang="en">The status of a creative work in terms of its stage in a lifecycle.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb167">
    <rdf:first rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <rdf:rest rdf:nodeID="nda1c118ced93403d96dc967d8210963cb168"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/DefinedTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:DefinedTerm</rdfs:label>
    <rdfs:comment xml:lang="en">A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb291"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/type">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">dc:type</rdfs:label>
    <rdfs:comment xml:lang="en">The nature or genre of the resource (Dublin Core Elements 1.1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb142">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/pronouns"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb246">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalLicense"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb179">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/Place"/>
    <owl:onProperty rdf:resource="https://schema.org/spatialCoverage"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <owl:onProperty rdf:resource="https://schema.org/mentions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/ark">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">datacite:ark</rdfs:label>
    <rdfs:comment xml:lang="en">Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/URL">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:URL</rdfs:label>
    <rdfs:comment xml:lang="en">Data type: URL.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/elements/1.1/date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">dc:date</rdfs:label>
    <rdfs:comment xml:lang="en">A point or period of time associated with an event in the lifecycle of the resource (Dublin Core Elements 1.1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/comment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">schema:comment</rdfs:label>
    <rdfs:comment xml:lang="en">Comments, typically from users.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb76">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
    <owl:onProperty rdf:resource="https://schema.org/keywords"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/datacite/hasIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>datacite:hasIdentifier</rdfs:label>
    <rdfs:label xml:lang="en">datacite:hasIdentifier</rdfs:label>
    <rdfs:comment xml:lang="en">Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/spar/datacite/Identifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/dateCreated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:dateCreated</rdfs:label>
    <rdfs:label xml:lang="en">schema:dateCreated</rdfs:label>
    <rdfs:comment xml:lang="en">The date on which the CreativeWork was created or the item was added to a DataFeed.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/isDiscarded">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">is discarded</rdfs:label>
    <rdfs:comment xml:lang="en">A boolean flag indicating whether an entity (author or keyword) has been marked as discarded and should not be used for search/filtering.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb195">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalConditionOfAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/Discipline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Discipline</rdfs:label>
    <rdfs:comment xml:lang="en">An academic discipline used to classify a resource, drawn from the Discipline controlled vocabulary of the GoTriple classification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb155">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <owl:onProperty rdf:resource="https://schema.org/datePublished"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/dc/terms/provenance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">dcterms:provenance</rdfs:label>
    <rdfs:comment xml:lang="en">A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation.</rdfs:comment>
    <rdfs:range rdf:resource="http://purl.org/dc/terms/ProvenanceStatement"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb294">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/name"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/hasConditionOfAccess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has condition of access</rdfs:label>
    <rdfs:comment xml:lang="en">Links a resource to its access condition.</rdfs:comment>
    <rdfs:range rdf:resource="https://gotriple.eu/ontology/triple/ConditionOfAccess"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/accessRights"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb125">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://gotriple.eu/ontology/triple/Discipline"/>
    <owl:onProperty rdf:resource="http://xmlns.com/foaf/0.1/topic_interest"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb245">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalDatePublished"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/headline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:headline</rdfs:label>
    <rdfs:label xml:lang="en">schema:headline</rdfs:label>
    <rdfs:comment xml:lang="en">Headline of the article.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb98">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://schema.org/size"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">TRIPLE Ontology</rdfs:label>
    <dcterms:abstract xml:lang="en">The TRIPLE Ontology defines a comprehensive model for representing Social Sciences and Humanities (SSH) resources in the GoTriple discovery platform.</dcterms:abstract>
    <dcterms:contributor>Luca De Santis</dcterms:contributor>
    <dcterms:contributor>Silvio Peroni</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-12-01</dcterms:created>
    <dcterms:creator>Alessandro Bertozzi</dcterms:creator>
    <dcterms:description xml:lang="en">GoTriple is an advanced multilingual discovery platform specifically designed for the Social Sciences and Humanities (SSH) sector. The platform aggregates, processes, and semantically enriches diverse SSH resources including scholarly publications, research datasets, project descriptions, and researcher profiles from various European language repositories. The TRIPLE ontology serves as the data model for this platform, facilitating cross-disciplinary and cross-linguistic discovery and reuse of resources.</dcterms:description>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-27</dcterms:modified>
    <dcterms:title xml:lang="en">TRIPLE Ontology</dcterms:title>
    <vann:preferredNamespacePrefix>triple</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://gotriple.eu/ontology/triple/</vann:preferredNamespaceUri>
    <rdfs:comment xml:lang="en">Comprehensive semantic representation of the GoTriple discovery platform's data model for Social Sciences and Humanities (SSH) research artifacts.</rdfs:comment>
    <owl:priorVersion rdf:resource="https://gotriple.eu/ontology/triple/3.1.0"/>
    <owl:versionIRI rdf:resource="https://gotriple.eu/ontology/triple/3.2.0"/>
    <owl:versionInfo>3.2.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb247">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalConditionOfAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/internal_id_schema">
    <rdf:type rdf:resource="http://purl.org/spar/datacite/IdentifierScheme"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TRIPLE Internal ID</rdfs:label>
    <rdfs:comment xml:lang="en">Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb38">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://schema.org/dateCreated"/>
  </rdf:Description>

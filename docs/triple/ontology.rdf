    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:onProperty rdf:resource="https://gotriple.eu/ontology/triple/originalAdditionalType"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/License">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">License</rdfs:label>
    <rdfs:comment xml:lang="en">The licence under which a resource is made available, drawn from the License controlled vocabulary and aligned with Creative Commons and SPDX.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/dc/terms/LicenseDocument"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/fileFormat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>schema:fileFormat</rdfs:label>
    <rdfs:comment xml:lang="en">Media type, typically MIME format</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nda1c118ced93403d96dc967d8210963cb177">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://schema.org/DefinedTerm"/>
    <owl:onProperty rdf:resource="https://schema.org/keywords"/>
  </rdf:Description>

  </rdf:Description>
  <rdf:Description rdf:about="https://schema.org/Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">schema:Organization</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/isDuplicateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is duplicate of</rdfs:label>
    <rdfs:comment xml:lang="en">Links a record to the representative record of the same scholarly work, elected by the GoTriple deduplication pipeline (API field cluster_id carries the representative's identifier; is_duplicate and is_cluster derive from this link). The representative is the target and asserts nothing; subject and object are records of the same content entity. A representative is never itself a duplicate and a record never points at itself: both rules are checked in shapes/.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#alternateOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">foaf:Organization</rdfs:label>
    <rdfs:comment xml:lang="en">An organization.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb296"/>
    <rdfs:subClassOf rdf:nodeID="nda1c118ced93403d96dc967d8210963cb297"/>
    <rdfs:subClassOf rdf:resource="https://schema.org/Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://gotriple.eu/ontology/triple/originalSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">original source</rdfs:label>
    <rdfs:comment xml:lang="en">The source statement exactly as received from the source provider (e.g. a journal issue string or a repository reference), before processing into the normalized source (dcterms:source) or the URL-based identifiers. The value is kept verbatim.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/source"/>
  </rdf:Description>

      {
        "@language": "en",
        "@value": "A URL of a resource that gives access to a distribution of the dataset — a landing page, portal or feed. When the URL is the file itself, dcat:downloadURL is the right property. IRI-valued by DCAT's own range (rdfs:Resource)."
      }
    ],

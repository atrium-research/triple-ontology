    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/profile/example> a triple:Profile , foaf:Person ;\n    foaf:name \"Marie Dupont\" ;\n    triple:registeredUser true ;\n    schema:knowsAbout <http://semantics.gr/authorities/SSH-LCSH/example-concept> ;\n    foaf:account [ a foaf:OnlineAccount ] ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Profile is the platform's representation of an agent - a person or an organization - whether harvested as an author from document metadata or born as a registered GoTriple user; triple:registeredUser tells the two populations apart. Every profile carries exactly one foaf:name and at most one platform account (foaf:OnlineAccount); registered users may add a self-description, a picture, contacts and personal pages, and declare expertise and interests (schema:knowsAbout, schema:knowsLanguage, foaf:topic_interest)."
      }
    ]
  },

    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/dataset/example> a triple:Dataset ;\n    schema:headline \"Survey on digital reading practices\"@en ;\n    dcat:distribution [ a dcat:Distribution ;\n        dcat:accessURL <https://data.example.org/survey2020> ;\n        dcat:downloadURL <https://data.example.org/survey2020.csv> ;\n        schema:encodingFormat \"text/csv\" ] ;\n    schema:temporalCoverage \"2019/2020\" ;\n    schema:spatialCoverage [ a schema:Place ; schema:name \"France\" ] ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Dataset is research data as a resource with an identity of its own; the document descriptive core reaches it through the current subclassing. What is specific to data lives here: the DCAT distribution pattern (dcat:distribution to a dcat:Distribution carrying dcat:accessURL and dcat:downloadURL), size, encoding formats and version, and the extent of what the data covers in space (schema:spatialCoverage, dcat:bbox) and time (schema:temporalCoverage)."
      }
    ]
  },

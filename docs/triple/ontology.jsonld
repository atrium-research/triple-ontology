      {
        "@language": "en",
        "@value": "URL of the original publication location or source repository."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Source URL"
      }
    ]
  },
  {
    "@id": "http://purl.org/spar/datacite/isni",

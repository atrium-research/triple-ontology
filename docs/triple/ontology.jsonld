      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/document/example> a triple:Document ;\n    schema:headline \"De l'esthetique au present\"@fr ;\n    schema:datePublished \"1998-01-01\"^^xsd:date ;\n    schema:author <https://w3id.org/gto/profile/example-author> ;\n    schema:publisher [ a foaf:Organization ; foaf:name \"De Boeck Superieur\" ] ;\n    datacite:hasIdentifier [ a datacite:Identifier ;\n        datacite:usesIdentifierScheme triple:internal_id_schema ;\n        litre:hasLiteralValue \"ftopenedition:oai:books:1234\" ] ;\n    triple:hasContentType ct:typ_book ;\n    triple:hasConditionOfAccess coa:acr_open-access ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Document is the platform's record of ONE provider's description of a scholarly resource: two providers describing the same publication yield two documents, kept distinct and related by triple:isDuplicateOf (duplicate to representative). The descriptive core is Schema.org (headline, abstract, datePublished, author, publisher, provider); classification and access come from the six controlled vocabularies through the has* bridge properties; every external key the record carries is a reified datacite:Identifier told apart by its scheme."
      }
    ]
  },

    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ResearcherID - an identifier system for scientific authors, owned by Clarivate (formerly Thomson Reuters)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "datacite:researcherid"

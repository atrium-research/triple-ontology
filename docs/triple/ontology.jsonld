    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "PROV-O property relating two entities that present aspects of the same thing. Reflexive, symmetric and transitive by specification: the direction that tells the representative apart is added by its specialisation triple:isDuplicateOf."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "prov:alternateOf"
      }
    ]
  },

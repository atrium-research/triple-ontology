        "@language": "en",
        "@value": "<https://w3id.org/gto/mediaobject/example> a triple:MediaObject ;\n    schema:headline \"Interview with the author\"@en ;\n    schema:encodingFormat \"audio/mpeg\" ;\n    schema:duration \"PT42M\" ;\n    schema:datePublished \"2021-05-10\"^^xsd:date ."

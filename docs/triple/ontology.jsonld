        "@value": "Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "schema:mentions"
      }
    ]
  },
  {

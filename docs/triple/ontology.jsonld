    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/semanticartefact/example> a triple:SemanticArtefact ;\n    schema:headline \"Backbone Thesaurus\"@en ;\n    adms:representationTechnique \"SKOS\" ;\n    schema:version \"1.2\" ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A SemanticArtefact is a formal knowledge representation - an ontology, a controlled vocabulary, a terminology, a model - described as a resource with an identity of its own (from MOD, mod:SemanticArtefact); the document descriptive core reaches it through the current subclassing. adms:representationTechnique states how the artefact is expressed (OWL, SKOS, ...), schema:version which release the record describes."
      }
    ]

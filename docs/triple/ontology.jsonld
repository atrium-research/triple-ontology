      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/media-object/example> a triple:MediaObject ;\n    schema:headline \"Interview with the author\"@en ;\n    schema:encodingFormat \"audio/mpeg\" ;\n    schema:duration \"PT42M\" ;\n    schema:datePublished \"2021-05-10\"^^xsd:date ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A MediaObject is an audio, video or image resource with an identity of its own; the document descriptive core reaches it through the current subclassing. Its medium is what distinguishes it: the encoding (schema:encodingFormat), the size, and - for time-based media - the duration (schema:duration, ISO 8601)."
      }

      {
        "@id": "https://sshoc.eu/ontology/SHE3_SSH_Project"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "<https://w3id.org/gto/project/example> a triple:Project ;\n    schema:name \"TRIPLE\"@en ;\n    schema:startDate \"2019-10-01\"^^xsd:date ;\n    schema:endDate \"2023-03-31\"^^xsd:date ;\n    triple:hasProjectType <https://gotriple.eu/ontology/project-type/funded> ;\n    schema:funding [ a schema:Grant ;\n        schema:funder [ a schema:FundingScheme ; schema:name \"H2020\" ] ] ."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "A Project is a research undertaking as a first-class resource of the platform, not a document: it has a name and a lifecycle (schema:startDate, schema:endDate), organizing and sponsoring bodies, and a project type from the controlled vocabulary. Its funding is a chain: schema:funding points to a schema:Grant whose schema:funder is the funding scheme - a schema:FundingScheme individual carried with its display name, deliberately outside any controlled vocabulary. Documents link to the projects they result from with frapo:isOutputOf."
      }
    ]
  },

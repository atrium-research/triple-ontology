@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lic: <https://gotriple.eu/ontology/triple/License/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

lic:lic_cairn a owl:NamedIndividual,
        triple:License ;
    rdfs:label "Cairn"@en,
        "Cairn"@fr,
        "Cairn"@pl,
        "Cairn"@pt ;
    rdfs:comment "The terms of use of the Cairn.info platform, which publishes French-language SSH journals and books. Not a standard open licence but the publisher's own conditions, normalised from the \"Cairn\" value that Isidore, HAL and BASE send."@en ;
    skos:definition "The terms of use of the Cairn.info platform, which publishes French-language SSH journals and books. Not a standard open licence but the publisher's own conditions, normalised from the \"Cairn\" value that Isidore, HAL and BASE send."@en ;
    skos:notation "lic_cairn" ;
    skos:prefLabel "Cairn"@en,
        "Cairn"@fr,
        "Cairn"@pl,
        "Cairn"@pt .


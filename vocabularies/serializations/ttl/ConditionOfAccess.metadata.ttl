@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://gotriple.eu/ontology/condition-of-access> a owl:Ontology ;
    dcterms:title "Condition of Access"@en ;
    dcterms:description "The Condition of Access vocabulary defines the access rights associated with resources in the TRIPLE platform, such as Open Access, Restricted Access, or Closed Access. It facilitates the filtering and identification of resource availability."@en ;
    dcterms:abstract "A controlled vocabulary for specifying access conditions, aligned with COAR Access Rights where applicable."@en ;
    vann:preferredNamespacePrefix "coa" ;
    vann:preferredNamespaceUri "https://gotriple.eu/ontology/condition-of-access/" .

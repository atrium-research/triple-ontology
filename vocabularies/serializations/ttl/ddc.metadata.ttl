@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://gotriple.eu/ontology/triple/ddc> a owl:Ontology ;
    dcterms:title "Dewey Decimal Classification proxies"@en ;
    dcterms:description "Local proxy resources for the Dewey Decimal Classification classes that the Discipline vocabulary maps to. They are not TRIPLE disciplines: they are concepts of an external classification, minted locally because OCLC withdrew dewey.info and no dereferenceable DDC IRI exists."@en ;
    dcterms:abstract "Proxy concepts for the DDC classes referenced by the Discipline vocabulary."@en ;
    vann:preferredNamespacePrefix "ddc" ;
    vann:preferredNamespaceUri "https://gotriple.eu/ontology/triple/ddc/" .

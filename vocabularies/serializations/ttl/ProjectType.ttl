# TRIPLE Ontology - ProjectType Vocabulary
# License: CC BY 4.0
# Website: https://gotriple.eu/ontology/triple


@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pt: <https://gotriple.eu/ontology/project-type/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

pt: a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Project Type"@en ;
    rdfs:comment "A generic project type categorization."@en ;
    skos:definition "A generic project type categorization."@en ;
    skos:prefLabel "Project Type"@en .

pt:citizen_science a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Citizen Science"@en ;
    rdfs:comment "A research project conducted with the active participation of the general public."@en ;
    skos:definition "A research project conducted with the active participation of the general public."@en ;
    skos:prefLabel "Citizen Science"@en .

pt:community_based a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Community-based"@en ;
    rdfs:comment "A research project initiated and driven by a community, typically outside formal institutional structures."@en ;
    skos:definition "A research project initiated and driven by a community, typically outside formal institutional structures."@en ;
    skos:prefLabel "Community-based"@en .

pt:crowdfunded a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Crowdfunded"@en ;
    rdfs:comment "A research project financed through collective contributions, typically via a crowdfunding platform."@en ;
    skos:definition "A research project financed through collective contributions, typically via a crowdfunding platform."@en ;
    skos:prefLabel "Crowdfunded"@en .

pt:funded a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Funded"@en ;
    rdfs:comment "A research project financed by a formal funding programme, such as a European or national grant."@en ;
    skos:definition "A research project financed by a formal funding programme, such as a European or national grant."@en ;
    skos:prefLabel "Funded"@en .

pt:institutional a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Institutional"@en ;
    rdfs:comment "A research project funded or run internally by an institution, such as a university or research centre."@en ;
    skos:definition "A research project funded or run internally by an institution, such as a university or research centre."@en ;
    skos:prefLabel "Institutional"@en .

pt:legacy a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Legacy"@en ;
    rdfs:comment "A completed or historical research project included for archival and reference purposes."@en ;
    skos:definition "A completed or historical research project included for archival and reference purposes."@en ;
    skos:prefLabel "Legacy"@en .

pt:non_funded a owl:NamedIndividual,
        triple:ProjectType ;
    rdfs:label "Non-funded"@en ;
    rdfs:comment "A research project carried out without dedicated external funding."@en ;
    skos:definition "A research project carried out without dedicated external funding."@en ;
    skos:prefLabel "Non-funded"@en .

triple:ProjectType a owl:Class ;
    rdfs:label "Project Type"@en ;
    rdfs:subClassOf skos:Concept .


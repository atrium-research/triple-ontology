@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix ct: <https://gotriple.eu/ontology/content-type/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .

#################################################################
#    Example 1: data paper — derivation and reference links
#################################################################

###  https://gotriple.eu/ontology/triple/document_it21_a
triple:document_it21_a rdf:type owl:NamedIndividual ,
                                triple:Document ;
                       datacite:hasIdentifier triple:id_it21_a , triple:pid_it21_a , triple:orig_it21_a ;
                       schema:headline "Settlement dynamics in the western Mediterranean: a data paper"@en ;
                       triple:hasContentType ct:typ_article ;
                       schema:isBasedOn <https://zenodo.org/records/1234567> ;
                       dcterms:references triple:dataset_it21_b ;
                       rdfs:comment "A data paper: derived from an external Zenodo dataset (role-B IRI link) and referring the reader to a platform dataset."@en .

###  https://gotriple.eu/ontology/triple/dataset_it21_b
triple:dataset_it21_b rdf:type owl:NamedIndividual ,
                               triple:Dataset ;
                      datacite:hasIdentifier triple:id_it21_b , triple:pid_it21_b , triple:orig_it21_b ;
                      schema:headline "Western Mediterranean settlement sites, 800–200 BCE"@en ;
                      dcterms:isReferencedBy triple:document_it21_a ;
                      dcat:distribution triple:distribution_it21_b ;
                      rdfs:comment "The referenced platform dataset, declaring the inverse link."@en .

#################################################################
#    Example 2: the distribution and its two URLs
#################################################################

###  https://gotriple.eu/ontology/triple/distribution_it21_b
triple:distribution_it21_b rdf:type owl:NamedIndividual ,
                                    dcat:Distribution ;
                           dcat:accessURL <https://data.example-provider.eu/datasets/wm-settlements> ;
                           dcat:downloadURL <https://data.example-provider.eu/datasets/wm-settlements/sites.csv> ;
                           schema:encodingFormat "text/csv" ;
                           rdfs:comment "Access page (portal) and direct CSV file: the two DCAT roles, both IRIs."@en .

#################################################################
#    Example 3: occupation as the provider's string
#################################################################

###  https://gotriple.eu/ontology/triple/profile_it21_c
triple:profile_it21_c rdf:type owl:NamedIndividual ,
                               triple:Profile ;
                      datacite:hasIdentifier triple:id_it21_c , triple:pid_it21_c ;
                      schema:name "Ada Moreau" ;
                      schema:jobTitle "Research Software Engineer" ;
                      rdfs:comment "The occupation arrives as a plain string: schema:jobTitle carries it as-is."@en .

#################################################################
#    Identifiers (publication profile)
#################################################################

triple:id_it21_a rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DOC_IT21_A" .
triple:pid_it21_a rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-it21-a" .
triple:orig_it21_a rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "oai:example:doc-it21-a" .
triple:id_it21_b rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DATASET_IT21_B" .
triple:pid_it21_b rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/dataset-it21-b" .
triple:orig_it21_b rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "oai:example:dataset-it21-b" .
triple:id_it21_c rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_PROFILE_IT21_C" .
triple:pid_it21_c rdf:type owl:NamedIndividual , datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/profile-it21-c" .

#################################################################
#    Declarations the standalone tests need
#################################################################

triple:Document rdf:type owl:Class .
triple:Dataset rdf:type owl:Class .
triple:Profile rdf:type owl:Class .
dcat:Distribution rdf:type owl:Class .
schema:isBasedOn rdf:type owl:ObjectProperty .
dcterms:references rdf:type owl:ObjectProperty .
dcterms:isReferencedBy rdf:type owl:ObjectProperty .
dcat:accessURL rdf:type owl:ObjectProperty .
dcat:downloadURL rdf:type owl:ObjectProperty .
dcat:distribution rdf:type owl:ObjectProperty .
triple:hasContentType rdf:type owl:ObjectProperty .
schema:jobTitle rdf:type owl:DatatypeProperty .
schema:headline rdf:type owl:DatatypeProperty .
schema:name rdf:type owl:DatatypeProperty .
schema:encodingFormat rdf:type owl:DatatypeProperty .
datacite:Identifier rdf:type owl:Class .
datacite:hasIdentifier rdf:type owl:ObjectProperty .
datacite:usesIdentifierScheme rdf:type owl:ObjectProperty .
litre:hasLiteralValue rdf:type owl:DatatypeProperty .
triple:internal_id_schema rdf:type owl:NamedIndividual .
triple:original_id_schema rdf:type owl:NamedIndividual .
datacite:ark rdf:type owl:NamedIndividual .
ct:typ_article rdf:type owl:NamedIndividual .

@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

triple:ontology-medieval a triple:SemanticArtefact ;
    dcterms:isReferencedBy triple:document-carolingian ;
    datacite:hasIdentifier triple:identifier-medieval-doi,
        triple:identifier-medieval-download,
        triple:identifier-medieval-handle,
        triple:identifier-medieval-internal,
        triple:identifier-medieval-landing,
        triple:identifier-medieval-original,
        triple:identifier-medieval-pid,
        triple:identifier-medieval-uri ;
    triple:hasAccessCondition acc:acr_restricted-access-or-use ;
    triple:hasLicense lic:lic_creative-commons ;
    schema:about <http://semantics.gr/authorities/SSH-LCSH/sh85085001> ;
    schema:abstract "Formal ontology for medieval studies research domain. Provides semantic modeling of medieval historical periods, events, places, and scholarly concepts."@en ;
    schema:contactPoint triple:contact-unibo-medieval ;
    schema:contributor triple:person-giovanni-bianchi,
        triple:person-pierre-martin ;
    schema:creativeWorkStatus triple:status-draft ;
    schema:dateModified "2023-08-05"^^xsd:date ;
    schema:datePublished "2023-01-20"^^xsd:date ;
    schema:encodingFormat "OWL ontology" ;
    schema:fileFormat "application/owl+xml" ;
    schema:headline "Medieval Studies Ontology"@en ;
    schema:inLanguage schema:language-en,
        schema:language-it ;
    schema:keywords triple:keyword-history,
        triple:keyword-medieval,
        triple:keyword-ontology ;
    schema:publisher triple:organization-unibo ;
    schema:version "0.9.1" .

triple:page-medieval-landing a foaf:Document ;
    schema:headline "Medieval Studies Ontology - Landing Page"@en .

triple:page-thesaurus-landing a foaf:Document ;
    schema:headline "TRIPLE SSH Thesaurus - Landing Page"@en .

triple:page-vocab-arthistory a foaf:Document ;
    schema:headline "Art History Vocabulary - Landing Page"@en .

triple:thesaurus-ssh a triple:SemanticArtefact ;
    dcterms:isReferencedBy triple:document-dh-methodology ;
    datacite:hasIdentifier triple:identifier-thesaurus-doi,
        triple:identifier-thesaurus-download,
        triple:identifier-thesaurus-handle,
        triple:identifier-thesaurus-internal,
        triple:identifier-thesaurus-landing,
        triple:identifier-thesaurus-original,
        triple:identifier-thesaurus-pid,
        triple:identifier-thesaurus-uri ;
    adms:representationTechnique <http://purl.org/adms/representationtechnique/SKOS> ;
    triple:aggregator triple:organization-isidore ;
    triple:hasAccessCondition acc:acr_open-access ;
    triple:hasLicense lic:lic_creative-commons ;
    schema:about <http://semantics.gr/authorities/SSH-LCSH/sh85066150> ;
    schema:abstract "Controlled vocabulary for Social Sciences and Humanities research classification used in the GoTriple discovery platform. Provides standardized terminology for SSH domains."@en ;
    schema:contactPoint triple:contact-gotriple ;
    schema:contributor triple:organization-gotriple ;
    schema:creativeWorkStatus triple:status-published ;
    schema:dateModified "2023-10-20"^^xsd:date ;
    schema:datePublished "2023-03-15"^^xsd:date ;
    schema:encodingFormat "SKOS vocabulary" ;
    schema:fileFormat "application/rdf+xml" ;
    schema:headline "TRIPLE SSH Thesaurus"@en ;
    schema:inLanguage schema:language-en ;
    schema:keywords triple:keyword-ssh,
        triple:keyword-thesaurus,
        triple:keyword-vocabulary ;
    schema:publisher triple:organization-gotriple ;
    schema:version "2.1.0" .

triple:vocab-arthistory a triple:SemanticArtefact ;
    datacite:hasIdentifier triple:identifier-vocab-doi,
        triple:identifier-vocab-download,
        triple:identifier-vocab-handle,
        triple:identifier-vocab-internal,
        triple:identifier-vocab-landing,
        triple:identifier-vocab-original,

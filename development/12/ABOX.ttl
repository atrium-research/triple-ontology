triple:keyword-arthistory a schema:DefinedTerm ;
    schema:description "Academic study of art objects in their historical context"@en ;
    schema:name "art history" .

triple:keyword-cultural-heritage a schema:DefinedTerm ;
    schema:description "Legacy of physical artifacts and cultural traditions"@en ;
    schema:name "cultural heritage" .

triple:keyword-history a schema:DefinedTerm ;
    schema:description "Study of past events and human activities"@en ;
    schema:name "history" .

triple:keyword-medieval a schema:DefinedTerm ;
    schema:description "Academic field studying the Middle Ages period"@en ;
    schema:name "medieval studies" .

triple:keyword-ontology a schema:DefinedTerm ;
    schema:description "Formal specification of conceptualization in a domain"@en ;
    schema:name "ontology" .

triple:keyword-ssh a schema:DefinedTerm ;
    schema:description "Academic disciplines studying human society and culture"@en ;
    schema:name "Social Sciences and Humanities" .

triple:keyword-thesaurus a schema:DefinedTerm ;
    schema:description "Controlled vocabulary with hierarchical relationships"@en ;
    schema:name "thesaurus" .

triple:organization-isidore a foaf:Organization ;
    schema:description "Search engine for Social Sciences and Humanities"@en ;
    foaf:name "Isidore" .

triple:organization-unibo a foaf:Organization ;
    schema:description "Public research university in Bologna, Italy"@en ;
    foaf:name "University of Bologna" .

triple:orig_document-carolingian a datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-carolingian" .

triple:orig_document-dh-methodology a datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-dh-methodology" .


    foaf:name "Giovanni Bianchi" .

triple:person-maria-rossi a foaf:Person ;
    schema:familyName "Rossi" ;
    schema:givenName "Maria" ;
    foaf:name "Maria Rossi" .

triple:person-pierre-martin a foaf:Person ;
    schema:familyName "Martin" ;
    schema:givenName "Pierre" ;
    foaf:name "Pierre Martin" .

triple:pid_document-carolingian a datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-carolingian" .

triple:pid_document-dh-methodology a datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-dh-methodology" .

triple:status-draft a skos:Concept ;
    skos:definition "The semantic artifact is in draft stage and under development"@en ;
    skos:prefLabel "Draft"@en .

schema:language-it a schema:Language ;
    rdfs:label "it"@en .

triple:keyword-vocabulary a schema:DefinedTerm ;
    schema:description "Set of terms used in a particular domain"@en ;
    schema:name "vocabulary" .

triple:organization-dhi a foaf:Organization ;
    schema:description "Research institute specializing in digital methods for humanities"@en ;
    foaf:name "Digital Humanities Institute" .

triple:organization-gotriple a foaf:Organization ;
    schema:description "European consortium for Social Sciences and Humanities research discovery"@en ;
    foaf:name "GoTriple Consortium" .

triple:status-published a skos:Concept ;
    skos:definition "The semantic artifact has been officially published and is available for use"@en ;
    skos:prefLabel "Published"@en .

schema:language-en a schema:Language ;
    rdfs:label "en"@en .



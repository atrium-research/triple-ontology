    triple:hasLicense lic:lic_creative-commons ;
    schema:about <http://semantics.gr/authorities/SSH-LCSH/sh85007960> ;
    schema:abstract "Comprehensive vocabulary for art historical concepts and terminology. Covers periods, movements, techniques, and cultural contexts in art history research."@en ;
    schema:contactPoint triple:contact-dhi ;
    schema:contributor triple:organization-dhi,
        triple:person-maria-rossi ;
    schema:creativeWorkStatus triple:status-published ;
    schema:dateModified "2023-09-12"^^xsd:date ;
    schema:datePublished "2023-05-10"^^xsd:date ;
    schema:encodingFormat "SKOS vocabulary" ;
    schema:fileFormat "text/turtle" ;
    schema:headline "SKOS Art History Vocabulary"@en ;
    schema:inLanguage schema:language-en ;
    schema:keywords triple:keyword-arthistory,
        triple:keyword-cultural-heritage,
        triple:keyword-vocabulary ;
    schema:publisher triple:organization-dhi ;
    schema:version "1.3.2" .

<http://purl.org/adms/representationtechnique/SKOS> a owl:NamedIndividual,
        skos:Concept ;
    rdfs:label "SKOS"@en ;
    rdfs:comment "Representation technique from the ADMS controlled vocabulary: the artefact is expressed in the Simple Knowledge Organization System."@en .

<http://semantics.gr/authorities/SSH-LCSH/sh85007960> a skos:Concept ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85007960> ;
    skos:prefLabel "Art and history"@en,
        "Art et histoire"@fr,
        "Arte e storia"@it .

<http://semantics.gr/authorities/SSH-LCSH/sh85066150> a skos:Concept ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85066150> ;
    skos:prefLabel "Information science"@en,
        "Sciences de l'information"@fr,
        "Scienze dell'informazione"@it .

<http://semantics.gr/authorities/SSH-LCSH/sh85085001> a skos:Concept ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85085001> ;
    skos:prefLabel "Middle Ages"@en,
        "Moyen-âge"@fr,
        "Medioevo"@it .


triple:keyword-archaeology a schema:DefinedTerm ;
    schema:description "The study of human activity through material culture recovery and analysis"@en ;
    schema:name "archaeology"@en .

triple:keyword-demographics a schema:DefinedTerm ;
    schema:description "Statistical characteristics of populations"@en ;
    schema:name "demographics"@en .

triple:keyword-europe a schema:DefinedTerm ;
    schema:description "The European continent and its geographical regions"@en ;
    schema:name "Europe"@en .

triple:keyword-heritage a schema:DefinedTerm ;
    schema:description "Cultural and natural heritage of human societies"@en ;
    schema:name "heritage"@en .

triple:keyword-politics a schema:DefinedTerm ;
    schema:description "Activities related to governance and public affairs"@en ;
    schema:name "politics"@en .

triple:keyword-social-attitudes a schema:DefinedTerm ;
    schema:description "Individual and collective opinions on social issues"@en ;
    schema:name "social attitudes"@en .

triple:keyword-spatial-data a schema:DefinedTerm ;
    schema:description "Data with geographical coordinates and spatial relationships"@en ;
    schema:name "spatial data"@en .

triple:keyword-survey a schema:DefinedTerm ;
    schema:description "Research methodology using questionnaires to collect data"@en ;
    schema:name "survey"@en .

triple:open_access a owl:NamedIndividual,
        triple:AccessCondition ;
    rdfs:label "Open Access"@en ;
    rdfs:comment "The resource is freely available for access."@en .

triple:place-europe a schema:Place ;
    schema:name "Europe" .

triple:place-european-union a schema:Place ;
    schema:name "European Union" .

triple:project-heritage-mapping a schema:Project ;
    datacite:hasIdentifier triple:identifier-project-001 ;
    schema:name "European Heritage Digital Mapping Initiative" .

triple:project-social-cohesion a schema:Project ;
    datacite:hasIdentifier triple:identifier-project-002 ;
    schema:name "Social Cohesion Research Program" .

triple:provenance-heritage-001 a dcterms:ProvenanceStatement ;
    rdfs:label "Provenance for Heritage Dataset 001"@en ;
    rdfs:comment "Data aggregated from 15 national museums and normalized to CIDOC-CRM before conversion to CSV."@en .

triple:provenance-social-002 a dcterms:ProvenanceStatement ;
    rdfs:label "Provenance for Social Dataset 002"@en ;
    rdfs:comment "Survey results merged from 27 EU member state polls, anonymized, and weighted for demographic representativeness."@en .

triple:restricted_access a owl:NamedIndividual,
        triple:AccessCondition ;
    rdfs:label "Restricted Access"@en ;
    rdfs:comment "Access to the resource is restricted."@en .

triple:topic-archaeology a triple:Discipline ;
    skos:definition "The study of human activity through the recovery and analysis of material culture."@en ;
    skos:prefLabel "Archaeology"@en .

triple:topic-social-science a triple:Discipline ;
    skos:definition "Academic disciplines concerned with society and the relationships among individuals within a society."@en ;
    skos:prefLabel "Social Science"@en .

datacite:doi a datacite:IdentifierScheme ;
    rdfs:label "datacite:doi" .

datacite:handle a datacite:IdentifierScheme ;
    rdfs:label "datacite:handle" .


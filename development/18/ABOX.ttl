@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix disc: <https://gotriple.eu/ontology/discipline/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

#################################################################
#    Individuals
#################################################################

###  Example 1: French article, machine-translated, classified with high confidence
triple:document_it18_1 rdf:type owl:NamedIndividual ,
                                triple:Document ;
        schema:headline "Les méthodes numériques et la recherche en SHS"@fr ,
                        "Digital methods and SSH research"@en ,
                        "Métodos digitais e a pesquisa em CSH"@pt ;
        schema:abstract "Une étude des méthodes numériques appliquées aux sciences humaines et sociales."@fr ,
                        "A study of digital methods applied to the social sciences and humanities."@en ;
        schema:inLanguage triple:language_fr_it18 ;
        triple:detectedLanguage "fr" ;
        triple:machineTranslatedLanguage "en" , "pt" ;
        triple:originalInLanguage "fre" ;
        sioc:topic disc:stat ;
        schema:about <http://semantics.gr/authorities/SSH-LCSH/sh2008122106> .


###  Example 2: English report, no translations, low-confidence classification
triple:document_it18_2 rdf:type owl:NamedIndividual ,
                                triple:Document ;
        schema:headline "European Public Opinion Survey Report"@en ;
        schema:inLanguage triple:language_en_it18 ;
        triple:detectedLanguage "en" ;
        triple:originalInLanguage "und" ;
        sioc:topic disc:scipo ;
        schema:about <http://semantics.gr/authorities/SSH-LCSH/sh85009407> .


###  Classification annotations (topic provenance)
triple:ann_it18_topic_1 rdf:type owl:NamedIndividual ,
                                 oa:Annotation ;
        oa:hasTarget triple:document_it18_1 ;
        oa:hasBody disc:stat ;
        oa:motivatedBy oa:classifying ;
        triple:confidence "0.87"^^xsd:decimal ;
        dcterms:creator triple:gotriple_pipeline .

triple:ann_it18_topic_2 rdf:type owl:NamedIndividual ,
                                 oa:Annotation ;
        oa:hasTarget triple:document_it18_2 ;
        oa:hasBody disc:scipo ;
        oa:motivatedBy oa:classifying ;
        triple:confidence "0.55"^^xsd:decimal ;
        dcterms:creator triple:gotriple_pipeline .


###  Tagging annotation (keyword provenance)
triple:ann_it18_kw_1 rdf:type owl:NamedIndividual ,
                              oa:Annotation ;
        oa:hasTarget triple:document_it18_1 ;
        oa:hasBody <http://semantics.gr/authorities/SSH-LCSH/sh2008122106> ;
        oa:motivatedBy oa:tagging ;
        dcterms:creator triple:gotriple_pipeline .




###  Referenced entities
triple:language_fr_it18 rdf:type owl:NamedIndividual ,
                                 schema:Language ;
        schema:name "French" .

triple:language_en_it18 rdf:type owl:NamedIndividual ,
                                 schema:Language ;
        schema:name "English" .

disc:stat rdf:type owl:NamedIndividual ,
                                     triple:Discipline .

disc:scipo rdf:type owl:NamedIndividual ,
                                triple:Discipline .

triple:gotriple_pipeline rdf:type owl:NamedIndividual ,
                                  foaf:Agent ;
        foaf:name "GoTriple" .


###  Concepts of the TRIPLE Vocabulary (SSH-LCSH)
#    http://semantics.gr/authorities/vocabularies/SSH-LCSH — maintained by the TRIPLE consortium,
#    published on semantics.gr by the National Documentation Centre (EKT). The values of schema:about
#    are these concepts themselves, identified by their own URI: GoTriple does not mint local copies.
#    The labels below are a snapshot of the authoritative ones; the vocabulary carries up to 12 languages.

<http://semantics.gr/authorities/SSH-LCSH/sh2008122106> rdf:type skos:Concept ;
    skos:prefLabel "Digital humanities"@en ,
                    "Informatica umanistica"@it ,
                    "Humanités numériques"@fr ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2008122106> .

<http://semantics.gr/authorities/SSH-LCSH/sh85009407> rdf:type skos:Concept ;
    skos:prefLabel "Attitude (Psychology)"@en ,
                    "Atteggiamento"@it ,
                    "Attitude (psychologie)"@fr ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh85009407> .

foaf:name rdf:type owl:DatatypeProperty .

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .


#################################################################
#    Object Properties
#################################################################

###  https://gotriple.eu/ontology/triple/isDuplicateOf
triple:isDuplicateOf rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://gotriple.eu/ontology/triple/isDiscarded
triple:isDiscarded rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/datacite/Identifier
datacite:Identifier rdf:type owl:Class .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class .


###  https://schema.org/DefinedTerm
schema:DefinedTerm rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


###  https://gotriple.eu/ontology/triple/Document
triple:Document rdf:type owl:Class ;
                rdfs:label "TRIPLE Document"@en ;
                rdfs:comment "A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document."@en ;
                rdfs:subClassOf schema:CreativeWork ,
                                foaf:Document .


#################################################################
#    Individuals
#################################################################

###  Example 1: Two documents in the same cluster (deduplication)

###  https://gotriple.eu/ontology/triple/document_7
triple:document_7 rdf:type owl:NamedIndividual ,
                           triple:Document ;
                   datacite:hasIdentifier triple:id_document_7 , triple:pid_document_7 , triple:orig_document_7 ;
                  rdfs:comment "First instance of the same document (from one source): elected representative, no dedup assertion."@en .


###  https://gotriple.eu/ontology/triple/document_89
triple:document_89 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_89 , triple:pid_document_89 , triple:orig_document_89 ;
                   triple:isDuplicateOf triple:document_7 ;
                   rdfs:comment "Second instance of the same document (from another source): duplicate pointing at the representative."@en .


###  Example 2: Document with discarded author

###  https://gotriple.eu/ontology/triple/document_56
triple:document_56 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_56 , triple:pid_document_56 , triple:orig_document_56 ;
                   schema:author triple:person_456 , triple:person_78 ;
                   rdfs:comment "Document with two authors, one of which is discarded (person_78)"@en .


###  https://gotriple.eu/ontology/triple/person_456
triple:person_456 rdf:type owl:NamedIndividual ,
                           foaf:Person ;
                  triple:isDiscarded "false"^^xsd:boolean ;
                  rdfs:comment "Valid author (not discarded)"@en .


###  https://gotriple.eu/ontology/triple/person_78
triple:person_78 rdf:type owl:NamedIndividual ,
                          foaf:Person ;
                 triple:isDiscarded "true"^^xsd:boolean ;
                 rdfs:comment "Discarded author (flagged as unusable)"@en .


###  Example 3: Document with discarded keywords

###  https://gotriple.eu/ontology/triple/document_67
triple:document_67 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_67 , triple:pid_document_67 , triple:orig_document_67 ;
                   schema:keywords triple:keyword_67 , triple:keyword_90 ;
                   rdfs:comment "Document with two keywords, both discarded"@en .


###  https://gotriple.eu/ontology/triple/keyword_67
triple:keyword_67 rdf:type owl:NamedIndividual ,
                           schema:DefinedTerm ;
                  triple:isDiscarded "true"^^xsd:boolean ;
                  rdfs:comment "First discarded keyword"@en .


###  https://gotriple.eu/ontology/triple/keyword_90
triple:keyword_90 rdf:type owl:NamedIndividual ,
                           schema:DefinedTerm ;
                  triple:isDiscarded "true"^^xsd:boolean ;
                  rdfs:comment "Second discarded keyword"@en .

###  Mandatory identifiers
triple:id_document_7 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DOC_007" .

triple:pid_document_7 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-007" .

triple:orig_document_7 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-00007" .

triple:id_document_89 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DOC_089" .

triple:pid_document_89 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-089" .

triple:orig_document_89 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-00089" .

triple:id_document_56 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DOC_056" .

triple:pid_document_56 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-056" .

triple:orig_document_56 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-00056" .

triple:id_document_67 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:internal_id_schema ;
    litre:hasLiteralValue "TRIPLE_DOC_067" .

triple:pid_document_67 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme datacite:ark ;
    litre:hasLiteralValue "ark:/12345/doc-067" .

triple:orig_document_67 rdf:type datacite:Identifier ;
    datacite:usesIdentifierScheme triple:original_id_schema ;
    litre:hasLiteralValue "hal-00067" .


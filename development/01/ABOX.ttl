@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix triple: <https://gotriple.eu/ontology/triple/> .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/elements/1.1/type
<http://purl.org/dc/elements/1.1/type> rdf:type owl:ObjectProperty .


###  http://purl.org/spar/datacite/hasIdentifier
datacite:hasIdentifier rdf:type owl:ObjectProperty .


###  http://purl.org/spar/datacite/usesIdentifierScheme
datacite:usesIdentifierScheme rdf:type owl:ObjectProperty .


###  https://schema.org/inLanguage
<https://schema.org/inLanguage> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue
litre:hasLiteralValue rdf:type owl:DatatypeProperty .


###  https://schema.org/datePublished
<https://schema.org/datePublished> rdf:type owl:DatatypeProperty .


###  https://schema.org/dateModified
<https://schema.org/dateModified> rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/datacite/Identifier
datacite:Identifier rdf:type owl:Class .


###  http://purl.org/spar/datacite/IdentifierScheme
datacite:IdentifierScheme rdf:type owl:Class .


###  https://schema.org/Language
<https://schema.org/Language> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class .




#################################################################
#    Individuals
#################################################################

###  triple:document_1
triple:document_1 rdf:type owl:NamedIndividual ,
                     triple:Document ;
            <http://purl.org/dc/elements/1.1/type> triple:type_5 ;
            datacite:hasIdentifier triple:identifier_2 ,
                                  triple:identifier_4 ,
                                  triple:identifier_landing_1 ,
                                  triple:identifier_fulltext_1 ,
                                  triple:identifier_source_1 ,
                                  triple:identifier_internal_1 ,
                                  triple:identifier_pid_1 ,
                                  triple:identifier_original_1 ;
            <https://schema.org/inLanguage> triple:language_10 ;
            <https://schema.org/headline> "The Impact of Digital Humanities on SSH Research"@en ;
            <https://schema.org/headline> "L'impact des humanités numériques sur la recherche SHS"@fr ;
            <https://schema.org/abstract> "This paper examines the transformative role of digital humanities in Social Sciences and Humanities research."@en ;
            <https://schema.org/abstract> "Cet article examine le rôle transformateur des humanités numériques dans la recherche en sciences humaines et sociales."@fr ;
            <https://schema.org/abstract> "Cet article examine le rôle transformateur des humanités numériques dans la recherche en sciences humaines et sociales."@fr ;
            dcterms:source triple:document_journal ;
            <https://schema.org/encodingFormat> "application/pdf" ;
            <https://schema.org/datePublished> "2021-05-03"^^xsd:date ;
            <https://schema.org/dateModified> "2023-11-15"^^xsd:date .



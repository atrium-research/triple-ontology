@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix disc: <https://gotriple.eu/ontology/discipline/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .

#################################################################
#    Individuals
#################################################################

###  Example 1: registered user with a complete profile
triple:profile_it19_1 rdf:type owl:NamedIndividual ,
                               triple:Profile ,
                               foaf:Person ;
        foaf:name "Sofia Rossi" ;
        foaf:givenName "Sofia" ;
        foaf:familyName "Rossi" ;
        schema:description "Digital historian working on computational analysis of cultural heritage collections."@en ;
        triple:pronouns "she/her" ;
        schema:image <https://gotriple.eu/media/profile/sofia-rossi.jpg> ;
        schema:url <https://sofia-rossi.example.org> ;
        foaf:topic_interest disc:museo ,
                            disc:stat ;
        schema:knowsAbout <http://semantics.gr/authorities/SSH-LCSH/sh2008122106> ;
        schema:knowsLanguage triple:language_it_it19 ,
                             triple:language_en_it19 ;
        schema:affiliation triple:organization_it19_1 ;
        triple:registeredUser "true"^^xsd:boolean ;
        triple:openToCollaboration "true"^^xsd:boolean ;
        schema:dateModified "2026-06-15"^^xsd:date ;
        datacite:hasIdentifier triple:identifier_internal_it19_1 ,
                               triple:identifier_pid_it19_1 ,
                               triple:identifier_orcid_it19_1 ,
                               triple:identifier_gotriple_it19_1 ,
                               triple:identifier_idref_it19_1 .

###  Internal Elasticsearch id (the "id" field)
triple:identifier_internal_it19_1 rdf:type owl:NamedIndividual ,
                                           datacite:Identifier ;
                                           datacite:usesIdentifierScheme triple:internal_id_schema ;
        datacite:usesIdentifierScheme triple:internal_id_schema ;
        litre:hasLiteralValue "sofia_rossi_x8KfvrDgWBlxpw8Ve9U5I" .

###  Persistent identifier minted by GoTriple (the "pid" field)
triple:identifier_pid_it19_1 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme datacite:ark ;
        litre:hasLiteralValue "ark:/12345/profile-sofia-rossi" .

###  External person PIDs and the OPERAS/GoTriple id (the "user_identifier" and "goTripleId" fields)
triple:identifier_orcid_it19_1 rdf:type owl:NamedIndividual ,
                                        datacite:Identifier ;
        datacite:usesIdentifierScheme datacite:orcid ;
        litre:hasLiteralValue "0000-0002-1825-0097" .

triple:identifier_gotriple_it19_1 rdf:type owl:NamedIndividual ,
                                           datacite:Identifier ;
        datacite:usesIdentifierScheme triple:gotriple_id_schema ;
        litre:hasLiteralValue "sofia_rossi_operas_0001" .

triple:identifier_idref_it19_1 rdf:type owl:NamedIndividual ,
                                        datacite:Identifier ;
        datacite:usesIdentifierScheme triple:idref_schema ;
        litre:hasLiteralValue "123456789" .


###  Example 2: author profile from harvested metadata, not registered
triple:profile_it19_2 rdf:type owl:NamedIndividual ,
                               triple:Profile ,
                               foaf:Person ;
        foaf:name "João Almeida" ;
        triple:registeredUser "false"^^xsd:boolean ;
        datacite:hasIdentifier triple:identifier_internal_it19_2 ,
                               triple:identifier_pid_it19_2 ,
                               triple:identifier_isni_it19_2 .

triple:identifier_internal_it19_2 rdf:type owl:NamedIndividual ,
                                           datacite:Identifier ;
                                           datacite:usesIdentifierScheme triple:internal_id_schema ;
        datacite:usesIdentifierScheme triple:internal_id_schema ;
        litre:hasLiteralValue "joao_almeida_p2QhtsFjYDnzrw7Xg1W7K" .

triple:identifier_pid_it19_2 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme datacite:ark ;
        litre:hasLiteralValue "ark:/12345/profile-joao-almeida" .

triple:identifier_isni_it19_2 rdf:type owl:NamedIndividual ,
                                       datacite:Identifier ;
        datacite:usesIdentifierScheme datacite:isni ;
        litre:hasLiteralValue "0000000121032683" .


###  Example 3: document authored by both profiles (author_of via inverse of schema:author)
triple:document_it19_1 rdf:type owl:NamedIndividual ,
                                triple:Document ;
        schema:headline "Mapping early modern correspondence networks with distant reading methods"@en ;
        schema:author triple:profile_it19_1 ,
                      triple:profile_it19_2 ;
        datacite:hasIdentifier triple:identifier_internal_doc_it19 ,
                               triple:identifier_pid_doc_it19 ,
                               triple:identifier_original_doc_it19 .

triple:identifier_internal_doc_it19 rdf:type owl:NamedIndividual ,
                                             datacite:Identifier ;
                                             datacite:usesIdentifierScheme triple:internal_id_schema ;
        litre:hasLiteralValue "TRIPLE_DOC_IT19_001" .

triple:identifier_pid_doc_it19 rdf:type owl:NamedIndividual ,
                                        datacite:Identifier ;
                                        datacite:usesIdentifierScheme datacite:ark ;
        litre:hasLiteralValue "ark:/12345/doc-correspondence-networks" .

triple:identifier_original_doc_it19 rdf:type owl:NamedIndividual ,
                                             datacite:Identifier ;
        datacite:usesIdentifierScheme triple:original_id_schema ;
        litre:hasLiteralValue "hal-04123456" .


###  Referenced entities
triple:organization_it19_1 rdf:type owl:NamedIndividual ,
                                    foaf:Organization ;
        foaf:name "University of Bologna" .

triple:language_it_it19 rdf:type owl:NamedIndividual ,
                                 schema:Language ;
        schema:name "Italian" .

triple:language_en_it19 rdf:type owl:NamedIndividual ,
                                 schema:Language ;
        schema:name "English" .

disc:museo rdf:type owl:NamedIndividual ,
                                              triple:Discipline .

disc:stat rdf:type owl:NamedIndividual ,
                                     triple:Discipline .


###  Concepts of the TRIPLE Vocabulary (SSH-LCSH)
#    http://semantics.gr/authorities/vocabularies/SSH-LCSH — maintained by the TRIPLE consortium,
#    published on semantics.gr by the National Documentation Centre (EKT). The values of schema:about
#    are these concepts themselves, identified by their own URI: GoTriple does not mint local copies.
#    The labels below are a snapshot of the authoritative ones; the vocabulary carries up to 12 languages.

<http://semantics.gr/authorities/SSH-LCSH/sh2008122106> rdf:type skos:Concept ;
    skos:prefLabel "Digital humanities"@en ,
                    "Informatica umanistica"@it ,
                    "Humanités numériques"@fr ;
    skos:exactMatch <http://id.loc.gov/authorities/subjects/sh2008122106> .

foaf:name rdf:type owl:DatatypeProperty .

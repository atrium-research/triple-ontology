triple:topic-art-history a triple:Discipline ;
    skos:definition "The study of art objects in their historical development and stylistic contexts."@en ;
    skos:prefLabel "Art History"@en .

triple:topic-european-history a triple:Discipline ;
    skos:definition "Historical studies focusing on European civilizations and societies."@en ;
    skos:prefLabel "European History"@en .

triple:topic-medieval-history a triple:Discipline ;
    skos:definition "The study of European history from approximately 500 to 1500 CE."@en ;
    skos:prefLabel "Medieval History"@en .


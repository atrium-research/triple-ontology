@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sioc: <http://rdfs.org/sioc/ns#> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .
#################################################################
#    Annotation Properties
#################################################################



#################################################################
#    Object Properties
#################################################################



###  https://schema.org/spatialCoverage
schema:spatialCoverage rdf:type owl:ObjectProperty ;
                       rdfs:label "schema:spatialCoverage"@en ;
                       rdfs:comment "The spatialCoverage of a CreativeWork indicates the place(s) which are the focus of the content."@en ;
                       rdfs:range schema:Place .


###  https://schema.org/author
schema:author rdf:type owl:ObjectProperty ;
              rdfs:label "schema:author"@en ;
              rdfs:comment "The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property."@en .

###  https://schema.org/contributor
schema:contributor rdf:type owl:ObjectProperty ;
                   rdfs:label "schema:contributor"@en ;
                   rdfs:comment "A secondary contributor to the CreativeWork or Event."@en .

###  https://schema.org/publisher
schema:publisher rdf:type owl:ObjectProperty ;
                 rdfs:label "schema:publisher"@en ;
                 rdfs:comment "The publisher of the creative work."@en .

###  https://schema.org/provider
schema:provider rdf:type owl:ObjectProperty ;
                rdfs:label "schema:provider"@en ;
                rdfs:comment "The service provider, service operator, or service performer; the goods producer."@en .


###  https://schema.org/keywords
schema:keywords rdf:type owl:ObjectProperty ;
                rdfs:label "schema:keywords"@en ;
                rdfs:comment "Keywords or tags used to describe this content. In GoTriple these are the producer's own keywords, free text with no URI; the concepts detected by the enrichment pipeline are carried by schema:about instead."@en .

###  https://schema.org/inLanguage
schema:inLanguage rdf:type owl:ObjectProperty ;
                  rdfs:label "schema:inLanguage"@en ;
                  rdfs:comment "The language of the content or performance or used in an action."@en .

###  http://purl.org/spar/datacite/hasIdentifier
datacite:hasIdentifier rdf:type owl:ObjectProperty ;
                       rdfs:label "datacite:hasIdentifier"@en ;
                       rdfs:comment "Links an entity to one of its identifiers. Every identifier in the TRIPLE ontology is reached through this property and is a datacite:Identifier: there is no other way of attaching an identifier to an entity."@en ;
                       rdfs:range datacite:Identifier .

###  http://purl.org/spar/datacite/usesIdentifierScheme
datacite:usesIdentifierScheme rdf:type owl:ObjectProperty ;
                              rdfs:label "datacite:usesIdentifierScheme"@en ;
                              rdfs:comment "Links an identifier to the scheme it belongs to. The scheme is what tells one kind of identifier from another."@en ;
                              rdfs:domain datacite:Identifier .


###  http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue
litre:hasLiteralValue rdf:type owl:DatatypeProperty ;
                      rdfs:label "litre:hasLiteralValue"@en ;
                      rdfs:comment "Associates an entity with a literal value representing its textual content."@en .

#################################################################
#    Data Properties
#################################################################

###  https://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:label "schema:name"@en ;
            rdfs:comment "The name of the item."@en .

###  https://schema.org/headline
schema:headline rdf:type owl:DatatypeProperty ;
                rdfs:label "schema:headline"@en ;
                rdfs:comment "Headline of the article."@en .

###  https://schema.org/abstract
schema:abstract rdf:type owl:DatatypeProperty ;
                rdfs:label "schema:abstract"@en ;
                rdfs:comment "An abstract is a short description that summarizes a CreativeWork."@en .

###  https://schema.org/dateCreated
schema:dateCreated rdf:type owl:DatatypeProperty ;
                   rdfs:label "schema:dateCreated"@en ;
                   rdfs:comment "The date on which the CreativeWork was created or the item was added to a DataFeed."@en .

###  https://schema.org/datePublished
schema:datePublished rdf:type owl:DatatypeProperty ;
                     rdfs:label "schema:datePublished"@en ;
                     rdfs:comment "Date of first publication or broadcast. In GoTriple it is normalized to ISO 8601 (yyyy-mm-dd)."@en .

###  https://schema.org/dateModified
schema:dateModified rdf:type owl:DatatypeProperty ;
                    rdfs:label "schema:dateModified"@en ;
                    rdfs:comment "The date on which the CreativeWork was most recently modified or when the item's entry was modified within a DataFeed. In GoTriple it records the last update of the record in the index; on a profile, the last GoTriple update."@en .

###  https://schema.org/encodingFormat
schema:encodingFormat rdf:type owl:DatatypeProperty ;
                      rdfs:label "schema:encodingFormat"@en ;
                      rdfs:comment "Media type typically expressed using a MIME format."@en .

###  https://schema.org/duration
schema:duration rdf:type owl:DatatypeProperty ;
                rdfs:label "schema:duration"@en ;
                rdfs:comment "The duration of the item (movie, audio recording, event, etc.) in ISO 8601 duration format."@en .

###  https://schema.org/size
schema:size rdf:type owl:DatatypeProperty ;
            rdfs:label "schema:size"@en ;
            rdfs:comment "A standardized size of a product or creative work, specified either through a simple textual string or a QuantitativeValue."@en .

###  https://schema.org/temporalCoverage
schema:temporalCoverage rdf:type owl:DatatypeProperty ;
                        rdfs:label "schema:temporalCoverage"@en ;
                        rdfs:comment "The temporalCoverage of a CreativeWork indicates the period that the content applies to."@en .




###  https://schema.org/about
schema:about rdf:type owl:ObjectProperty ;
             rdfs:label "schema:about"@en ;
             rdfs:comment "The subject matter of the content. In GoTriple it carries the concepts of the TRIPLE Vocabulary (SSH-LCSH) detected in the resource by the enrichment pipeline: the values are the concepts themselves, identified by their semantics.gr URI, not local copies of them."@en .


###  https://schema.org/mentions
schema:mentions rdf:type owl:ObjectProperty ;
                rdfs:label "schema:mentions"@en ;
                rdfs:comment "Indicates that the CreativeWork contains a reference to, but is not necessarily about a particular thing."@en .

###  http://purl.org/dc/terms/isReferencedBy
dcterms:isReferencedBy rdf:type owl:ObjectProperty ;
                       rdfs:label "dcterms:isReferencedBy"@en ;
                       rdfs:comment "A related resource that references, cites, or otherwise points to the described resource."@en .


#################################################################
#    Classes
#################################################################

###  https://schema.org/Place
schema:Place rdf:type owl:Class ;
             rdfs:label "schema:Place"@en ;
             rdfs:comment "Entities that have a somewhat fixed, physical extension."@en ;
             rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty schema:name ;
                              owl:someValuesFrom xsd:string ] .


###  https://schema.org/MediaObject
schema:MediaObject rdf:type owl:Class ;
                   rdfs:label "schema:MediaObject"@en ;
                   rdfs:comment "A media object, such as an image, video, or audio object embedded in a web page or a downloadable dataset. Note that a creative work may have many media objects associated with it on the same web page."@en .

###  https://gotriple.eu/ontology/triple/MediaObject
triple:MediaObject rdf:type owl:Class ;
                   rdfs:label "Media Object (Triple)"@en,
                              "Multimédia"@pt,
                              "Multimedia"@pl,
                              "Multimédia"@fr ;
                   rdfs:comment "A multimedia object in the GoTriple platform, representing various types of media files (audio, video, images) associated with scholarly works. Original provider values are preserved before normalization."@en ;
                   rdfs:subClassOf schema:MediaObject ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:spatialCoverage ;
                                     owl:allValuesFrom schema:Place ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:author ;
                                     owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:contributor ;
                                     owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:publisher ;
                                     owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:provider ;
                                     owl:allValuesFrom [ owl:unionOf ( foaf:Person foaf:Organization ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:keywords ;
                                     owl:allValuesFrom schema:DefinedTerm ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:headline ;
                                     owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                         owl:unionOf ( rdf:langString xsd:string ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:abstract ;
                                     owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                         owl:unionOf ( rdf:langString xsd:string ) ] ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:dateCreated ;
                                     owl:allValuesFrom xsd:date ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:datePublished ;
                                     owl:allValuesFrom xsd:date ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:dateModified ;
                                     owl:allValuesFrom xsd:date ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:dateCreated ;
                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:datePublished ;
                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:dateModified ;
                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:encodingFormat ;
                                     owl:allValuesFrom xsd:string ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:duration ;
                                     owl:allValuesFrom xsd:string ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:size ;
                                     owl:allValuesFrom xsd:string ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:inLanguage ;
                                     owl:someValuesFrom schema:Language ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty triple:hasLicense ;
                                     owl:allValuesFrom triple:License ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty triple:hasAccessCondition ;
                                     owl:allValuesFrom triple:AccessCondition ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:temporalCoverage ;
                                     owl:allValuesFrom xsd:string ] ,

                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:about ;
                                     owl:allValuesFrom skos:Concept ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:mentions ;
                                     owl:allValuesFrom owl:Thing ]  ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty sioc:topic ;
                                     owl:allValuesFrom triple:Discipline ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty triple:hasContentType ;
                                     owl:allValuesFrom triple:ContentType ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty dcterms:isReferencedBy ;
                                     owl:allValuesFrom triple:Document ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty schema:contactPoint ;
                                     owl:allValuesFrom schema:ContactPoint ] .

###  https://schema.org/DefinedTerm
schema:DefinedTerm rdf:type owl:Class ;
                   rdfs:label "schema:DefinedTerm"@en ;
                   rdfs:comment "A word, name, acronym, phrase, etc. with a formal definition. In GoTriple it types the producer's own keywords, which are free text and carry no URI."@en .

###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class ;
            rdfs:label "foaf:Person"@en ;
            rdfs:comment "A person."@en .

###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:label "foaf:Organization"@en ;
                  rdfs:comment "An organization."@en .

###  https://schema.org/Language
schema:Language rdf:type owl:Class ;
                rdfs:label "schema:Language"@en ;
                rdfs:comment "Natural language such as Spanish, Tamil, or English."@en .

###  http://purl.org/spar/datacite/Identifier
datacite:Identifier rdf:type owl:Class ;
                    rdfs:label "datacite:Identifier"@en ;
                    rdfs:comment "An identifier that uniquely identifies an entity according to some identification scheme."@en ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty datacite:usesIdentifierScheme ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass datacite:IdentifierScheme
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty litre:hasLiteralValue ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] .

###  http://purl.org/spar/datacite/IdentifierScheme
datacite:IdentifierScheme rdf:type owl:Class ;
                          rdfs:label "datacite:IdentifierScheme"@en ;
                          rdfs:comment "A scheme that uniquely identifies entities of a particular type."@en .



#################################################################
#    Individuals
#################################################################

###  https://gotriple.eu/ontology/triple/landing_page_url_schema
triple:landing_page_url_schema rdf:type owl:NamedIndividual ,
                                        datacite:IdentifierScheme ;
                               rdfs:label "Landing Page URL"@en ;
                               rdfs:comment "URL of the landing page containing metadata and descriptive information about the document."@en .


###  https://gotriple.eu/ontology/triple/full_text_url_schema
triple:full_text_url_schema rdf:type owl:NamedIndividual ,
                                     datacite:IdentifierScheme ;
                            rdfs:label "Full Text URL"@en ;
                            rdfs:comment "URL providing direct access to the full content of the document."@en .


###  https://gotriple.eu/ontology/triple/source_url_schema
triple:source_url_schema rdf:type owl:NamedIndividual ,
                                  datacite:IdentifierScheme ;
                         rdfs:label "Source URL"@en ;
                         rdfs:comment "URL of the original publication location or source repository."@en .




###  http://purl.org/spar/datacite/doi
datacite:doi rdf:type owl:NamedIndividual ,
                      datacite:IdentifierScheme ;
             rdfs:label "datacite:doi"@en ;
             rdfs:comment "Digital Object Identifier - a persistent identifier for digital objects, standardised as ISO 26324 and governed by the International DOI Foundation."@en .


###  http://purl.org/spar/datacite/handle
datacite:handle rdf:type owl:NamedIndividual ,
                         datacite:IdentifierScheme ;
                rdfs:label "datacite:handle"@en ;
                rdfs:comment "Handle System identifier - a persistent identifier managed by the DONA Foundation, on top of which the DOI system is built."@en .


###  http://purl.org/spar/datacite/issn
datacite:issn rdf:type owl:NamedIndividual ,
                       datacite:IdentifierScheme ;
              rdfs:label "datacite:issn"@en ;
              rdfs:comment "International Standard Serial Number - the identifier of a serial publication, standardised as ISO 3297."@en .


###  http://purl.org/spar/datacite/isbn
datacite:isbn rdf:type owl:NamedIndividual ,
                       datacite:IdentifierScheme ;
              rdfs:label "datacite:isbn"@en ;
              rdfs:comment "International Standard Book Number - a numeric identifier for books and book-like products."@en .


###  http://purl.org/spar/datacite/ark
datacite:ark rdf:type owl:NamedIndividual ,
                      datacite:IdentifierScheme ;
             rdfs:label "datacite:ark"@en ;
             rdfs:comment "Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints."@en .


###  https://gotriple.eu/ontology/triple/internal_id_schema
triple:internal_id_schema rdf:type owl:NamedIndividual ,
                                   datacite:IdentifierScheme ;
                          rdfs:label "TRIPLE Internal ID"@en ;
                          rdfs:comment "Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id."@en .


###  https://gotriple.eu/ontology/triple/original_id_schema
triple:original_id_schema rdf:type owl:NamedIndividual ,
                                   datacite:IdentifierScheme ;
                          rdfs:label "Original Identifier"@en ;
                          rdfs:comment "Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number)."@en .

###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:label "skos:Concept"@en ;
             rdfs:comment "A concept of a knowledge organization system, from SKOS. Values of schema:about are the concepts of the TRIPLE Vocabulary (SSH-LCSH), maintained by the TRIPLE consortium and published on semantics.gr."@en .

@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/spar/datacite/hasIdentifier
datacite:hasIdentifier rdf:type owl:ObjectProperty ;
                       rdfs:label "datacite:hasIdentifier"@en .


###  http://purl.org/spar/datacite/usesIdentifierScheme
datacite:usesIdentifierScheme rdf:type owl:ObjectProperty ;
                              rdfs:label "datacite:usesIdentifierScheme"@en .


###  http://xmlns.com/foaf/0.1/account
foaf:account rdf:type owl:ObjectProperty ;
             rdfs:label "foaf:account"@en ;
             rdfs:comment "Indicates an account held by this agent"@en .


###  https://schema.org/author
schema:author rdf:type owl:ObjectProperty ;
              rdfs:label "schema:author"@en ;
              rdfs:comment "The author of this content or rating. The documents a profile is author of (the author_of field) are retrieved as the inverse of this property."@en .

#################################################################
#    Data properties
#################################################################

###  https://schema.org/name
schema:name rdf:type owl:DatatypeProperty ;
            rdfs:label "schema:name"@en .

#################################################################
#    Data Properties
#################################################################

###  http://www.essepuntato.it/2010/06/literalreification/hasLiteralValue
litre:hasLiteralValue rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/datacite/Identifier
datacite:Identifier rdf:type owl:Class ;
                    rdfs:label "datacite:Identifier"@en ;
                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                      owl:onProperty datacite:usesIdentifierScheme ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass datacite:IdentifierScheme
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty litre:hasLiteralValue ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] .


###  http://purl.org/spar/datacite/IdentifierScheme
datacite:IdentifierScheme rdf:type owl:Class ;
                          rdfs:label "datacite:IdentifierScheme"@en .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class ;
              rdfs:label "foaf:Document"@en .


###  https://gotriple.eu/ontology/triple/Document
triple:Document rdf:type owl:Class ;
                rdfs:label "Document"@en ;
                rdfs:comment "A document in the GoTriple platform, representing scholarly publications, research datasets, and other SSH research artifacts. It is a subclass of both schema:CreativeWork and foaf:Document. Beyond the internal id, the GoTriple PID and the identifier from the source system, a document optionally carries a DOI, a Handle, an ISSN or an ISBN, and its landing page, full text and source URLs, each distinguished by its identifier scheme."@en ;
                rdfs:subClassOf schema:CreativeWork ,
                                foaf:Document .


###  http://xmlns.com/foaf/0.1/OnlineAccount
foaf:OnlineAccount rdf:type owl:Class ;
                   rdfs:label "foaf:OnlineAccount"@en ;
                   rdfs:comment "An online account held by a GoTriple user. Created inside the platform, so it carries only its internal identifier."@en  .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:DatatypeProperty ;
          rdfs:label "foaf:name"@en ;
          rdfs:comment "The full name of the agent, as a plain string. Chosen over schema:name for FOAF-typed agents (profiles, persons, organizations): it completes the FOAF naming triad with foaf:givenName and foaf:familyName, and is declared rdfs:subPropertyOf rdfs:label by FOAF itself, so generic consumers see it as a label by inference. schema:name remains on schema-typed things (projects, languages, keywords, places)."@en .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:label "foaf:Organization"@en ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty foaf:name ;
                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onDataRange xsd:string
                                  ] .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class ;
            rdfs:label "foaf:Person"@en ;
            owl:equivalentClass schema:Person ;
            rdfs:subClassOf [ rdf:type owl:Restriction ;
                              owl:onProperty foaf:name ;
                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                              owl:onDataRange xsd:string
                            ] .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class ;
                    rdfs:label "schema:CreativeWork"@en .


###  https://schema.org/Organization
schema:Organization rdf:type owl:Class ;
                    rdfs:label "schema:Organization"@en .


###  https://schema.org/Person
schema:Person rdf:type owl:Class ;
              rdfs:label "schema:Person"@en .


###  https://gotriple.eu/ontology/triple/Profile
triple:Profile rdf:type owl:Class ;
               rdfs:label "profile"@en,
                          "Perfil"@pt,
                          "Profil"@pl,
                          "Profil"@fr ;
               rdfs:comment "A profile representing either a person or an organization in the GoTriple system. Can be associated or not associated with a user account."@en ;
               skos:scopeNote "A Profile is the platform's representation of an agent - a person or an organization - whether harvested as an author from document metadata or born as a registered GoTriple user; triple:registeredUser tells the two populations apart. Every profile carries exactly one foaf:name and at most one platform account (foaf:OnlineAccount); registered users may add a self-description, a picture, contacts and personal pages, and declare expertise and interests (schema:knowsAbout, schema:knowsLanguage, foaf:topic_interest)."@en ;
               skos:example """<https://w3id.org/gto/profile/example> a triple:Profile , foaf:Person ;
    foaf:name \"Marie Dupont\" ;
    triple:registeredUser true ;
    schema:knowsAbout <http://semantics.gr/authorities/SSH-LCSH/example-concept> ;
    foaf:account [ a foaf:OnlineAccount ] ."""@en ;
               # Exactly one internal id. Iteration 19 adds the GoTriple PID and the
               # optional person PIDs (ORCID, IdRef, ISNI, GoTriple id).
               rdfs:subClassOf
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty foaf:name ;
                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onDataRange xsd:string
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty foaf:account ;
                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
                                 owl:onClass foaf:OnlineAccount
                               ] ,
                               [ owl:unionOf ( foaf:Person foaf:Organization ) ] .


#################################################################
#    Identifier Schemes
#################################################################

###  http://purl.org/spar/datacite/ark
datacite:ark rdf:type owl:NamedIndividual ,
                      datacite:IdentifierScheme ;
             rdfs:label "datacite:ark"@en ;
             rdfs:comment "Archival Resource Key - a persistent identifier scheme for information objects, maintained by the California Digital Library. Used by GoTriple for the persistent identifiers it mints."@en .


###  https://gotriple.eu/ontology/triple/internal_id_schema
triple:internal_id_schema rdf:type owl:NamedIndividual ,
                                   datacite:IdentifierScheme ;
                          rdfs:label "TRIPLE Internal ID"@en ;
                          rdfs:comment "Identifier scheme of the internal identifier assigned by the GoTriple platform to a resource. Declared in the TRIPLE namespace because datacite:local-resource-identifier-scheme cannot distinguish an identifier local to GoTriple from one local to the source system. On profiles it carries the Elasticsearch id."@en .


###  https://gotriple.eu/ontology/triple/original_id_schema
triple:original_id_schema rdf:type owl:NamedIndividual ,
                                   datacite:IdentifierScheme ;
                          rdfs:label "Original Identifier"@en ;
                          rdfs:comment "Identifier scheme of the identifier a resource carried in the system it was harvested from, i.e. local to the source system rather than to GoTriple; used when that system has no named scheme of its own. For projects it carries the code assigned by the funding programme (e.g. a Horizon 2020, PRIN or FWF grant number)."@en .

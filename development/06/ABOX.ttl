@prefix triple: <https://gotriple.eu/ontology/triple/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix datacite: <http://purl.org/spar/datacite/> .
@prefix litre: <http://www.essepuntato.it/2010/06/literalreification/> .

#################################################################
#    Object Properties
#################################################################

###  http://purl.org/spar/datacite/hasIdentifier
datacite:hasIdentifier rdf:type owl:ObjectProperty .


###  http://purl.org/spar/datacite/usesIdentifierScheme
datacite:usesIdentifierScheme rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/account
foaf:account rdf:type owl:ObjectProperty .


###  https://schema.org/author
schema:author rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  https://schema.org/name
schema:name rdf:type owl:DatatypeProperty .
foaf:name rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://purl.org/spar/datacite/Identifier
datacite:Identifier rdf:type owl:Class .


###  http://purl.org/spar/datacite/IdentifierScheme
datacite:IdentifierScheme rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Document
foaf:Document rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/OnlineAccount
foaf:OnlineAccount rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class .


###  http://xmlns.com/foaf/0.1/Person
foaf:Person rdf:type owl:Class .


###  https://schema.org/CreativeWork
schema:CreativeWork rdf:type owl:Class .


###  https://gotriple.eu/ontology/triple/Profile
triple:Profile rdf:type owl:Class ;
               rdfs:label "profile"@en ;
               rdfs:subClassOf [ owl:unionOf ( foaf:Person foaf:Organization ) ] .


#################################################################
#    Individuals
#################################################################

# ============================================
# Example 1: document_1 with associated profile
# ============================================

###  https://gotriple.eu/ontology/triple/document_1
triple:document_1 rdf:type owl:NamedIndividual ,
                           triple:Document ;
                   datacite:hasIdentifier triple:id_document_1 , triple:pid_document_1 , triple:orig_document_1 ;
                  schema:author triple:profile_1 ;
                  rdfs:comment "Document with author profile_1 (associated with account_1)"@en .


###  https://gotriple.eu/ontology/triple/profile_1
triple:profile_1 rdf:type owl:NamedIndividual ,
                          triple:Profile ;
                 datacite:hasIdentifier triple:identifier_pid_profile_1 ,
                                        triple:agent_identifier_2345678998765 ;
                 foaf:account triple:account_1 ;
                 foaf:name "John Smith" ;
                 rdfs:comment "Profile associated with account_1"@en .


###  https://gotriple.eu/ontology/triple/profile_2
triple:profile_2 rdf:type owl:NamedIndividual ,
                          triple:Profile ;
                 datacite:hasIdentifier triple:identifier_pid_profile_2 ,
                                        triple:agent_identifier_23456789efefert5 ;
                 foaf:account triple:account_1 ;
                 foaf:name "J. Smith" ;
                 rdfs:comment "Profile associated with account_1"@en .


###  https://gotriple.eu/ontology/triple/account_1
triple:account_1 rdf:type owl:NamedIndividual ,
                          foaf:OnlineAccount ;
                 datacite:hasIdentifier triple:account_identifier_1223rfgwe ;
                 rdfs:comment "User account associated with profile_1 and profile_2"@en .


# ============================================
# Example 2: document_56 with multiple authors
# ============================================

###  https://gotriple.eu/ontology/triple/document_56
triple:document_56 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_56 , triple:pid_document_56 , triple:orig_document_56 ;
                   schema:author triple:profile_56 ,
                                triple:profile_09 ,
                                triple:profile_123 ,
                                triple:profile_23 ;
                   rdfs:comment "Document with 4 authors: 3 associated with accounts (profile_56, profile_09, profile_123), 1 unassociated (profile_23)"@en .


###  https://gotriple.eu/ontology/triple/profile_56
triple:profile_56 rdf:type owl:NamedIndividual ,
                           triple:Profile ;
                  datacite:hasIdentifier triple:identifier_pid_profile_56 ,
                                         triple:agent_identifier_4563678 ;
                  foaf:account triple:account_109 ;
                  foaf:name "Maria Rossi" ;
                  rdfs:comment "Profile associated with account_109"@en .


###  https://gotriple.eu/ontology/triple/profile_09
triple:profile_09 rdf:type owl:NamedIndividual ,
                           triple:Profile ;
                  datacite:hasIdentifier triple:identifier_pid_profile_09 ,
                                         triple:agent_identifier_rfkgjnerfojgnel48567 ;
                  foaf:account triple:account_109 ;
                  foaf:name "M. Rossi" ;
                  rdfs:comment "Profile associated with account_109"@en .


###  https://gotriple.eu/ontology/triple/profile_123
triple:profile_123 rdf:type owl:NamedIndividual ,
                            triple:Profile ;
                   datacite:hasIdentifier triple:identifier_pid_profile_123 ,
                                          triple:agent_identifier_peormcv ;
                   foaf:account triple:account_109 ;
                   foaf:name "Maria R. Rossi" ;
                   rdfs:comment "Profile associated with account_109"@en .


###  https://gotriple.eu/ontology/triple/profile_23
triple:profile_23 rdf:type owl:NamedIndividual ,
                           triple:Profile ;
                  datacite:hasIdentifier triple:identifier_pid_profile_23 ,
                                         triple:agent_identifier_ethterhjry764576 ;
                  foaf:name "Pierre Dupont" ;
                  rdfs:comment "Unassociated profile (no account)"@en .


###  https://gotriple.eu/ontology/triple/account_109
triple:account_109 rdf:type owl:NamedIndividual ,
                            foaf:OnlineAccount ;
                   datacite:hasIdentifier triple:account_identifier_124543twrfg34tfwredwe ;
                   rdfs:comment "User account associated with profile_56, profile_09, and profile_123"@en .


# ============================================
# Additional documents for testing
# ============================================

###  https://gotriple.eu/ontology/triple/document_67
triple:document_67 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_67 , triple:pid_document_67 , triple:orig_document_67 ;
                   schema:author triple:profile_56 .


###  https://gotriple.eu/ontology/triple/document_98
triple:document_98 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_98 , triple:pid_document_98 , triple:orig_document_98 ;
                   schema:author triple:profile_09 .


###  https://gotriple.eu/ontology/triple/document_42
triple:document_42 rdf:type owl:NamedIndividual ,
                            triple:Document ;
                   datacite:hasIdentifier triple:id_document_42 , triple:pid_document_42 , triple:orig_document_42 ;
                   schema:author triple:profile_123 ,
                                triple:profile_23 .



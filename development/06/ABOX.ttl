# Identifier individuals
# ============================================

###  Account identifiers
triple:account_identifier_1223rfgwe rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "1223rfgwe" .


triple:account_identifier_124543twrfg34tfwredwe rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "124543twrfg34tfwredwe" .


###  Agent/Profile identifiers
triple:agent_identifier_2345678998765 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "2345678998765" .


triple:agent_identifier_23456789efefert5 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "23456789efefert5" .


triple:agent_identifier_4563678 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "4563678" .


triple:agent_identifier_rfkgjnerfojgnel48567 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "rfkgjnerfojgnel48567" .


triple:agent_identifier_peormcv rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "peormcv" .


triple:agent_identifier_ethterhjry764576 rdf:type owl:NamedIndividual ,
                                      datacite:Identifier ;
                                      datacite:usesIdentifierScheme triple:internal_id_schema ;
                             litre:hasLiteralValue "ethterhjry764576" .

###  GoTriple persistent identifiers of the profiles
triple:identifier_pid_profile_1 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-1" .

triple:identifier_pid_profile_2 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-2" .

triple:identifier_pid_profile_56 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-56" .

triple:identifier_pid_profile_09 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-09" .

triple:identifier_pid_profile_123 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-123" .

triple:identifier_pid_profile_23 rdf:type datacite:Identifier ;
         datacite:usesIdentifierScheme datacite:ark ;
         litre:hasLiteralValue "ark:/12345/profile-23" .

